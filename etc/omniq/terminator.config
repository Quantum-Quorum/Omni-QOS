[global_config]
  suppress_multiple_term_dialog = True
  title_transmit_bg_color = "#8A4FFF"
  title_transmit_fg_color = "#FFFFFF"
  title_inactive_bg_color = "#141126"
  title_inactive_fg_color = "#9E97B8"
  title_receive_bg_color = "#00E5FF"
  title_receive_fg_color = "#0D0B18"
  focus = click
  handle_size = 2
  window_state = normal

[keybindings]
  split_horiz = <Primary><Shift>o
  split_vert = <Primary><Shift>e
  close_term = <Primary><Shift>w
  new_tab = <Primary><Shift>t
  cycle_next = <Primary><Shift>n
  cycle_prev = <Primary><Shift>p
  broadcast_all = <Alt>a
  broadcast_group = <Alt>g
  broadcast_off = <Alt>o

[profiles]
  [[default]]
    background_color = "#0D0B18"
    foreground_color = "#EDEAF5"
    cursor_color_default = False
    cursor_bg_color = "#00E5FF"
    cursor_fg_color = "#0D0B18"
    cursor_shape = block
    cursor_blink = True
    font = DejaVu Sans Mono 11
    use_system_font = False
    scrollbar_position = hidden
    show_titlebar = True
    title_font = Sans Bold 9
    title_use_system_font = False
    title_transmit_bg_color = "#8A4FFF"
    title_transmit_fg_color = "#FFFFFF"
    title_inactive_bg_color = "#141126"
    title_inactive_fg_color = "#9E97B8"
    title_receive_bg_color = "#00E5FF"
    title_receive_fg_color = "#0D0B18"
    palette = "#0D0B18:#FF3366:#00FF9D:#FFE600:#8A4FFF:#FF72B0:#00E5FF:#EDEAF5:#1A1530:#FF5C8A:#33FFB0:#FFEB3B:#A870FF:#FF94C7:#4DEDFF:#FFFFFF"
    scrollback_lines = 10000
    copy_on_selection = True

[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
      size = 960, 600
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
