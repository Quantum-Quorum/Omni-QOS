#!/usr/bin/env python3

import os
import sys
import time
import json
import shutil
import argparse
import subprocess
from typing import List, Dict, Optional

CYAN = "\033[38;2;0;229;255m"
GREEN = "\033[38;2;52;211;153m"
YELLOW = "\033[38;2;251;191;36m"
RED = "\033[38;2;248;113;113m"
PURPLE = "\033[38;2;167;139;250m"
WHITE = "\033[1;37m"
GRAY = "\033[38;2;100;116;139m"
RESET = "\033[0m"

BANNER = f"""{CYAN}
   ___                  _  ____         ___  ____
  / _ \\ _ __ ___  _ __ (_)/ __ \\       / _ \\/ ___|
 | | | | '_ ` _ \\| '_ \\| | |  | | ___ | | | \\___ \\
 | |_| | | | | | | | | | | |__| | ___ | |_| |___) |
  \\___/|_| |_| |_|_| |_|_|\\___\\_\\      \\___/|____/

{WHITE} OmniQ-OS: Real-Time Quantum Linux Disk Installer{RESET}
{GRAY} Permanent NVMe / SATA / VirtIO Storage Deployment Engine{RESET}
"""

class DiskInstaller:
    def __init__(self, target_disk: Optional[str] = None, auto: bool = False, enable_persistence: bool = True):
        self.target_disk = target_disk
        self.auto = auto
        self.enable_persistence = enable_persistence
        self.available_disks: List[Dict[str, str]] = []

    def log(self, msg: str, level: str = "INFO"):
        colors = {"INFO": CYAN, "SUCCESS": GREEN, "WARN": YELLOW, "ERROR": RED}
        c = colors.get(level, WHITE)
        print(f" {c}[{level}]{RESET} {msg}")

    def run_cmd(self, cmd: List[str], check: bool = True, capture: bool = True) -> subprocess.CompletedProcess:
        try:
            return subprocess.run(cmd, check=check, capture_output=capture, text=True)
        except subprocess.CalledProcessError as e:
            self.log(f"Command failed: {' '.join(cmd)}\nStderr: {e.stderr}", "ERROR")
            if check:
                raise
            return e

    def scan_disks(self) -> List[Dict[str, str]]:
        self.available_disks.clear()
        try:
            p = self.run_cmd(["lsblk", "-J", "-b", "-d", "-o", "NAME,SIZE,TYPE,TRAN,MODEL,RO"])
            data = json.loads(p.stdout)
            for dev in data.get("blockdevices", []):
                name = dev.get("name", "")
                dev_type = dev.get("type", "")
                ro = dev.get("ro", False)
                size_bytes = int(dev.get("size", 0))

                if ro or dev_type != "disk" or name.startswith("loop") or name.startswith("ram"):
                    continue
                if size_bytes < 4 * 1024 * 1024 * 1024:
                    continue

                size_gb = size_bytes / (1024 ** 3)
                model = dev.get("model", "Generic Drive").strip()
                tran = dev.get("tran", "unknown").upper()
                dev_path = f"/dev/{name}"

                self.available_disks.append({
                    "path": dev_path,
                    "name": name,
                    "size_gb": f"{size_gb:.1f} GB",
                    "model": model,
                    "tran": tran
                })
        except Exception as e:
            self.log(f"Disk scanning error: {e}", "WARN")

        if not self.available_disks and not os.path.exists("/proc/version"):
            self.available_disks.append({
                "path": "/dev/sda",
                "name": "sda",
                "size_gb": "64.0 GB",
                "model": "VBOX HARDDISK (Virtual)",
                "tran": "SATA"
            })
            self.available_disks.append({
                "path": "/dev/nvme0n1",
                "name": "nvme0n1",
                "size_gb": "256.0 GB",
                "model": "Quantum NVMe Low-Latency Crate",
                "tran": "PCIE"
            })

        return self.available_disks

    def select_disk_interactive(self) -> str:
        print(f"\n{CYAN}--- Available Target Storage Disks ---{RESET}")
        for idx, d in enumerate(self.available_disks, 1):
            print(f" [{WHITE}{idx}{RESET}] {GREEN}{d['path']:14s}{RESET} {WHITE}{d['size_gb']:10s}{RESET} [{PURPLE}{d['tran']}{RESET}] {d['model']}")

        while True:
            try:
                choice = input(f"\n{WHITE}Select target installation disk [1-{len(self.available_disks)}] (or 'q' to quit): {RESET}").strip()
                if choice.lower() == 'q':
                    sys.exit(0)
                idx = int(choice)
                if 1 <= idx <= len(self.available_disks):
                    return self.available_disks[idx - 1]["path"]
            except ValueError:
                pass
            print(f"{RED}Invalid selection. Please choose a number between 1 and {len(self.available_disks)}.{RESET}")

    def partition_disk(self, disk: str):
        self.log(f"Creating GPT partition table on {disk}...", "INFO")
        self.run_cmd(["wipefs", "-a", disk], check=False)
        self.run_cmd(["sgdisk", "-Z", disk], check=False)

        self.log("Allocating 512MB EFI System Partition (ESP)...", "INFO")
        self.run_cmd(["sgdisk", "-n", "1:2048:+512M", "-t", "1:ef00", "-c", "1:EFI-SYSTEM", disk], check=False)

        if self.enable_persistence:
            self.log("Allocating root partition (80% remaining) and persistence partition (20%)...", "INFO")
            self.run_cmd(["sgdisk", "-n", "2:0:+24G", "-t", "2:8300", "-c", "2:OmniQ-Root", disk], check=False)
            self.run_cmd(["sgdisk", "-n", "3:0:0", "-t", "3:8300", "-c", "3:persistence", disk], check=False)
        else:
            self.log("Allocating root partition (100% remaining)...", "INFO")
            self.run_cmd(["sgdisk", "-n", "2:0:0", "-t", "2:8300", "-c", "2:OmniQ-Root", disk], check=False)

        self.run_cmd(["partprobe", disk], check=False)
        time.sleep(1)

    def format_partitions(self, disk: str) -> Dict[str, str]:
        p_prefix = f"{disk}p" if disk[-1].isdigit() else disk
        esp_part = f"{p_prefix}1"
        root_part = f"{p_prefix}2"
        persist_part = f"{p_prefix}3" if self.enable_persistence else None

        self.log(f"Formatting ESP {esp_part} (FAT32)...", "INFO")
        self.run_cmd(["mkfs.vfat", "-F32", "-n", "EFI", esp_part], check=False)

        self.log(f"Formatting Root {root_part} (ext4, labeled OmniQ-Root)...", "INFO")
        self.run_cmd(["mkfs.ext4", "-F", "-L", "OmniQ-Root", root_part], check=False)

        if persist_part:
            self.log(f"Formatting Persistence {persist_part} (ext4, labeled persistence)...", "INFO")
            self.run_cmd(["mkfs.ext4", "-F", "-L", "persistence", persist_part], check=False)

        return {"esp": esp_part, "root": root_part, "persist": persist_part}

    def copy_system(self, root_part: str, esp_part: str):
        target_mount = "/mnt/omniq_target"
        os.makedirs(target_mount, exist_ok=True)

        self.log(f"Mounting root filesystem {root_part} to {target_mount}...", "INFO")
        self.run_cmd(["mount", root_part, target_mount], check=False)

        esp_mount = os.path.join(target_mount, "boot/efi")
        os.makedirs(esp_mount, exist_ok=True)
        self.run_cmd(["mount", esp_part, esp_mount], check=False)

        self.log("Synchronizing OmniQ-OS root filesystem to target storage...", "INFO")
        src_root = "/"
        exclude_args = [
            "--exclude=/proc/*", "--exclude=/sys/*", "--exclude=/dev/*",
            "--exclude=/mnt/*", "--exclude=/media/*", "--exclude=/run/*",
            "--exclude=/tmp/*", "--exclude=/lost+found",
            "--exclude=/swapfile", "--exclude=/cdrom/*"
        ]
        rsync_cmd = ["rsync", "-aHAXx", "--info=progress2"] + exclude_args + [src_root, target_mount]
        self.run_cmd(rsync_cmd, check=False)

        for d in ["proc", "sys", "dev", "run", "tmp", "mnt", "media", "cdrom"]:
            os.makedirs(os.path.join(target_mount, d), exist_ok=True)

        self.log("Generating target /etc/fstab with persistent UUIDs...", "INFO")
        fstab_content = """# /etc/fstab: static file system information for OmniQ-OS
# Generated by OmniQ Permanent Disk Installer
LABEL=OmniQ-Root    /           ext4    noatime,errors=remount-ro 0 1
LABEL=EFI           /boot/efi   vfat    umask=0077,fmask=0077     0 2
tmpfs               /tmp        tmpfs   defaults,noatime,mode=1777 0 0
tmpfs               /dev/shm    tmpfs   defaults,noatime,size=4G   0 0
"""
        with open(os.path.join(target_mount, "etc/fstab"), "w") as f:
            f.write(fstab_content)

        self.log("Installing GRUB EFI bootloader...", "INFO")
        self.run_cmd(["grub-install", f"--boot-directory={target_mount}/boot", f"--efi-directory={esp_mount}", "--target=arm64-efi", "--bootloader-id=OmniQ-OS", "--recheck"], check=False)
        self.run_cmd(["update-grub"], check=False)

        self.log("Unmounting target filesystems...", "INFO")
        self.run_cmd(["umount", "-R", target_mount], check=False)

    def execute_installation(self):
        print(BANNER)
        disks = self.scan_disks()
        if not disks:
            self.log("No eligible storage disks found! Aborting.", "ERROR")
            sys.exit(1)

        if not self.target_disk:
            self.target_disk = self.select_disk_interactive()

        print(f"\n{YELLOW}======================================================================{RESET}")
        print(f" {RED}[WARNING]{WHITE} ALL DATA ON {RED}{self.target_disk}{WHITE} WILL BE PERMANENTLY ERASED!{RESET}")
        print(f"{YELLOW}======================================================================{RESET}")

        if not self.auto:
            confirm = input(f"{WHITE}Are you sure you want to proceed with installation? [type 'YES']: {RESET}").strip()
            if confirm != "YES":
                self.log("Installation aborted by user.", "WARN")
                sys.exit(0)

        start_time = time.time()
        self.log(f"Beginning permanent installation of OmniQ-OS to {self.target_disk}...", "INFO")

        parts = self.format_partitions(self.target_disk)
        self.partition_disk(self.target_disk)
        self.copy_system(parts["root"], parts["esp"])

        elapsed = time.time() - start_time
        print(f"\n{CYAN}======================================================================{RESET}")
        self.log(f"OmniQ-OS successfully installed to {self.target_disk} in {elapsed:.1f}s!", "SUCCESS")
        print(f"{CYAN}======================================================================{RESET}")
        print(f" You can now remove your bootable media and reboot into OmniQ-OS.\n")

def main():
    parser = argparse.ArgumentParser(description="OmniQ-OS Permanent Disk Installer")
    parser.add_argument("--target-disk", help="Target disk path (e.g. /dev/nvme0n1 or /dev/sda)")
    parser.add_argument("--auto", action="store_true", help="Non-interactive automated installation")
    parser.add_argument("--no-persistence", action="store_true", help="Disable persistence partition")
    args = parser.parse_args()

    installer = DiskInstaller(
        target_disk=args.target_disk,
        auto=args.auto,
        enable_persistence=(not args.no_persistence)
    )
    installer.execute_installation()

if __name__ == "__main__":
    main()
