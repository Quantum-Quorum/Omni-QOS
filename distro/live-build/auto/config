#!/bin/sh
set -e

lb config noauto \
    --mode debian \
    --distribution bookworm \
    --architectures arm64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --linux-packages "linux-image-rt-arm64" \
    --bootloader grub-efi \
    --image-name "OmniQ-OS-XFCE-Debian-arm64" \
    --iso-application "OmniQ-OS Real-Time Quantum Linux (XFCE Edition)" \
    --iso-publisher "OmniQ Project <developers@omniq.org>" \
    --iso-volume "OMNIQ_XFCE" \
    "${@}"

