# OmniQ-OS Plymouth Splash Script
# Electric Cyan (#00e5ff) & Obsidian Black (#080a0f)

Window.SetBackgroundTopColor(0.03, 0.04, 0.06);
Window.SetBackgroundBottomColor(0.05, 0.07, 0.11);

# Load logo
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.opacity = 0.0;

# Center logo
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 10);

progress = 0.0;

fun refresh_callback() {
    progress += 0.02;
    if (logo.opacity < 1.0) {
        logo.opacity += 0.03;
    }
    logo.sprite.SetOpacity(logo.opacity);
}

Plymouth.SetRefreshFunction(refresh_callback);
