    ("OmniQ Hub", "omniq://home", "Built-in OmniQ-OS Architecture & QASM Dataset Explorer"),
    ("OpenQASM 3.0", "https://openqasm.com", "OpenQASM 3.0 Language Specification"),
    ("arXiv quant-ph", "https://arxiv.org/list/quant-ph/recent", "Quantum Physics Preprints"),
    ("NIST PQC", "https://csrc.nist.gov/projects/post-quantum-cryptography", "FIPS 203 ML-KEM & FIPS 204 ML-DSA"),
    ("DuckDuckGo", "https://duckduckgo.com", "Private Web Search"),
]

