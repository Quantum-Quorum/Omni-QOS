def index_circuit_datasets() -> List[Dict[str, Any]]:
    cdir = os.path.join(REPO_ROOT, "circuits")
    if not os.path.isdir(cdir) and os.path.isdir("/opt/omniq/circuits"):
        cdir = "/opt/omniq/circuits"
    items: List[Dict[str, Any]] = []
    if not os.path.isdir(cdir):
        return items

    for fn in sorted(os.listdir(cdir)):
        fp = os.path.join(cdir, fn)
        if not os.path.isfile(fp) or not (fn.endswith(".qasm") or fn.endswith(".json")):
            continue
        try:
            with open(fp, "r", encoding="utf-8") as f:
                raw = f.read()
            if fn.endswith(".qasm"):
                qasm_str = raw
            else:
                doc = json.loads(raw)
                qasm_str = str(doc.get("qasm", ""))
            if not qasm_str:
                continue
            circ = Circuit.from_qasm(qasm_str)
            sv = circ.execute()
            ent = sv.entanglement_entropy() if isinstance(sv, Statevector) else 0.0
            items.append({
                "filename": fn,
                "filepath": fp,
                "num_qubits": circ.num_qubits,
                "gate_count": len(circ.gates),
                "entanglement_bits": round(float(ent), 4),
                "qasm": qasm_str,
            })
        except Exception:
            continue
    return items

def build_quantum_hub_html() -> str:
    datasets = index_circuit_datasets()
    cards_html = []
    for ds in datasets:
        fn_esc = html.escape(ds["filename"])
        fp_q = urllib.parse.quote(ds["filepath"])
        qasm_esc = html.escape(ds["qasm"].strip())
        cards_html.append(f"""
        <div class="card">
          <div class="card-hdr">
            <span class="fname">{fn_esc}</span>
            <span class="badge">{ds['num_qubits']} Qubits | {ds['gate_count']} Gates | S_A = {ds['entanglement_bits']:.3f} bits</span>
          </div>
          <pre>{qasm_esc}</pre>
          <div class="actions">
            <a class="btn cyan" href="omniq://open-editor?path={fp_q}">Open in OmniQ Edit</a>
            <a class="btn violet" href="omniq://open-maker?path={fp_q}">Circuit Maker</a>
            <a class="btn mint" href="omniq://open-hilbert?path={fp_q}">Hilbert Explorer</a>
            <a class="btn" href="omniq://open-debugger?path={fp_q}">Step Debugger</a>
          </div>
        </div>
        """)

    return f"""<!DOCTYPE html>
<html lang="en">
