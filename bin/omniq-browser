def resolve_sibling_bin(name: str) -> str:
    local = os.path.join(REPO_ROOT, "bin", name)
    if os.path.isfile(local):
        return local
    for p in [f"/usr/local/bin/{name}", f"/usr/bin/{name}"]:
        if os.path.isfile(p):
            return p
    return shutil.which(name) or local

def handle_omniq_uri(uri: str) -> bool:
    if not uri.startswith("omniq://"):
        return False
    parsed = urllib.parse.urlparse(uri)
    qs = urllib.parse.parse_qs(parsed.query)
    fpath = qs.get("path", [""])[0]
    target_map = {
        "open-editor": "omniq-edit",
        "open-maker": "omniq-circuit-maker",
        "open-hilbert": "omniq-hilbert-space",
        "open-debugger": "omniq-debugger",
    }
    tool = target_map.get(parsed.netloc)
    if tool:
        exe = resolve_sibling_bin(tool)
        cmd = [sys.executable, exe] if os.path.isfile(exe) else [exe]
        if fpath and os.path.exists(fpath):
            cmd.append(fpath)
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    return False

def launch_gui(start_url: Optional[str] = None) -> None:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    webkit_mod = None
    try:
        gi.require_version("WebKit2", "4.1")
        from gi.repository import WebKit2 as _WK
        webkit_mod = _WK
    except Exception:
        try:
            gi.require_version("WebKit2", "4.0")
            from gi.repository import WebKit2 as _WK
            webkit_mod = _WK
        except Exception:
            webkit_mod = None

    from gi.repository import Gdk, GLib, Gtk

    GLib.set_prgname("omniq-browser")
    GLib.set_application_name("OmniQ Quantum Browser")

    gtk_settings = Gtk.Settings.get_default()
    if gtk_settings is not None:
        gtk_settings.set_property("gtk-application-prefer-dark-theme", True)

    provider = Gtk.CssProvider()
    provider.load_from_data(DARK_GTK_CSS)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    class OmniQBrowserWindow(Gtk.Window):
        def __init__(self, initial: Optional[str] = None):
            super().__init__(title="OmniQ Browser - Quantum Documentation & QASM Dataset Explorer")
            self.set_default_size(1060, 700)
            self.set_position(Gtk.WindowPosition.CENTER)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            vbox.get_style_context().add_class("main-bg")
            self.add(vbox)

            nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            nav.get_style_context().add_class("browser-toolbar")

            btn_back = Gtk.Button(label="<")
            btn_back.get_style_context().add_class("nav-btn")
            btn_back.connect("clicked", lambda _b: self.webview.go_back() if self.webview else None)
            nav.pack_start(btn_back, False, False, 0)

            btn_fwd = Gtk.Button(label=">")
            btn_fwd.get_style_context().add_class("nav-btn")
            btn_fwd.connect("clicked", lambda _b: self.webview.go_forward() if self.webview else None)
            nav.pack_start(btn_fwd, False, False, 0)

            btn_hub = Gtk.Button(label="Quantum Hub")
            btn_hub.get_style_context().add_class("nav-btn")
            btn_hub.connect("clicked", lambda _b: self.navigate("omniq://home"))
            nav.pack_start(btn_hub, False, False, 0)

            self.url_entry = Gtk.Entry()
            self.url_entry.get_style_context().add_class("url-entry")
            self.url_entry.set_placeholder_text("Enter URL, omniq://home, or search query...")
            self.url_entry.connect("activate", lambda _e: self.navigate(self.url_entry.get_text()))
            nav.pack_start(self.url_entry, True, True, 0)

            btn_go = Gtk.Button(label="Go")
            btn_go.get_style_context().add_class("nav-btn")
            btn_go.connect("clicked", lambda _b: self.navigate(self.url_entry.get_text()))
            nav.pack_start(btn_go, False, False, 0)
            vbox.pack_start(nav, False, False, 0)

            bm = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            bm.get_style_context().add_class("bookmarks-bar")
            for label, target, tip in QUANTUM_PORTALS:
                b = Gtk.Button(label=label)
                b.get_style_context().add_class("bm-btn")
                b.set_tooltip_text(f"{tip}\n{target}")
                b.connect("clicked", lambda _btn, u=target: self.navigate(u))
                bm.pack_start(b, False, False, 0)

            btn_files = Gtk.Button(label="Open Circuits Folder")
            btn_files.get_style_context().add_class("local-btn")
            btn_files.connect(
                "clicked",
                lambda _b: subprocess.Popen(
                    [sys.executable, resolve_sibling_bin("omniq-files"), os.path.join(REPO_ROOT, "circuits")],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                ),
            )
            bm.pack_end(btn_files, False, False, 0)
            vbox.pack_start(bm, False, False, 0)

            self.webview = None
            if webkit_mod is not None:
                self.webview = webkit_mod.WebView()
                self.webview.connect("decide-policy", self._on_decide_policy)
                vbox.pack_start(self.webview, True, True, 0)
            else:
                sw = Gtk.ScrolledWindow()
                self.fallback_text = Gtk.TextView()
                self.fallback_text.set_editable(False)
                self.fallback_text.set_monospace(True)
                self.fallback_text.get_style_context().add_class("fallback-view")
                sw.add(self.fallback_text)
                vbox.pack_start(sw, True, True, 0)

            self.status_lbl = Gtk.Label(label="OmniQ Quantum Documentation & Dataset Engine Ready")
            self.status_lbl.get_style_context().add_class("statusbar")
            self.status_lbl.set_xalign(0.0)
            vbox.pack_start(self.status_lbl, False, False, 0)

            self.navigate(initial or "omniq://home")

        def _on_decide_policy(self, _webview, decision, decision_type) -> bool:
            try:
                req = decision.get_request()
                uri = req.get_uri() if req else ""
                if uri and uri.startswith("omniq://") and uri != "omniq://home":
                    if handle_omniq_uri(uri):
                        decision.ignore()
                        self.status_lbl.set_text(f"Launched OmniQ workbench for {uri}")
                        return True
            except Exception:
                pass
            return False

        def navigate(self, raw_target: str) -> None:
            t = (raw_target or "omniq://home").strip()
            self.url_entry.set_text(t)
            if t == "omniq://home":
                hub_html = build_quantum_hub_html()
                if self.webview is not None:
                    self.webview.load_html(hub_html, "omniq://home")
                else:
                    lines = ["=== OmniQ-OS Quantum Documentation & QASM Dataset Hub ===\n"]
                    for ds in index_circuit_datasets():
                        lines.append(
                            f"* {ds['filename']} ({ds['num_qubits']}Q, {ds['gate_count']} gates, S_A={ds['entanglement_bits']} bits)"
                        )
                        lines.append(ds["qasm"])
                    self.fallback_text.get_buffer().set_text("\n".join(lines))
                self.status_lbl.set_text("Loaded built-in OmniQ Quantum Documentation & Dataset Hub")
                return

            if os.path.isfile(t):
                url = "file://" + os.path.abspath(t)
            elif "://" in t:
                url = t
            elif "." in t and " " not in t:
                url = "https://" + t
            else:
                url = "https://duckduckgo.com/?q=" + urllib.parse.quote_plus(t)

            if self.webview is not None:
                self.webview.load_uri(url)
            else:
                self.fallback_text.get_buffer().set_text(f"Offline Documentation Mode\nTarget URI: {url}")
            self.status_lbl.set_text(f"Navigating to {url}")

    win = OmniQBrowserWindow(start_url)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()

def run_self_test() -> int:
    datasets = index_circuit_datasets()
    assert len(datasets) >= 7, f"Expected >= 7 indexed circuits, got {len(datasets)}"
    hub_html = build_quantum_hub_html()
    assert "bell_pair.qasm" in hub_html
    assert "ML-KEM-768" in hub_html
    print(f"[PASS] omniq-browser Quantum Documentation Hub & {len(datasets)} QASM datasets verified.")
    return 0

def main() -> None:
    if "--test" in sys.argv:
        sys.exit(run_self_test())
    url = None
    for a in sys.argv[1:]:
        if not a.startswith("-"):
            url = a
            break
    launch_gui(url)

if __name__ == "__main__":
    main()
