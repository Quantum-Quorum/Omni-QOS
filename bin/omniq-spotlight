ICON_DIRS = [
    "/usr/share/omniq/icons",
    "/etc/omniq/icons",
    os.path.join(REPO_ROOT, "etc/omniq/icons"),
    "/usr/share/omniq/icons/24x24",
    "/etc/omniq/icons/24x24",
    os.path.join(REPO_ROOT, "etc/omniq/icons/24x24"),
    "/usr/share/omniq/icons/16x16",
    "/etc/omniq/icons/16x16",
    os.path.join(REPO_ROOT, "etc/omniq/icons/16x16"),
]


def find_icon(name):
    for d in ICON_DIRS:
        p = os.path.join(d, name)
        if os.path.isfile(p):
            return p
    return None


