def discover_qasm_items(query):
    results = []
    search_roots = ["/root/circuits", os.path.expanduser("~/circuits")]
    seen = set()
    for sroot in search_roots:
        if not os.path.isdir(sroot):
            continue
        try:
            for fpath in glob.glob(os.path.join(sroot, "**/*.qasm"), recursive=True):
                real = os.path.realpath(fpath)
                if real in seen:
                    continue
                bname = os.path.basename(fpath)
                if not query or query in bname.lower() or query in "qasm circuit":
                    seen.add(real)
                    results.append({
                        "name": f"Circuit: {bname}",
                        "desc": fpath,
                        "cmd": ["/usr/local/bin/omniq-circuit-maker", fpath],
                        "cat": "QASM",
                        "icon": "circuits_folder",
                    })
        except Exception:
            pass
    return results[:6]


class SpotlightWindow(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_wmclass("omniq-spotlight", "Omniq-spotlight")
        self.set_title("OmniQ Spotlight")
        self.set_default_size(680, 430)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_keep_above(True)
        self._user_navigated = False

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            self.set_visual(visual)

        icon_path = find_icon("spotlight_16.png") or find_icon("spotlight.png")
        if icon_path:
            try:
                self.set_icon_from_file(icon_path)
            except Exception:
                pass

        style_provider = Gtk.CssProvider()
        style_provider.load_from_data(CSS_DATA)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            style_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )
        settings_gtk = Gtk.Settings.get_default()
        if settings_gtk:
            settings_gtk.set_property("gtk-application-prefer-dark-theme", True)

        container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        container.get_style_context().add_class("spotlight-box")
        self.add(container)

        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text("Search Quantum apps, QEC, VQE, settings, or .qasm circuits... [Esc to close]")
        if icon_path:
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(icon_path, 16, 16, True)
                self.entry.set_icon_from_pixbuf(Gtk.EntryIconPosition.PRIMARY, pix)
            except Exception:
                pass
        self.entry.connect("changed", self._on_search_changed)
        self.entry.connect("key-press-event", self._on_key_press)
        container.pack_start(self.entry, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_hexpand(True)
        scroll.set_vexpand(True)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-activated", self._on_row_activated)
        scroll.add(self.listbox)
        container.pack_start(scroll, True, True, 0)

        self.connect("focus-out-event", lambda _w, _e: self.destroy())
        self._filter_items("")

    def _filter_items(self, query):
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        q = query.strip().lower()
        matches = []
        for item in SYSTEM_ITEMS:
            if not q or (
                q in item["name"].lower()
                or q in item["desc"].lower()
                or q in item["cat"].lower()
            ):
                matches.append(item)

        qasm_hits = discover_qasm_items(q)
        if q:
            matches.extend(qasm_hits)
        else:
            matches = matches[:10] + qasm_hits[:2]

        for it in matches[:12]:
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.set_margin_start(4)
            box.set_margin_end(4)

            icon_file = (
                find_icon(f"{it['icon']}_24.png")
                or find_icon(f"{it['icon']}.png")
                or find_icon(f"{it['icon']}_16.png")
                or find_icon("omniq-logo_24.png")
            )
            if icon_file:
                box.pack_start(Gtk.Image.new_from_file(icon_file), False, False, 0)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            t_lbl = Gtk.Label(label=it["name"])
            t_lbl.set_xalign(0.0)
            t_lbl.get_style_context().add_class("item-title")
            vbox.pack_start(t_lbl, False, False, 0)

            d_lbl = Gtk.Label(label=it["desc"])
            d_lbl.set_xalign(0.0)
            d_lbl.get_style_context().add_class("item-desc")
            vbox.pack_start(d_lbl, False, False, 0)

            box.pack_start(vbox, True, True, 0)

            c_lbl = Gtk.Label(label=it["cat"])
            c_lbl.set_xalign(0.5)
            c_lbl.get_style_context().add_class("item-category")
            box.pack_start(c_lbl, False, False, 0)

            row.add(box)
            row.item_data = it
            self.listbox.add(row)

        self.listbox.show_all()
        first_row = self.listbox.get_row_at_index(0)
        if first_row:
            self.listbox.select_row(first_row)

    def _on_search_changed(self, entry):
        self._filter_items(entry.get_text())

    def _on_key_press(self, _widget, event):
        key = event.keyval
        if key == Gdk.KEY_Escape:
            self.destroy()
            return True
        if key == Gdk.KEY_Down:
            self._user_navigated = True
            sel = self.listbox.get_selected_row()
            if sel:
                nxt = self.listbox.get_row_at_index(sel.get_index() + 1)
                if nxt:
                    self.listbox.select_row(nxt)
            return True
        if key == Gdk.KEY_Up:
            self._user_navigated = True
            sel = self.listbox.get_selected_row()
            if sel and sel.get_index() > 0:
                prv = self.listbox.get_row_at_index(sel.get_index() - 1)
                if prv:
                    self.listbox.select_row(prv)
            return True
        if key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            query = self.entry.get_text().strip()
            if not query and not self._user_navigated:
                return True
            sel = self.listbox.get_selected_row()
            if sel and hasattr(sel, "item_data"):
                self._launch_item(sel.item_data)
            return True
        return False

    def _on_row_activated(self, _listbox, row):
        if hasattr(row, "item_data"):
            self._launch_item(row.item_data)

    def _launch_item(self, item):
        cmd = list(item.get("cmd", []))
        if cmd:
            exe = cmd[0]
            if exe.startswith("/usr/local/bin/"):
                base = os.path.basename(exe)
                repo_cand = os.path.join(os.path.dirname(os.path.abspath(__file__)), base)
                if os.path.isfile(exe) and os.access(exe, os.X_OK):
                    cmd[0] = exe
                elif shutil.which(base):
                    cmd[0] = shutil.which(base)
                elif os.path.isfile(repo_cand) and os.access(repo_cand, os.X_OK):
                    cmd[0] = repo_cand
            try:
                subprocess.Popen(cmd, start_new_session=True)
            except Exception as e:
                print(f"Failed to launch {cmd}: {e}")
        GLib.timeout_add(120, self.destroy)


def main():
    GLib.set_prgname("omniq-spotlight")
    if "--test" in sys.argv:
        assert len(SYSTEM_ITEMS) >= 20
        assert find_icon("spotlight_16.png") is not None
        print("[+] omniq-spotlight headless self-test passed.")
        return 0

    GLib.set_application_name("OmniQ Spotlight")
    win = SpotlightWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
