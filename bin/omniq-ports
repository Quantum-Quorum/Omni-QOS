"""
OmniQ-OS Active Socket & Quantum DMA Port Inspector (bin/omniq-ports)
- PyGObject GTK3 + CLI Port & Device Endpoint Inspector
- Highlights :9090 (omniqd), :9443 (omniq-secret-api PQC), /dev/accel/qpu0,
  /tmp/omniq_qpu0.sock, and GPUDirect-QPU PCIe Gen5 P2P DMA channels
"""

from __future__ import annotations

import json
import os
import re
import socket
import subprocess
import sys
from typing import Any, Dict, List, Tuple

REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
for _p in reversed([
    os.path.join(REPO_ROOT, "runtime", "python"),
    os.path.join(REPO_ROOT, "src"),
    "/opt/omniq/src",
    "/usr/lib/python3/dist-packages",
]):
    if _p not in sys.path:
        sys.path.insert(0, _p)

from omniqos.core import QPU

