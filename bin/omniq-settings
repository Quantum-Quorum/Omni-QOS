    def _build_notifications_page(self) -> Gtk.Widget:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card, _ = self._make_card(
            "System & Cryogenic Alert Notifications",
            f"Live shared alert feed synchronized with {NOTIFICATIONS_PATH}.",
        )
        act = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_refresh = Gtk.Button(label="Refresh Feed")
        btn_refresh.get_style_context().add_class("action-btn")
        btn_refresh.connect("clicked", lambda _b: self._refresh_notifications_ui())

        btn_test = Gtk.Button(label="Emit Test Alert")
        btn_test.get_style_context().add_class("action-btn-cyan")
        btn_test.connect("clicked", self._on_emit_test_notification)

        btn_clear = Gtk.Button(label="Clear All Notifications")
        btn_clear.get_style_context().add_class("action-btn-danger")
        btn_clear.connect("clicked", self._on_clear_notifications)

        act.pack_start(btn_refresh, False, False, 0)
        act.pack_start(btn_test, False, False, 0)
        act.pack_start(btn_clear, False, False, 0)
        card.pack_start(act, False, False, 0)

        self.notify_log_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.pack_start(self.notify_log_box, False, False, 4)
        self._refresh_notifications_ui()

        page.pack_start(card, False, False, 0)
        return page

    def _load_shared_notifications(self) -> Dict[str, Any]:
        items = load_notifications_file(NOTIFICATIONS_PATH)
        return {"cleared": len(items) == 0, "notifications": items}

    def _refresh_notifications_ui(self) -> None:
        for ch in self.notify_log_box.get_children():
            self.notify_log_box.remove(ch)
        items = load_notifications_file(NOTIFICATIONS_PATH)
        if not items:
            empty = Gtk.Label(label="No active quantum or cryogenic notifications.")
            empty.get_style_context().add_class("card-desc")
            empty.set_xalign(0.0)
            self.notify_log_box.pack_start(empty, False, False, 0)
            self.notify_log_box.show_all()
            return
        for item in items[:12]:
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            sev = str(item.get("severity", "info")).upper()
            ts = str(item.get("ts", "--:--:--"))
            hl = Gtk.Label(label=f"[{sev} @ {ts}] {item.get('title', 'Alert')}")
            hl.set_xalign(0.0)
            hl.get_style_context().add_class("metric-mono")
            bl = Gtk.Label(label=str(item.get("body", "")))
            bl.set_xalign(0.0)
            bl.set_line_wrap(True)
            bl.get_style_context().add_class("card-desc")
            row.pack_start(hl, False, False, 0)
            row.pack_start(bl, False, False, 0)
            self.notify_log_box.pack_start(row, False, False, 0)
        self.notify_log_box.show_all()

    def _on_emit_test_notification(self, _btn) -> None:
        items = load_notifications_file(NOTIFICATIONS_PATH)
        items.insert(
            0,
            {
                "title": "QMMU Calibration Drift Check Passed",
                "body": "All 127 transmon qubits verified within +/- 0.8 kHz f01 tolerance.",
                "severity": "info",
                "ts": time.strftime("%H:%M:%S"),
            },
        )
        save_notifications_file(items[:25], NOTIFICATIONS_PATH)
        self._refresh_notifications_ui()

    def _on_clear_notifications(self, _btn) -> None:
        save_notifications_file([], NOTIFICATIONS_PATH)
        self._refresh_notifications_ui()

    def _build_storage_page(self) -> Gtk.Widget:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card, _ = self._make_card(
            "Storage, NVMe Crate & POSIX Shared Memory",
            "Root filesystem capacity and /dev/shm zero-copy quantum telemetry rings.",
        )
        for mnt, title in [("/", "Root Filesystem (/)"), ("/dev/shm", "Quantum Zero-Copy SHM (/dev/shm)")]:
            if os.path.exists(mnt):
                usage = shutil.disk_usage(mnt)
                frac = usage.used / max(1, usage.total)
                used_gb = usage.used / (1024 ** 3)
                tot_gb = usage.total / (1024 ** 3)
                lbl = Gtk.Label(label=f"{title}: {used_gb:.2f} GiB / {tot_gb:.2f} GiB ({frac * 100:.1f}%)")
                lbl.set_xalign(0.0)
                pb = Gtk.ProgressBar()
                pb.set_fraction(min(1.0, max(0.0, frac)))
                card.pack_start(lbl, False, False, 0)
                card.pack_start(pb, False, False, 2)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_disks = Gtk.Button(label="Open OmniQ Disks Analyzer")
        btn_disks.get_style_context().add_class("action-btn-cyan")
        btn_disks.connect(
            "clicked",
            lambda _b: subprocess.Popen([sys.executable, resolve_bin("omniq-disks")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
        )
        btn_inst = Gtk.Button(label="Launch Disk Installer")
        btn_inst.get_style_context().add_class("action-btn")
        btn_inst.connect(
            "clicked",
            lambda _b: subprocess.Popen([resolve_bin("omniq-installer"), "--gui"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
        )
        btn_row.pack_start(btn_disks, False, False, 0)
        btn_row.pack_start(btn_inst, False, False, 0)
        card.pack_start(btn_row, False, False, 4)
        page.pack_start(card, False, False, 0)
        return page

