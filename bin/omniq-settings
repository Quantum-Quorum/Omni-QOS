def run_self_test() -> int:
    st = omniqd_request("GET", "/api/status")
    assert st["total_qubits"] == 127
    assert "cryo" in st

    backup = None
    if os.path.exists(NOTIFICATIONS_PATH):
        with open(NOTIFICATIONS_PATH, "r", encoding="utf-8") as f:
            backup = f.read()
    try:
        save_notifications_file([{"title": "UnitTest", "body": "Body", "severity": "info", "ts": "12:00:00"}])
        assert len(load_notifications_file()) == 1
        save_notifications_file([])
        assert len(load_notifications_file()) == 0

        ok, _ = Gtk.init_check(sys.argv)
        if ok:
            win = SettingsWindow(default_page="qpu_hardware")
            tags = [t for t, _, _ in win.category_buttons]
            assert tags == EXPECTED_PAGES, f"Mismatch in 14 settings pages: {tags}"
            for page_tag in EXPECTED_PAGES:
                assert win.stack.get_child_by_name(page_tag) is not None
                win._select_category(page_tag)
                assert win.stack.get_visible_child_name() == page_tag
            win._on_emit_test_notification(None)
            assert len(win._load_shared_notifications()["notifications"]) >= 1
            win._on_clear_notifications(None)
            assert win._load_shared_notifications()["notifications"] == []
            win.destroy()
    finally:
        if backup is not None:
            with open(NOTIFICATIONS_PATH, "w", encoding="utf-8") as f:
                f.write(backup)
        elif os.path.exists(NOTIFICATIONS_PATH):
            os.unlink(NOTIFICATIONS_PATH)

    print(f"[PASS] omniq-settings verified across all {len(EXPECTED_PAGES)} Control Center pages.")
    return 0

def main() -> None:
    if "--test" in sys.argv:
        sys.exit(run_self_test())

    GLib.set_prgname("omniq-settings")
    GLib.set_application_name("OmniQ Control Center")

    target_page = "wifi"
    aliases = {
        "wallpaper": "appearance",
        "theme": "appearance",
        "qpu": "qpu_hardware",
        "cryo": "cryo_safety",
        "safety": "cryo_safety",
        "qmmu": "qmmu_partitions",
        "pqc": "pqc_security",
        "soc2": "pqc_security",
    }
    for arg in sys.argv[1:]:
        if arg.startswith("--page="):
            target_page = arg.split("=", 1)[1]
        elif not arg.startswith("-"):
            target_page = arg
    target_page = aliases.get(target_page.lower(), target_page)

    win = SettingsWindow(default_page=target_page)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win._select_category(target_page)
    Gtk.main()

if __name__ == "__main__":
    main()
