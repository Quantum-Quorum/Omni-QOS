#!/usr/bin/env python3
"""
=============================================================================
OmniQ-OS: Real-Time Quantum Linux - Multi-Monitor & HDMI Display Switcher
Component: bin/omniq-display-switcher
=============================================================================
"""

import sys
import os
import subprocess

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def get_display_outputs():
    outputs = {"internal": None, "externals": [], "all_connected": []}
    try:
        x_out = subprocess.check_output(["xrandr"], stderr=subprocess.DEVNULL, timeout=2).decode()
        for line in x_out.splitlines():
            if " connected" in line:
                name = line.split()[0]
                outputs["all_connected"].append(name)
                if any(k in name.upper() for k in ["EDP", "LVDS", "DSI", "VIRTUAL"]):
                    if not outputs["internal"]:
                        outputs["internal"] = name
                    else:
                        outputs["externals"].append(name)
                else:
                    outputs["externals"].append(name)
    except Exception:
        pass

    if not outputs["internal"] and outputs["all_connected"]:
        outputs["internal"] = outputs["all_connected"][0]
        outputs["externals"] = outputs["all_connected"][1:]
    return outputs


def apply_display_mode(mode):
    d = get_display_outputs()
    internal = d["internal"]
    externals = d["externals"]
    if not internal and not externals:
        return "[!] No connected display outputs detected."

    ext = externals[0] if externals else None
    if mode == "auto":
        subprocess.run(["xrandr", "--auto"], check=False)
        return "[+] Auto-configured all connected displays."
    if not ext:
        subprocess.run(["xrandr", "--output", internal, "--auto"], check=False)
        return f"[+] Single display ({internal}) configured."

    if mode in ("mirror", "duplicate"):
        subprocess.run(["xrandr", "--output", internal, "--auto", "--output", ext, "--same-as", internal, "--auto"], check=False)
        return f"[+] Mirrored display: {ext} -> {internal}"
    if mode in ("extend", "extend-right"):
        subprocess.run(["xrandr", "--output", internal, "--auto", "--output", ext, "--right-of", internal, "--auto"], check=False)
        return f"[+] Extended desktop: {internal} (Left) + {ext} (Right)"
    if mode == "extend-left":
        subprocess.run(["xrandr", "--output", internal, "--auto", "--output", ext, "--left-of", internal, "--auto"], check=False)
        return f"[+] Extended desktop: {ext} (Left) + {internal} (Right)"
    if mode in ("external-only", "hdmi-only"):
        subprocess.run(["xrandr", "--output", internal, "--off", "--output", ext, "--auto"], check=False)
        return f"[+] External display only: {ext}"
    if mode in ("internal-only", "laptop-only"):
        subprocess.run(["xrandr", "--output", ext, "--off", "--output", internal, "--auto"], check=False)
        return f"[+] Primary internal display only: {internal}"
    return "[!] Unrecognized display mode."


def find_icon(name):
    for d in [
        "/usr/share/omniq/icons",
        "/etc/omniq/icons",
        os.path.join(REPO_ROOT, "etc/omniq/icons"),
        "/usr/share/omniq/icons/16x16",
        "/etc/omniq/icons/16x16",
        os.path.join(REPO_ROOT, "etc/omniq/icons/16x16"),
    ]:
        p = os.path.join(d, name)
        if os.path.isfile(p):
            return p
    return None


def show_switcher_gui():
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk, Gdk, GLib
        GLib.set_prgname("omniq-display-switcher")
        GLib.set_application_name("OmniQ Display Switcher")
    except Exception:
        print(apply_display_mode("auto"))
        return

    d = get_display_outputs()
    internal = d["internal"] or "Virtual-1"
    ext = d["externals"][0] if d["externals"] else None

    win = Gtk.Window(title="Display & HDMI Monitor Switcher — OmniQ-OS")
    win.set_wmclass("omniq-display-switcher", "Omniq-display-switcher")
    icon_path = find_icon("screensaver_16.png") or find_icon("omniq-logo_16.png")
    if icon_path:
        try:
            win.set_icon_from_file(icon_path)
        except Exception:
            pass
    win.set_default_size(470, 280)
    win.set_position(Gtk.WindowPosition.CENTER)
    win.set_border_width(16)

    css = b"""
    window { background-color: #0D0B18; }
    .disp-title { color: #00E5FF; font-size: 15px; font-weight: bold; }
    .disp-desc { color: #9E97B8; font-size: 11px; }
    .btn-mode {
        background-color: #141126;
        color: #EDEAF5;
        font-size: 12px;
        border-radius: 8px;
        padding: 10px 14px;
        border: 1px solid rgba(0, 229, 255, 0.42);
    }
    .btn-mode:hover {
        background: linear-gradient(135deg, #8A4FFF, #00E5FF);
        color: #FFFFFF;
    }
    .btn-cancel {
        background-color: #1A1530;
        color: #EDEAF5;
        font-size: 12px;
        border-radius: 8px;
        padding: 8px 16px;
        border: 1px solid rgba(138, 79, 255, 0.35);
    }
    """
    css_prov = Gtk.CssProvider()
    css_prov.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), css_prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    box.set_margin_start(4)
    box.set_margin_end(4)
    win.add(box)

    lbl_title = Gtk.Label(label="OmniQ Multi-Monitor & HDMI Display Switcher")
    lbl_title.get_style_context().add_class("disp-title")
    lbl_title.set_xalign(0.0)
    box.pack_start(lbl_title, False, False, 0)

    status_str = f"Primary Display: {internal}"
    status_str += f"  |  External: {ext} (Connected)" if ext else "  |  External: None detected"
    lbl_status = Gtk.Label(label=status_str)
    lbl_status.get_style_context().add_class("disp-desc")
    lbl_status.set_xalign(0.0)
    box.pack_start(lbl_status, False, False, 0)

    lbl_result = Gtk.Label(label="")
    lbl_result.set_xalign(0.0)

    grid = Gtk.Grid()
    grid.set_column_spacing(10)
    grid.set_row_spacing(10)
    grid.set_column_homogeneous(True)

    def on_click(mode):
        res = apply_display_mode(mode)
        lbl_result.set_markup(f"<span foreground='#00FF9D'><b>{res}</b></span>")

    for idx, (label, mode) in enumerate([
        ("Duplicate (Mirror)", "mirror"),
        ("Extend Desktop (Right)", "extend-right"),
        ("External HDMI Only", "external-only"),
        ("Primary Screen Only", "laptop-only"),
    ]):
        b = Gtk.Button(label=label)
        b.get_style_context().add_class("btn-mode")
        b.connect("clicked", lambda _btn, m=mode: on_click(m))
        grid.attach(b, idx % 2, idx // 2, 1, 1)

    box.pack_start(grid, False, False, 4)
    box.pack_start(lbl_result, False, False, 4)

    btn_cancel = Gtk.Button(label="Close")
    btn_cancel.get_style_context().add_class("btn-cancel")
    btn_cancel.connect("clicked", lambda _b: win.destroy())
    box.pack_end(btn_cancel, False, False, 0)

    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


def main():
    if "--test" in sys.argv:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import GLib
        GLib.set_prgname("omniq-display-switcher")
        assert find_icon("screensaver_16.png") is not None
        print("[+] omniq-display-switcher headless self-test passed.")
        return 0

    if "--mirror" in sys.argv or "--duplicate" in sys.argv:
        print(apply_display_mode("mirror"))
    elif "--extend" in sys.argv or "--extend-right" in sys.argv:
        print(apply_display_mode("extend-right"))
    elif "--extend-left" in sys.argv:
        print(apply_display_mode("extend-left"))
    elif "--external-only" in sys.argv or "--hdmi-only" in sys.argv:
        print(apply_display_mode("external-only"))
    elif "--laptop-only" in sys.argv or "--internal-only" in sys.argv:
        print(apply_display_mode("laptop-only"))
    elif "--auto" in sys.argv:
        print(apply_display_mode("auto"))
    else:
        show_switcher_gui()
    return 0


if __name__ == "__main__":
    sys.exit(main())
