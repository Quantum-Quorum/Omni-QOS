def format_bytes(b: int) -> str:
    if b <= 0:
        return "0 B"
    val = float(b)
    for unit in ["B", "KiB", "MiB", "GiB", "TiB"]:
        if val < 1024.0:
            return f"{val:.1f} {unit}"
        val /= 1024.0
    return f"{val:.1f} PiB"


def scan_storage_topology() -> Dict[str, Any]:
    """Collects NVMe, SATA, VirtIO, SquashFS live mounts, and /dev/shm telemetry pools."""
    block_devs: List[Dict[str, Any]] = []
    try:
        res = subprocess.run(
            ["lsblk", "-J", "-b", "-o", "NAME,PATH,FSTYPE,LABEL,MODEL,SIZE,TYPE,MOUNTPOINTS,TRAN,RO"],
            capture_output=True,
            text=True,
            timeout=3,
        )
        if res.returncode == 0:
            raw = json.loads(res.stdout).get("blockdevices", [])
            for d in raw:
                nm = str(d.get("name", ""))
                fstype = str(d.get("fstype") or "")
                # Keep real disks AND SquashFS loop mounts
                if nm.startswith("loop") and fstype != "squashfs":
                    continue
                block_devs.append(d)
    except Exception:
        pass

    if not block_devs and os.path.exists("/proc/partitions"):
        with open("/proc/partitions", "r", encoding="utf-8") as f:
            for line in f.readlines()[2:]:
                parts = line.split()
                if len(parts) >= 4 and not parts[3].startswith("ram"):
                    block_devs.append({
                        "name": parts[3],
                        "path": f"/dev/{parts[3]}",
                        "size": int(parts[2]) * 1024,
                        "type": "disk" if not parts[3][-1].isdigit() else "part",
                        "fstype": "ext4",
                        "mountpoints": ["/"] if parts[3] in ("sda", "vda", "nvme0n1p2") else [],
                    })

    special_mounts: List[Dict[str, Any]] = []
    for path, desc in [
        ("/", "Root Filesystem"),
        ("/dev/shm", "POSIX Quantum Zero-Copy SHM Ring"),
        ("/tmp", "Real-Time IPC & QASM Scratch"),
    ]:
        if os.path.exists(path):
            usage = shutil.disk_usage(path)
            special_mounts.append({
                "mountpoint": path,
                "description": desc,
                "total_bytes": usage.total,
                "used_bytes": usage.used,
                "free_bytes": usage.free,
                "used_pct": round((usage.used / max(1, usage.total)) * 100.0, 2),
            })

    return {"blockdevices": block_devs, "filesystems": special_mounts}


def draw_partition_bar(cr, width: float, height: float, parts: List[Dict[str, Any]]) -> None:
    cr.set_source_rgb(0.08, 0.06, 0.16)
    cr.rectangle(0, 0, width, height)
    cr.fill()

    palette = [
        (0.0, 0.90, 1.0),
        (0.54, 0.31, 1.0),
        (0.0, 1.0, 0.62),
        (1.0, 0.65, 0.15),
    ]
    total = sum(max(1, int(p.get("size") or 0)) for p in parts) or 1
    x = 2.0
    avail_w = max(20.0, width - 4.0)
    for idx, p in enumerate(parts):
        sz = max(1, int(p.get("size") or 0))
        seg_w = max(18.0, (sz / total) * avail_w)
        if x + seg_w > width - 2.0:
            seg_w = max(6.0, (width - 2.0) - x)
        col = palette[idx % len(palette)]
        cr.set_source_rgba(col[0], col[1], col[2], 0.78)
        cr.rectangle(x, 3.0, max(2.0, seg_w - 2.0), height - 6.0)
        cr.fill()
        cr.set_source_rgb(0.04, 0.03, 0.08)
        cr.set_font_size(9.5)
        lbl = f"{p.get('name', 'part')} ({format_bytes(sz)})"
        if seg_w > 70:
            cr.move_to(x + 6.0, height * 0.62)
            cr.show_text(lbl[:24])
        x += seg_w
        if x >= width - 4.0:
            break


def print_cli(data: Dict[str, Any]) -> None:
    print("=" * 80)
    print(" OmniQ-OS Storage & Partition Analyzer (NVMe / SATA / SquashFS / Quantum SHM)")
    print("=" * 80)
    for d in data["blockdevices"]:
        sz = format_bytes(int(d.get("size") or 0))
        mdl = d.get("model") or d.get("fstype") or "Block Device"
        print(f" [DISK] /dev/{d.get('name', '?'):<12} {sz:<12} ({mdl})")
        for ch in d.get("children", []) or []:
            csz = format_bytes(int(ch.get("size") or 0))
            cfs = ch.get("fstype") or "-"
            mnts = ", ".join(m for m in (ch.get("mountpoints") or []) if m) or "-"
            print(f"   |-- {ch.get('name', '?'):<14} {csz:<12} {cfs:<10} {mnts}")
    print("-" * 80)
    for fs in data["filesystems"]:
        print(
            f" [FS]   {fs['mountpoint']:<14} {format_bytes(fs['used_bytes'])} / "
            f"{format_bytes(fs['total_bytes'])} ({fs['used_pct']}%) - {fs['description']}"
        )
    print("=" * 80)


def launch_gui() -> None:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    GLib.set_prgname("omniq-disks")
    GLib.set_application_name("OmniQ Disks")

    gtk_settings = Gtk.Settings.get_default()
    if gtk_settings is not None:
        gtk_settings.set_property("gtk-application-prefer-dark-theme", True)

    provider = Gtk.CssProvider()
    provider.load_from_data(DARK_CSS)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    class OmniQDisksWindow(Gtk.Window):
        def __init__(self):
            super().__init__(title="OmniQ Disks — NVMe, SATA, SquashFS & Quantum SHM Analyzer")
            self.set_default_size(920, 620)
            self.set_position(Gtk.WindowPosition.CENTER)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            vbox.get_style_context().add_class("main-bg")
            self.add(vbox)

            hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            hdr.get_style_context().add_class("header-bar")
            tbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            tl = Gtk.Label(label="OMNIQ STORAGE & SQUASHFS PARTITION ANALYZER")
            tl.get_style_context().add_class("title-lbl")
            tl.set_xalign(0.0)
            sl = Gtk.Label(label="Inspects NVMe/SATA block geometry, Live ISO SquashFS images, and /dev/shm telemetry rings")
            sl.get_style_context().add_class("sub-lbl")
            sl.set_xalign(0.0)
            tbox.pack_start(tl, False, False, 0)
            tbox.pack_start(sl, False, False, 0)
            hdr.pack_start(tbox, True, True, 0)

            btn_refresh = Gtk.Button(label="Rescan Storage")
            btn_refresh.connect("clicked", lambda _b: self._populate())
            hdr.pack_end(btn_refresh, False, False, 0)

            btn_inst = Gtk.Button(label="Launch Disk Installer")
            btn_inst.get_style_context().add_class("accent-btn")
            btn_inst.connect(
                "clicked",
                lambda _b: subprocess.Popen(
                    [os.path.join(REPO_ROOT, "bin", "omniq-installer"), "--gui"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                ),
            )
            hdr.pack_end(btn_inst, False, False, 0)
            vbox.pack_start(hdr, False, False, 0)

            scroll = Gtk.ScrolledWindow()
            scroll.set_hexpand(True)
            scroll.set_vexpand(True)
            self.list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            self.list_box.set_margin_start(14)
            self.list_box.set_margin_end(14)
            self.list_box.set_margin_top(12)
            self.list_box.set_margin_bottom(12)
            scroll.add(self.list_box)
            vbox.pack_start(scroll, True, True, 0)

            self._populate()

        def _populate(self) -> None:
            for ch in self.list_box.get_children():
                self.list_box.remove(ch)

            topo = scan_storage_topology()

            # Quantum SHM & Mounts Card
            shm_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            shm_card.get_style_context().add_class("drive-card")
            sh_lbl = Gtk.Label(label="Mounted Filesystems & Quantum POSIX Shared Memory")
            sh_lbl.get_style_context().add_class("title-lbl")
            sh_lbl.set_xalign(0.0)
            shm_card.pack_start(sh_lbl, False, False, 0)

            for fs in topo["filesystems"]:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                row.get_style_context().add_class("part-row")
                ml = Gtk.Label(
                    label=(
                        f"{fs['mountpoint']} ({fs['description']})  —  "
                        f"{format_bytes(fs['used_bytes'])} / {format_bytes(fs['total_bytes'])}"
                    )
                )
                ml.set_xalign(0.0)
                badge = Gtk.Label(label=f"{fs['used_pct']:.1f}% USED")
                badge.get_style_context().add_class("badge-mnt")
                row.pack_start(ml, True, True, 0)
                row.pack_end(badge, False, False, 0)
                shm_card.pack_start(row, False, False, 0)
            self.list_box.pack_start(shm_card, False, False, 0)

            for dev in topo["blockdevices"]:
                card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
                card.get_style_context().add_class("drive-card")

                tran = str(dev.get("tran") or dev.get("type") or "BLOCK").upper()
                model = str(dev.get("model") or dev.get("label") or "Linux Storage Volume").strip()
                sz = format_bytes(int(dev.get("size") or 0))
                dl = Gtk.Label(label=f"/dev/{dev.get('name')}  —  {model}  [{tran} | {sz}]")
                dl.get_style_context().add_class("title-lbl")
                dl.set_xalign(0.0)
                card.pack_start(dl, False, False, 0)

                parts = dev.get("children") or [dev]
                bar = Gtk.DrawingArea()
                bar.set_size_request(-1, 34)
                bar.connect(
                    "draw",
                    lambda w, cr, ps=parts: draw_partition_bar(
                        cr, float(w.get_allocated_width()), float(w.get_allocated_height()), ps
                    ),
                )
                card.pack_start(bar, False, False, 0)

                for p in parts:
                    prow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                    prow.get_style_context().add_class("part-row")
                    pname = f"/dev/{p.get('name', '?')}  ({format_bytes(int(p.get('size') or 0))})"
                    pl = Gtk.Label(label=pname)
                    pl.set_xalign(0.0)
                    prow.pack_start(pl, True, True, 0)

                    fstype = str(p.get("fstype") or "raw")
                    bfs = Gtk.Label(label=fstype.upper())
                    bfs.get_style_context().add_class("badge-fs")
                    prow.pack_end(bfs, False, False, 0)

                    mnts = [m for m in (p.get("mountpoints") or []) if m]
                    if mnts:
                        bm = Gtk.Label(label=", ".join(mnts))
                        bm.get_style_context().add_class("badge-mnt")
                        prow.pack_end(bm, False, False, 0)
                    card.pack_start(prow, False, False, 0)

                self.list_box.pack_start(card, False, False, 0)

            self.list_box.show_all()

    win = OmniQDisksWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


def run_self_test() -> int:
    import cairo

    topo = scan_storage_topology()
    assert "filesystems" in topo and len(topo["filesystems"]) >= 1
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 500, 36)
    cr = cairo.Context(surf)
    draw_partition_bar(cr, 500.0, 36.0, [{"name": "nvme0n1p1", "size": 536870912}, {"name": "nvme0n1p2", "size": 68719476736}])
    print("[PASS] omniq-disks NVMe/SATA/SquashFS topology & Cairo partition map verified.")
    return 0


def main() -> None:
    if "--test" in sys.argv:
        sys.exit(run_self_test())
    if "--json" in sys.argv:
        print(json.dumps(scan_storage_topology(), indent=2))
        return
    if "--cli" in sys.argv or not os.environ.get("DISPLAY"):
        print_cli(scan_storage_topology())
        return
    launch_gui()


if __name__ == "__main__":
    main()
