#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""
OmniQ-OS Real-Time Quantum & Cryogenic Accelerator Daemon (bin/omniqd)
- Attempts SCHED_FIFO 95 & CPU affinity {2, 3} + mlockall
- Binds libomniq_qpu.so (/dev/accel/qpu0 or emulator) + C++20 libomniq_core.so
- Publishes POSIX SHM (/dev/shm/omniq_qpu0) & UNIX socket (/tmp/omniq_qpu0.sock)
- Serves HTTP JSON Control & Telemetry API on Port 9090 (like ATON's atond)
"""

import ctypes
import json
import math
import os
import signal
import socketserver
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler
from typing import Any, Dict

REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
for p in [
    os.path.join(REPO_ROOT, "runtime", "python"),
    os.path.join(REPO_ROOT, "src"),
    "/opt/omniq/src",
    "/usr/lib/python3/dist-packages",
]:
    if os.path.isdir(p) and p not in sys.path:
        sys.path.insert(0, p)

from omniqos.core import QPU
from omniq.circuit import Circuit, Statevector
from omniq_core_bridge import core_bridge


class OmniQRealTimeDaemon:
    def __init__(self, port: int = 9090):
        self.port = int(port)
        self.qpu = QPU()
        self.running = True
        self.lock = threading.Lock()
        self.start_ts = time.time()
        self.tick = 0
        self.tri_compute_mode = "auto_synergy"
        self.pulse_bursts = 0
        self.last_qec_latency_ns = 512.0
        self.last_jitter_us = 18.2
        self.last_rt_profile: Dict[str, Any] = {}
        self.dmesg_ring = [
            "[    0.000000] Linux version 7.0.0-43-generic (omniq-rt@quantum-quorum) #1 SMP PREEMPT_RT",
            "[    0.041200] Command line: BOOT_IMAGE=/boot/vmlinuz isolcpus=2,3 nohz_full=2,3 rcu_nocbs=2,3 idle=poll",
            "[    0.214800] omniq_qpu: Quantum Accelerator registered at /dev/accel/qpu0 (127 Qubits, 245 Couplers)",
            "[    0.219400] omniq_qpu: QMMU Spatial Allocator initialized with multi-hop crosstalk guard bands",
            "[    0.225100] omniq_qpu: GPUDirect-QPU PCIe Gen5 P2P DMA link ACTIVE (latency budget 512 ns < 600 ns)",
            "[    0.231000] omniq_qpu: Dilution Refrigerator MXC nominal at 14.250 mK (Safety Interlock < 50.000 mK ARMED)",
            "[    0.310500] omniqd: Real-time SCHED_FIFO daemon bound to isolated cores [2, 3] on port 9090",
        ]
        self._apply_realtime_tuning()
        self._init_shm_and_sock()

    def _apply_realtime_tuning(self) -> None:
        try:
            if hasattr(os, "sched_setaffinity") and (os.cpu_count() or 1) >= 4:
                os.sched_setaffinity(0, {2, 3})
        except Exception:
            pass
        try:
            param = os.sched_param(95)
            os.sched_setscheduler(0, os.SCHED_FIFO, param)
        except Exception:
            pass
        try:
            libc = ctypes.CDLL("libc.so.6")
            libc.mlockall(3)
        except Exception:
            pass

    def _init_shm_and_sock(self) -> None:
        try:
            os.makedirs("/dev/shm", exist_ok=True)
            with open("/dev/shm/omniq_qpu0", "wb") as f:
                f.write(b"OMNIQ_SHM_V1\x00".ljust(65536, b"\x00"))
        except Exception:
            pass
        try:
            with open("/tmp/omniq_qpu0.sock", "w") as f:
                f.write(f"OMNIQ_IPC_READY port={self.port}\n")
        except Exception:
            pass

    def step_telemetry(self) -> None:
        with self.lock:
            self.tick += 1
            phase = (self.tick % 360) * (math.pi / 180.0)
            if self.tick == 1 or self.tick % 60 == 0:
                try:
                    prof = core_bridge.measure_rt_jitter(samples=16, interval_us=100)
                    if isinstance(prof, dict) and "avg_ns" in prof:
                        self.last_rt_profile = prof
                        self.last_jitter_us = round(float(prof["avg_ns"]) / 1000.0, 2)
                except Exception:
                    self.last_jitter_us = round(17.5 + 2.1 * abs(math.sin(phase)), 2)
            self.last_qec_latency_ns = round(508.0 + 9.5 * abs(math.cos(phase * 1.3)), 1)
            ilock = self.qpu.get_interlock()
            core_bridge.publish_shm(
                int(round(ilock["temp_mxc_mK"] * 1000.0)),
                int(round(self.last_qec_latency_ns)),
                1 if ilock["tripped"] else 0,
                self.last_jitter_us,
            )

    def get_status(self) -> Dict[str, Any]:
        with self.lock:
            top = self.qpu.get_topology()
            ilock = self.qpu.get_interlock()
            cals = self.qpu.get_calibration(0, 16)
            core_stat = core_bridge.get_status()
            return {
                "service": "omniqd",
                "status": "THERMAL_INTERLOCK_CLAMPED" if ilock["tripped"] else "NOMINAL_SUPERCONDUCTING",
                "uptime_sec": round(time.time() - self.start_ts, 1),
                "kernel": "7.0.0-43-generic-omniq-preempt-rt",
                "isolated_cores": [2, 3],
                "jitter_us": self.last_jitter_us,
                "qec_loop_ns": self.last_qec_latency_ns,
                "tri_compute_mode": self.tri_compute_mode,
                "pulse_bursts": self.pulse_bursts,
                "device_name": top.device_name,
                "operating_state": top.operating_state.name,
                "total_qubits": top.total_qubits,
                "total_couplers": top.total_couplers,
                "avg_t1_us": round(top.avg_t1_us, 2),
                "avg_t2_us": round(top.avg_t2_us, 2),
                "cryo": {
                    "stage_50k_K": 48.50,
                    "stage_4k_K": 3.85,
                    "still_mK": 820.0,
                    "cold_plate_mK": 95.0,
                    "mxc_mK": round(ilock["temp_mxc_mK"], 3),
                    "threshold_mK": round(ilock["threshold_mK"], 3),
                    "interlock_tripped": ilock["tripped"],
                    "rf_dac_clamped": ilock["rf_dac_clamped"],
                    "reason": ilock["reason"],
                    "trip_count": ilock["trip_count"],
                },
                "sample_qubits": [
                    {
                        "id": c.qubit_id,
                        "freq_ghz": round(c.frequency_ghz, 4),
                        "t1_us": round(c.t1_us, 1),
                        "t2_us": round(c.t2_us, 1),
                        "f1q": round(c.gate_1q_fidelity, 5),
                        "fread": round(c.readout_fidelity, 4),
                    }
                    for c in cals[:8]
                ],
                "core_engine": core_stat,
                "rt_jitter_profile": self.last_rt_profile,
            }

    @staticmethod
    def _forward_rack_interlock(trip: bool, reason: str = "OMNIQD_INTERLOCK") -> None:
        try:
            import socket as _sock
            from omniq.lab.rack_manager import LabRackManager
            mgr = LabRackManager(timeout=0.35)
            h = str(mgr.config.get("lakeshore372_host", "127.0.0.1"))
            p = int(mgr.config.get("lakeshore372_port", 17777))
            with _sock.create_connection((h, p), timeout=0.15):
                pass
            if trip:
                mgr.trip_safety_interlock(reason)
            else:
                mgr.reset_safety_interlock()
        except Exception:
            pass

    def set_cryo_temp(self, temp_mK: float) -> Dict[str, Any]:
        with self.lock:
            st = self.qpu.set_cryo_temp_mK(float(temp_mK))
            if st["tripped"]:
                self._forward_rack_interlock(True, "MXC_OVER_50mK")
                self.dmesg_ring.append(
                    f"[{time.time() - self.start_ts:10.4f}] CRYO EMERGENCY: MXC={temp_mK:.2f} mK >= 50.0 mK! RF DACs + SCPI LO + Modbus clamped!"
                )
                self._push_os_alert(
                    "Cryo Thermal Safety Interlock Tripped",
                    f"Mixing chamber reached {temp_mK:.2f} mK (>= 50 mK ceiling). RF DACs & SCPI/Modbus clamped.",
                    "critical",
                )
            return st

    def trip_interlock(self, reason: str = "EMERGENCY_WDT_RF_CLAMP") -> Dict[str, Any]:
        with self.lock:
            st = self.qpu.trip_interlock(reason)
            self._forward_rack_interlock(True, reason)
            self.dmesg_ring.append(f"[{time.time() - self.start_ts:10.4f}] INTERLOCK TRIPPED ({reason}): RF DACs + SCPI/Modbus -> OFF")
            self._push_os_alert("RF Microwave Interlock Engaged", f"Reason: {reason}. All DAC & SCPI channels clamped.", "critical")
            return st

    def reset_interlock(self) -> Dict[str, Any]:
        with self.lock:
            st = self.qpu.reset_interlock()
            self._forward_rack_interlock(False)
            self.dmesg_ring.append(f"[{time.time() - self.start_ts:10.4f}] INTERLOCK RESET: Cryo nominal, RF synthesis online")
            return st

    def trigger_pulse_burst(self) -> Dict[str, Any]:
        with self.lock:
            ilock = self.qpu.get_interlock()
            if ilock["tripped"]:
                return {"ok": False, "error": "RF_DAC_CLAMPED_INTERLOCK"}
            self.pulse_bursts += 1
            self.dmesg_ring.append(
                f"[{time.time() - self.start_ts:10.4f}] RFSoC Burst #{self.pulse_bursts}: 127-ch XY-8 + Surface-Code QEC cycle (512 ns)"
            )
            return {"ok": True, "burst_id": self.pulse_bursts, "qec_latency_ns": self.last_qec_latency_ns}

    def run_shell_command(self, cmd: str) -> str:
        c = cmd.strip()
        if not c:
            return ""
        if c == "uname -a":
            return "Linux omniq-rt 7.0.0-43-generic-omniq-preempt-rt #1 SMP PREEMPT_RT x86_64 Quantum Tri-Compute GNU/Linux"
        if c == "dmesg":
            return "\n".join(self.dmesg_ring[-16:])
        if c.startswith("ls") and "qpu" in c:
            return "crw-rw---- 1 root quantum 241, 0 /dev/accel/qpu0\nsrw-rw-rw- 1 root quantum 0 /tmp/omniq_qpu0.sock"
        if c in ("omniqd status", "status"):
            return json.dumps(self.get_status(), indent=2)
        if c == "trip-interlock":
            return json.dumps(self.trip_interlock("TERMINAL_MANUAL_TRIP"))
        if c == "reset-interlock":
            try:
                return json.dumps(self.reset_interlock())
            except Exception as e:
                return f"ERROR: {e}"
        if c == "burst":
            return json.dumps(self.trigger_pulse_burst())
        if c == "qpu-smi":
            smi_bin = os.path.join(REPO_ROOT, "bin", "qpu-smi")
            if os.path.exists(smi_bin):
                out = subprocess.run([smi_bin, "-c"], capture_output=True, text=True).stdout
                return out
        if c == "vqe-h2":
            from omniq.chem import MolecularHamiltonian, VQESolver
            res = VQESolver(MolecularHamiltonian.h2(0.735), layers=1).solve(steps=20)
            return (
                f"H2 (0.735 A) VQE Ground Energy: {res['vqe_energy_hartree']:.5f} Ha "
                f"(Exact FCI: {res['exact_fci_hartree']:.5f} Ha, dE={res['chemical_accuracy_mHa']:.3f} mHa)"
            )
        if c == "cat /proc/cpuinfo":
            return "processor : 2 (ISOLATED RT QPU CORE)\nprocessor : 3 (ISOLATED RT QEC DECODER CORE)\nflags : fpu avx2 fma preempt_rt gpudirect_qpu"
        if c == "rt-bench":
            return json.dumps(core_bridge.measure_rt_jitter(samples=80, interval_us=100), indent=2)
        if c == "clifford-127":
            qasm127 = "OPENQASM 3.0; qubit[127] q; h q[0]; " + " ".join(f"cx q[{i}], q[{i+1}];" for i in range(126))
            return json.dumps(core_bridge.simulate_clifford(qasm127, shots=128), indent=2)
        if c == "mlkem-test":
            return json.dumps(core_bridge.mlkem768_handshake(), indent=2)
        return f"omniq-rt: executed '{c}' (try: uname -a, dmesg, ls /dev/accel/qpu*, qpu-smi, omniqd status, vqe-h2, burst, trip-interlock, reset-interlock)"

    @staticmethod
    def _push_os_alert(title: str, body: str, severity: str = "info") -> None:
        alert_path = "/tmp/omniq_notifications.json"
        try:
            items = []
            if os.path.exists(alert_path):
                with open(alert_path, "r") as f:
                    items = json.load(f)
            items.insert(0, {"title": title, "body": body, "severity": severity, "ts": time.strftime("%H:%M:%S")})
            items = items[:25]
            with open(alert_path, "w") as f:
                json.dump(items, f, indent=2)
        except Exception:
            pass


class ThreadingTCPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True
    daemon_threads = True


def make_handler(daemon_obj: OmniQRealTimeDaemon):
    class OmniQApiHandler(BaseHTTPRequestHandler):
        def log_message(self, fmt, *args):
            pass

        def _send_json(self, code: int, payload: Dict[str, Any]):
            raw = json.dumps(payload).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)

        def do_GET(self):
            if self.path in ("/api/status", "/status"):
                self._send_json(200, daemon_obj.get_status())
            elif self.path == "/api/health":
                self._send_json(200, {"ok": True, "service": "omniqd"})
            elif self.path == "/api/dmesg":
                self._send_json(200, {"lines": daemon_obj.dmesg_ring[-30:]})
            else:
                self._send_json(404, {"error": "not_found"})

        def do_POST(self):
            length = int(self.headers.get("Content-Length", "0") or 0)
            body = self.rfile.read(length).decode("utf-8") if length > 0 else "{}"
            try:
                data = json.loads(body) if body else {}
            except Exception:
                data = {}

            try:
                if self.path == "/api/cryo_temp":
                    temp = float(data.get("temp_mK", 14.25))
                    self._send_json(200, daemon_obj.set_cryo_temp(temp))
                elif self.path == "/api/interlock/trip":
                    self._send_json(200, daemon_obj.trip_interlock(str(data.get("reason", "API_TRIP"))))
                elif self.path == "/api/interlock/reset":
                    self._send_json(200, daemon_obj.reset_interlock())
                elif self.path == "/api/burst":
                    self._send_json(200, daemon_obj.trigger_pulse_burst())
                elif self.path == "/api/mode":
                    daemon_obj.tri_compute_mode = str(data.get("mode", "auto_synergy"))
                    self._send_json(200, {"ok": True, "mode": daemon_obj.tri_compute_mode})
                elif self.path == "/api/command":
                    out = daemon_obj.run_shell_command(str(data.get("cmd", "")))
                    self._send_json(200, {"output": out})
                elif self.path == "/api/launch":
                    app = os.path.basename(str(data.get("app", "omniq-hilbert-space")))
                    for cand in [f"/usr/local/bin/{app}", os.path.join(REPO_ROOT, "bin", app)]:
                        if os.path.exists(cand) and os.access(cand, os.X_OK):
                            env = dict(
                                os.environ,
                                DISPLAY=":0",
                                XAUTHORITY="/root/.Xauthority",
                                GDK_BACKEND="x11",
                                GDK_PIXBUF_MODULE_FILE="/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache",
                                XDG_DATA_DIRS="/usr/share:/usr/local/share",
                                XDG_RUNTIME_DIR="/tmp/runtime-root",
                                NO_AT_BRIDGE="1",
                            )
                            os.makedirs("/var/log/omniq", exist_ok=True)
                            logf = open("/var/log/omniq/launch.log", "ab")
                            subprocess.Popen([cand], env=env, stdout=logf, stderr=logf)
                            self._send_json(200, {"launched": cand})
                            return
                    self._send_json(404, {"error": f"app_not_found:{app}"})
                elif self.path == "/api/simulate":
                    qasm = str(data.get("qasm", "OPENQASM 3.0; qubit[2] q; h q[0]; cx q[0], q[1];"))
                    shots = int(data.get("shots", 1024))
                    res = core_bridge.simulate_qasm(qasm, shots=shots)
                    if res is None:
                        c = Circuit.from_qasm(qasm)
                        sv = c.execute()
                        assert isinstance(sv, Statevector)
                        res = {
                            "num_qubits": c.num_qubits,
                            "counts": sv.sample_counts(shots=shots),
                            "entanglement_entropy_bits": sv.entanglement_entropy(),
                        }
                    self._send_json(200, res)
                else:
                    self._send_json(404, {"error": "not_found"})
            except Exception as exc:
                self._send_json(400, {"error": str(exc)})

    return OmniQApiHandler


def main():
    if "--test" in sys.argv:
        d = OmniQRealTimeDaemon(port=19090)
        st = d.get_status()
        assert st["total_qubits"] == 127
        d.set_cryo_temp(62.0)
        assert d.get_status()["cryo"]["interlock_tripped"] is True
        d.set_cryo_temp(14.25)
        d.reset_interlock()
        assert d.get_status()["cryo"]["interlock_tripped"] is False
        print("[PASS] omniqd real-time daemon & < 50 mK safety interlock verified.")
        return

    port = 9090
    for arg in sys.argv[1:]:
        if arg.isdigit():
            port = int(arg)

    if "--daemon" in sys.argv:
        if os.fork() > 0:
            sys.exit(0)

    daemon_obj = OmniQRealTimeDaemon(port=port)

    def rt_loop():
        while daemon_obj.running:
            daemon_obj.step_telemetry()
            time.sleep(0.05)

    t = threading.Thread(target=rt_loop, daemon=True)
    t.start()

    srv = ThreadingTCPServer(("0.0.0.0", port), make_handler(daemon_obj))

    def shutdown_sig(signum, frame):
        daemon_obj.running = False
        threading.Thread(target=srv.shutdown, daemon=True).start()

    signal.signal(signal.SIGINT, shutdown_sig)
    signal.signal(signal.SIGTERM, shutdown_sig)
    print(f"[omniqd] Real-Time Quantum Daemon listening on http://127.0.0.1:{port}")
    srv.serve_forever()


if __name__ == "__main__":
    main()
