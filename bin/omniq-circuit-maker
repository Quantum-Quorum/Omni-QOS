from omniq.circuit import Circuit, Statevector
from omniqos.core import QPU
from omniq.lab.qick_rfsoc import QickProgramCompiler

HILBERT_IPC_PATH = "/tmp/omniq_hilbert_state.json"

ONE_Q_GATES = {"H", "X", "Y", "Z", "S", "SDG", "T", "TDG", "SX", "RX", "RY", "RZ", "P", "RESET", "MEASURE"}
PARAM_GATES = {"RX", "RY", "RZ", "P", "CP", "CRZ"}
TWO_Q_GATES = {"CNOT", "CY", "CZ", "SWAP", "ISWAP", "CP", "CRZ"}
THREE_Q_GATES = {"CCX", "CSWAP"}


@dataclass
class PlacedGate:
    col: int
    gate: str
    qubits: List[int]
    angle: float = 0.0


class CircuitGridModel:
    """Column-scheduled visual quantum circuit model backed by omniq.circuit.Circuit."""

    def __init__(self, num_qubits: int = 3, num_cols: int = 12):
        self.num_qubits = max(1, min(8, int(num_qubits)))
        self.num_cols = max(6, int(num_cols))
        self.items: List[PlacedGate] = []

    def clear(self) -> None:
        self.items.clear()

    def remove_at(self, col: int, wire: int) -> bool:
        before = len(self.items)
        self.items = [it for it in self.items if not (it.col == col and wire in it.qubits)]
        return len(self.items) < before

    def place(self, col: int, gate: str, qubits: List[int], angle: float = 0.0) -> None:
        g = gate.upper()
        # Remove any existing gate occupying same (col, occupied_wires)
        span_min, span_max = min(qubits), max(qubits)
        self.items = [
            it for it in self.items
            if not (it.col == col and any(span_min <= w <= span_max for w in it.qubits))
        ]
        if col >= self.num_cols - 1:
            self.num_cols = col + 4
        self.items.append(PlacedGate(col=int(col), gate=g, qubits=list(qubits), angle=float(angle)))
        self.items.sort(key=lambda x: (x.col, x.qubits[0]))

    def to_circuit(self, max_col: Optional[int] = None) -> Circuit:
        c = Circuit(self.num_qubits)
        ordered = sorted(self.items, key=lambda x: (x.col, x.qubits[0]))
        for it in ordered:
            if max_col is not None and it.col > max_col:
                continue
            c.add_gate(it.gate, it.qubits, angle=it.angle)
        return c

    def load_from_circuit(self, circ: Circuit) -> None:
        self.num_qubits = max(1, min(8, circ.num_qubits))
        self.items.clear()
        wire_free_col = [0] * self.num_qubits
        for g in circ.gates:
            gt = g[0].upper()
            if gt == "BARRIER":
                continue
            if gt in ("H", "X", "Y", "Z", "S", "SDG", "T", "TDG", "SX", "RESET"):
                q = g[1]
                col = wire_free_col[q]
                self.items.append(PlacedGate(col, gt, [q], 0.0))
                wire_free_col[q] = col + 1
            elif gt in ("RX", "RY", "RZ", "P", "PHASE"):
                q = g[1]
                col = wire_free_col[q]
                self.items.append(PlacedGate(col, "P" if gt == "PHASE" else gt, [q], float(g[2])))
                wire_free_col[q] = col + 1
            elif gt == "MEASURE":
                q = g[1]
                col = wire_free_col[q]
                self.items.append(PlacedGate(col, "MEASURE", [q], 0.0))
                wire_free_col[q] = col + 1
            elif gt in ("CNOT", "CX", "CY", "CZ", "SWAP", "ISWAP"):
                q1, q2 = g[1], g[2]
                lo, hi = min(q1, q2), max(q1, q2)
                col = max(wire_free_col[w] for w in range(lo, hi + 1))
                self.items.append(PlacedGate(col, "CNOT" if gt == "CX" else gt, [q1, q2], 0.0))
                for w in range(lo, hi + 1):
                    wire_free_col[w] = col + 1
            elif gt in ("CP", "CRZ"):
                q1, q2, ang = g[1], g[2], float(g[3])
                lo, hi = min(q1, q2), max(q1, q2)
                col = max(wire_free_col[w] for w in range(lo, hi + 1))
                self.items.append(PlacedGate(col, gt, [q1, q2], ang))
                for w in range(lo, hi + 1):
                    wire_free_col[w] = col + 1
            elif gt in ("CCX", "CSWAP"):
                q1, q2, q3 = g[1], g[2], g[3]
                lo, hi = min(q1, q2, q3), max(q1, q2, q3)
                col = max(wire_free_col[w] for w in range(lo, hi + 1))
                self.items.append(PlacedGate(col, gt, [q1, q2, q3], 0.0))
                for w in range(lo, hi + 1):
                    wire_free_col[w] = col + 1
        max_used = max([it.col for it in self.items], default=0)
        self.num_cols = max(12, max_used + 4)


def build_template_circuit(name: str) -> Circuit:
    t = name.lower()
    if t == "bell":
        return Circuit(2).h(0).cx(0, 1).measure_all()
    if t == "ghz4":
        return Circuit(4).h(0).cx(0, 1).cx(1, 2).cx(2, 3).measure_all()
    if t == "teleportation":
        c = Circuit(3)
        c.ry(0, 1.0472)  # Prepare payload state on q0
        c.h(1).cx(1, 2)  # Shared Bell pair on q1, q2
        c.cx(0, 1).h(0)
        c.cx(1, 2).cz(0, 2)
        return c
    if t == "grover3":
        c = Circuit(3)
        c.h(0).h(1).h(2)
        # Oracle marking |111> via H-CCX-H
        c.h(2).ccx(0, 1, 2).h(2)
        # Diffuser
        c.h(0).h(1).h(2).x(0).x(1).x(2)
        c.h(2).ccx(0, 1, 2).h(2)
        c.x(0).x(1).x(2).h(0).h(1).h(2)
        return c
    if t == "qft4":
        c = Circuit(4).x(0).x(2)
        for j in range(4):
            c.h(j)
            for k in range(j + 1, 4):
                c.cp(math.pi / (1 << (k - j)), k, j)
        c.swap(0, 3).swap(1, 2)
        return c
    if t == "vqe_h2":
        return Circuit(2).x(0).ry(1, 0.225).cx(1, 0)
    if t == "qec_bitflip":
        return Circuit(5).h(0).cx(0, 1).cx(0, 2).x(1).cx(0, 3).cx(1, 3).cx(1, 4).cx(2, 4)
    if t == "superdense":
        return Circuit(2).h(0).cx(0, 1).x(0).z(0).cx(0, 1).h(0).measure_all()
    return Circuit(3).h(0).cx(0, 1).cx(1, 2)


def run_self_test() -> int:
    for tpl in ["bell", "ghz4", "teleportation", "grover3", "qft4", "vqe_h2", "qec_bitflip", "superdense"]:
        c = build_template_circuit(tpl)
        grid = CircuitGridModel()
        grid.load_from_circuit(c)
        c2 = grid.to_circuit()
        sv = c2.execute()
        assert isinstance(sv, Statevector)
        assert abs(np.sum(sv.probabilities()) - 1.0) < 1e-9
    # Verify Grover 3Q amplifies |111>
    g_sv = build_template_circuit("grover3").execute()
    assert g_sv.probabilities()[7] > 0.75
    print("[PASS] omniq-circuit-maker grid scheduler, 8 quantum templates, QASM round-trip & Grover amplification verified.")
    return 0


