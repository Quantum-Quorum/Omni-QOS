def gate_color_rgb(gate: str) -> Tuple[float, float, float]:
    g = gate.upper()
    if g == "H":
        return (0.0, 0.72, 0.92)
    if g in ("X", "Y", "Z", "SX"):
        return (0.12, 0.78, 0.52)
    if g in ("RX", "RY", "RZ", "P", "CP", "CRZ"):
        return (0.56, 0.32, 0.98)
    if g in ("CNOT", "CY", "CZ", "CCX"):
        return (0.0, 0.85, 1.0)
    if g in ("SWAP", "ISWAP", "CSWAP"):
        return (0.95, 0.62, 0.14)
    if g == "MEASURE":
        return (0.92, 0.24, 0.44)
    return (0.36, 0.46, 0.68)


def launch_gui(initial_path: Optional[str] = None) -> None:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    GLib.set_prgname("omniq-circuit-maker")

    provider = Gtk.CssProvider()
    provider.load_from_data(DARK_CSS)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    class CircuitMakerWindow(Gtk.Window):
        def __init__(self):
            super().__init__(title="OmniQ Quantum Circuit Maker & Multi-Framework Compiler IDE")
            self.set_default_size(1320, 810)
            self.set_wmclass("omniq-circuit-maker", "omniq-circuit-maker")

            self.grid_model = CircuitGridModel(3, 14)
            self.grid_model.load_from_circuit(build_template_circuit("teleportation"))

            self.selected_gate = "H"
            self.selected_angle = math.pi / 2.0
            self.pending_wires: List[int] = []
            self.pending_col: Optional[int] = None
            self.scrub_col: int = 999  # All columns active

            self.current_sv: Statevector = Statevector.zero_state(3)
            self.qpu_last_report: str = "Ready — click 'Execute on /dev/accel/qpu0' to allocate QMMU partition."

            self._build_ui()
            if initial_path and os.path.exists(initial_path):
                try:
                    with open(initial_path, "r") as f:
                        self.grid_model.load_from_circuit(Circuit.from_qasm(f.read()))
                except Exception:
                    pass
            self._resimulate()
            self.connect("destroy", Gtk.main_quit)

        def _build_ui(self):
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            root.get_style_context().add_class("main-bg")
            self.add(root)

            # Top Header Bar
            hbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            hbar.get_style_context().add_class("header-bar")
            hbar.set_margin_start(12)
            hbar.set_margin_end(12)
            hbar.set_margin_top(8)
            hbar.set_margin_bottom(8)

            ttl = Gtk.Label(label="OMNIQ QUANTUM CIRCUIT MAKER")
            ttl.get_style_context().add_class("title-lbl")
            ttl.set_xalign(0.0)
            hbar.pack_start(ttl, False, False, 4)

            # Qubit count selector
            ql = Gtk.Label(label="Wires:")
            hbar.pack_start(ql, False, False, 4)
            self.q_spin = Gtk.SpinButton.new_with_range(1, 8, 1)
            self.q_spin.set_value(self.grid_model.num_qubits)
            self.q_spin.connect("value-changed", self._on_wires_changed)
            hbar.pack_start(self.q_spin, False, False, 0)

            # Templates dropdown
            hbar.pack_start(Gtk.Label(label="Template:"), False, False, 4)
            self.tpl_combo = Gtk.ComboBoxText()
            templates = [
                ("teleportation", "Quantum Teleportation (3Q)"),
                ("bell", "Bell Pair |Phi+> (2Q)"),
                ("ghz4", "GHZ Cat State (4Q)"),
                ("grover3", "Grover Search |111> (3Q)"),
                ("qft4", "Quantum Fourier Transform (4Q)"),
                ("vqe_h2", "H2 Singlet UCCSD VQE (2Q)"),
                ("qec_bitflip", "3-Qubit Bit-Flip QEC (5Q)"),
                ("superdense", "Superdense Coding (2Q)"),
            ]
            for tid, tname in templates:
                self.tpl_combo.append(tid, tname)
            self.tpl_combo.set_active_id("teleportation")
            self.tpl_combo.connect("changed", self._on_template_changed)
            hbar.pack_start(self.tpl_combo, False, False, 0)

            clr_btn = Gtk.Button(label="Clear Grid")
            clr_btn.connect("clicked", self._on_clear_grid)
            hbar.pack_start(clr_btn, False, False, 2)

            # Action buttons on right
            hilb_btn = Gtk.Button(label="Inspect in Hilbert Space")
            hilb_btn.get_style_context().add_class("hilbert-btn")
            hilb_btn.connect("clicked", self._open_in_hilbert_space)
            hbar.pack_end(hilb_btn, False, False, 4)

            run_btn = Gtk.Button(label="Execute on /dev/accel/qpu0")
            run_btn.get_style_context().add_class("run-qpu-btn")
            run_btn.connect("clicked", self._execute_on_qpu)
            hbar.pack_end(run_btn, False, False, 4)

            qick_btn = Gtk.Button(label="Dispatch QICK ZCU216")
            qick_btn.get_style_context().add_class("run-qpu-btn")
            qick_btn.connect("clicked", self._dispatch_qick_rfsoc)
            hbar.pack_end(qick_btn, False, False, 4)

            root.pack_start(hbar, False, False, 0)

            # Gate Palette Toolbar
            pbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            pbar.set_margin_start(12)
            pbar.set_margin_end(12)
            pbar.set_margin_top(6)
            pbar.set_margin_bottom(4)

            self.gate_buttons: Dict[str, Gtk.Button] = {}
            all_gates = [
                "H", "X", "Y", "Z", "S", "T", "SX",
                "RX", "RY", "RZ", "P",
                "CNOT", "CZ", "SWAP", "ISWAP", "CP", "CCX", "CSWAP",
                "RESET", "MEASURE",
            ]
            for gname in all_gates:
                b = Gtk.Button(label=gname)
                if gname == self.selected_gate:
                    b.get_style_context().add_class("gate-selected")
                b.connect("clicked", self._on_select_gate, gname)
                self.gate_buttons[gname] = b
                pbar.pack_start(b, False, False, 0)

            pbar.pack_start(Gtk.Label(label="  Angle(rad):"), False, False, 2)
            self.ang_spin = Gtk.SpinButton.new_with_range(-6.2832, 6.2832, 0.05)
            self.ang_spin.set_digits(3)
            self.ang_spin.set_value(self.selected_angle)
            self.ang_spin.connect("value-changed", lambda s: setattr(self, "selected_angle", float(s.get_value())))
            pbar.pack_start(self.ang_spin, False, False, 0)

            pi_btn = Gtk.Button(label="pi/2")
            pi_btn.connect("clicked", lambda _b: self.ang_spin.set_value(math.pi / 2.0))
            pbar.pack_start(pi_btn, False, False, 0)

            pi4_btn = Gtk.Button(label="pi/4")
            pi4_btn.connect("clicked", lambda _b: self.ang_spin.set_value(math.pi / 4.0))
            pbar.pack_start(pi4_btn, False, False, 0)

            root.pack_start(pbar, False, False, 0)

            # Hint + Time-Slice Scrubber Row
            sbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            sbar.set_margin_start(14)
            sbar.set_margin_end(14)
            sbar.set_margin_bottom(4)

            self.hint_lbl = Gtk.Label(
                label="Left-click grid cell to place gate | Right-click gate to remove | Drag Time-Slice Scrubber to inspect intermediate states"
            )
            self.hint_lbl.get_style_context().add_class("hint-lbl")
            self.hint_lbl.set_xalign(0.0)
            sbar.pack_start(self.hint_lbl, False, False, 0)

            self.scrub_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, -1, 16, 1)
            self.scrub_scale.set_digits(0)
            self.scrub_scale.set_value(16)
            self.scrub_scale.set_size_request(240, -1)
            self.scrub_scale.connect("value-changed", self._on_scrub_changed)
            sbar.pack_end(self.scrub_scale, False, False, 0)
            sbar.pack_end(Gtk.Label(label="Time-Slice Cursor:"), False, False, 0)

            root.pack_start(sbar, False, False, 0)

            # Upper Half: Interactive Multi-Wire Quantum Circuit Canvas
            vpaned = Gtk.Paned(orientation=Gtk.Orientation.VERTICAL)
            vpaned.set_margin_start(10)
            vpaned.set_margin_end(10)
            vpaned.set_margin_bottom(10)
            root.pack_start(vpaned, True, True, 0)

            circuit_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            circuit_card.get_style_context().add_class("panel-card")
            self.grid_canvas = Gtk.DrawingArea()
            self.grid_canvas.set_size_request(-1, 330)
            self.grid_canvas.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            self.grid_canvas.connect("draw", self._draw_circuit_grid)
            self.grid_canvas.connect("button-press-event", self._on_grid_click)
            circuit_card.pack_start(self.grid_canvas, True, True, 0)
            vpaned.pack1(circuit_card, resize=True, shrink=False)

            # Lower Half: Live Histogram + Bloch Spheres | Multi-Target Transpiler & Pulse Schedule
            bottom_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            bottom_box.set_margin_top(8)

            # Bottom-Left: Live Probability Histogram + Per-Qubit Bloch Spheres
            sim_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            sim_card.get_style_context().add_class("panel-card")
            sim_card.set_size_request(620, 280)
            self.sim_canvas = Gtk.DrawingArea()
            self.sim_canvas.connect("draw", self._draw_live_sim_panel)
            sim_card.pack_start(self.sim_canvas, True, True, 0)
            bottom_box.pack_start(sim_card, True, True, 0)

            # Bottom-Right: Multi-Framework Compiler & RFSoC Pulse Schedule Notebook
            nb_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            nb_card.get_style_context().add_class("panel-card")
            self.notebook = Gtk.Notebook()

            # Tab 1: Editable OpenQASM 3.0
            qasm_tab = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            qasm_sw = Gtk.ScrolledWindow()
            self.qasm_view = Gtk.TextView()
            self.qasm_view.set_monospace(True)
            self.qasm_view.override_background_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.05, 0.04, 0.11, 1.0))
            self.qasm_view.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.84, 0.96, 1.0, 1.0))
            qasm_sw.add(self.qasm_view)
            qasm_tab.pack_start(qasm_sw, True, True, 0)

            qasm_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            qasm_bar.set_margin_start(6)
            qasm_bar.set_margin_end(6)
            qasm_bar.set_margin_bottom(6)
            sync_btn = Gtk.Button(label="Parse OpenQASM -> Visual Grid")
            sync_btn.connect("clicked", self._parse_qasm_editor_to_grid)
            qasm_bar.pack_start(sync_btn, False, False, 0)
            qasm_tab.pack_start(qasm_bar, False, False, 0)
            self.notebook.append_page(qasm_tab, Gtk.Label(label="OpenQASM 3.0"))

            # Tab 2: Multi-Framework SDK Code (Qiskit / Cirq / PennyLane)
            sdk_sw = Gtk.ScrolledWindow()
            self.sdk_view = Gtk.TextView()
            self.sdk_view.set_editable(False)
            self.sdk_view.set_monospace(True)
            self.sdk_view.override_background_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.05, 0.04, 0.11, 1.0))
            self.sdk_view.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.78, 0.92, 0.88, 1.0))
            sdk_sw.add(self.sdk_view)
            self.notebook.append_page(sdk_sw, Gtk.Label(label="Qiskit / Cirq / PennyLane"))

            # Tab 3: RFSoC Microwave Pulse Schedule Canvas
            self.pulse_canvas = Gtk.DrawingArea()
            self.pulse_canvas.connect("draw", self._draw_pulse_schedule)
            self.notebook.append_page(self.pulse_canvas, Gtk.Label(label="RFSoC Microwave Pulses"))

            # Tab 4: Hardware /dev/accel/qpu0 Execution Log
            qpu_sw = Gtk.ScrolledWindow()
            self.qpu_view = Gtk.TextView()
            self.qpu_view.set_editable(False)
            self.qpu_view.set_monospace(True)
            self.qpu_view.override_background_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.05, 0.04, 0.11, 1.0))
            self.qpu_view.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.0, 1.0, 0.62, 1.0))
            qpu_sw.add(self.qpu_view)
            self.notebook.append_page(qpu_sw, Gtk.Label(label="QPU Hardware Run"))

            # Tab 5: Fermilab QICK tProc v2 FPGA Assembly (Xilinx ZCU216 RFSoC)
            qick_sw = Gtk.ScrolledWindow()
            self.qick_view = Gtk.TextView()
            self.qick_view.set_editable(False)
            self.qick_view.set_monospace(True)
            self.qick_view.override_background_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.05, 0.04, 0.11, 1.0))
            self.qick_view.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.96, 0.84, 0.42, 1.0))
            qick_sw.add(self.qick_view)
            self.notebook.append_page(qick_sw, Gtk.Label(label="QICK tProc (ZCU216)"))

            nb_card.pack_start(self.notebook, True, True, 0)
            bottom_box.pack_start(nb_card, True, True, 0)
            vpaned.pack2(bottom_box, resize=True, shrink=False)

        # ---- Event Handlers ----
        def _on_select_gate(self, _btn, gname: str):
            self.selected_gate = gname
            self.pending_wires.clear()
            self.pending_col = None
            for k, b in self.gate_buttons.items():
                ctx = b.get_style_context()
                if k == gname:
                    ctx.add_class("gate-selected")
                else:
                    ctx.remove_class("gate-selected")
            if gname in TWO_Q_GATES:
                self.hint_lbl.set_text(f"[{gname}] Click Control wire first, then Target wire in the desired column.")
            elif gname in THREE_Q_GATES:
                self.hint_lbl.set_text(f"[{gname}] Click Control 1 -> Control 2 -> Target wire.")
            else:
                self.hint_lbl.set_text(f"[{gname}] Click any (wire, column) slot to place; right-click to delete.")
            self.grid_canvas.queue_draw()

        def _on_wires_changed(self, spin):
            nq = int(spin.get_value())
            self.grid_model.num_qubits = nq
            self.grid_model.items = [
                it for it in self.grid_model.items if all(w < nq for w in it.qubits)
            ]
            self.pending_wires.clear()
            self._resimulate()

        def _on_template_changed(self, combo):
            tid = combo.get_active_id()
            if tid:
                circ = build_template_circuit(tid)
                self.grid_model.load_from_circuit(circ)
                self.q_spin.handler_block_by_func(self._on_wires_changed)
                self.q_spin.set_value(self.grid_model.num_qubits)
                self.q_spin.handler_unblock_by_func(self._on_wires_changed)
                self.scrub_scale.set_range(-1, self.grid_model.num_cols)
                self.scrub_scale.set_value(self.grid_model.num_cols)
                self._resimulate()

        def _on_clear_grid(self, _btn):
            self.grid_model.clear()
            self.pending_wires.clear()
            self._resimulate()

        def _on_scrub_changed(self, scale):
            self.scrub_col = int(scale.get_value())
            self._resimulate(update_qasm_editor=False)

        def _parse_qasm_editor_to_grid(self, _btn):
            buf = self.qasm_view.get_buffer()
            txt = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), True)
            try:
                circ = Circuit.from_qasm(txt)
                self.grid_model.load_from_circuit(circ)
                self.q_spin.handler_block_by_func(self._on_wires_changed)
                self.q_spin.set_value(self.grid_model.num_qubits)
                self.q_spin.handler_unblock_by_func(self._on_wires_changed)
                self._resimulate(update_qasm_editor=False)
                self.hint_lbl.set_text("Parsed OpenQASM onto visual circuit grid.")
            except Exception as e:
                self.hint_lbl.set_text(f"QASM parse error: {e}")

        def _grid_geometry(self, w: float, h: float) -> Tuple[float, float, float, float]:
            x0 = 78.0
            y0 = 36.0
            nq = self.grid_model.num_qubits
            ncols = self.grid_model.num_cols
            wire_step = max(34.0, min(58.0, (h - 56.0) / max(1, nq)))
            col_step = max(54.0, (w - x0 - 30.0) / max(1, ncols))
            return x0, y0, wire_step, col_step

        def _on_grid_click(self, widget, ev):
            alloc = widget.get_allocation()
            x0, y0, wire_step, col_step = self._grid_geometry(float(alloc.width), float(alloc.height))
            wire = int(round((ev.y - y0) / wire_step))
            col = int((ev.x - x0) / col_step)
            if wire < 0 or wire >= self.grid_model.num_qubits or col < 0 or col >= self.grid_model.num_cols:
                return

            # Right-click deletes gate
            if ev.button == 3:
                if self.grid_model.remove_at(col, wire):
                    self.pending_wires.clear()
                    self._resimulate()
                return

            g = self.selected_gate
            ang = float(self.ang_spin.get_value()) if g in PARAM_GATES else 0.0

            if g in ONE_Q_GATES:
                self.grid_model.place(col, g, [wire], ang)
                self._resimulate()
            elif g in TWO_Q_GATES:
                if self.grid_model.num_qubits < 2:
                    self.hint_lbl.set_text("Increase Wires >= 2 to place multi-qubit gates.")
                    return
                if not self.pending_wires:
                    self.pending_wires = [wire]
                    self.pending_col = col
                    self.hint_lbl.set_text(f"[{g}] Control q[{wire}] selected — now click Target wire.")
                    self.grid_canvas.queue_draw()
                else:
                    if wire != self.pending_wires[0]:
                        target_col = self.pending_col if self.pending_col is not None else col
                        self.grid_model.place(target_col, g, [self.pending_wires[0], wire], ang)
                        self.pending_wires.clear()
                        self.pending_col = None
                        self.hint_lbl.set_text(f"Placed {g} at column {target_col}.")
                        self._resimulate()
            elif g in THREE_Q_GATES:
                if self.grid_model.num_qubits < 3:
                    self.hint_lbl.set_text("Increase Wires >= 3 to place 3-qubit gates.")
                    return
                if wire not in self.pending_wires:
                    if not self.pending_wires:
                        self.pending_col = col
                    self.pending_wires.append(wire)
                    if len(self.pending_wires) < 3:
                        self.hint_lbl.set_text(f"[{g}] Selected {self.pending_wires} — click wire #{len(self.pending_wires)+1}.")
                        self.grid_canvas.queue_draw()
                    else:
                        tcol = self.pending_col if self.pending_col is not None else col
                        self.grid_model.place(tcol, g, list(self.pending_wires), 0.0)
                        self.pending_wires.clear()
                        self.pending_col = None
                        self._resimulate()

        def _resimulate(self, update_qasm_editor: bool = True):
            full_circ = self.grid_model.to_circuit()
            active_circ = self.grid_model.to_circuit(max_col=self.scrub_col)
            sv = active_circ.execute()
            assert isinstance(sv, Statevector)
            self.current_sv = sv

            if update_qasm_editor:
                self.qasm_view.get_buffer().set_text(full_circ.to_qasm("3.0"))

            sdk_text = (
                "# === Qiskit Export ===\n"
                + full_circ.to_qiskit_code()
                + "\n# === Google Cirq Export ===\n"
                + full_circ.to_cirq_code()
                + "\n# === PennyLane Export ===\n"
                + full_circ.to_pennylane_code()
            )
            self.sdk_view.get_buffer().set_text(sdk_text)
            self.qpu_view.get_buffer().set_text(self.qpu_last_report)

            try:
                qprog = QickProgramCompiler().compile(full_circ)
                wf_hdr = (
                    f"// Target: Xilinx Zynq UltraScale+ RFSoC ZCU216 | f_fabric={qprog['f_fabric_mhz']} MHz "
                    f"| Instructions={qprog['instruction_count']} | Duration={qprog['duration_ns']} ns "
                    f"| Fast QEC Feedback={qprog['syndrome_feedback_ns']} ns (< 500 ns)\n"
                    f"// Registered 16-bit DAC Envelopes: {len(qprog['waveforms'])}\n\n"
                )
                self.qick_view.get_buffer().set_text(wf_hdr + qprog["assembly"])
            except Exception as qe:
                self.qick_view.get_buffer().set_text(f"// QICK compile warning: {qe}")

            # Live broadcast to Hilbert Space IPC file if <= 6 qubits
            if self.current_sv.num_qubits <= 6:
                try:
                    payload = {
                        "source": f"Circuit Maker (col <= {self.scrub_col})",
                        "num_qubits": self.current_sv.num_qubits,
                        "amplitudes_re": np.real(self.current_sv.data).tolist(),
                        "amplitudes_im": np.imag(self.current_sv.data).tolist(),
                        "qasm": active_circ.to_qasm("3.0"),
                    }
                    with open(HILBERT_IPC_PATH, "w") as f:
                        json.dump(payload, f)
                except Exception:
                    pass

            self.grid_canvas.queue_draw()
            self.sim_canvas.queue_draw()
            self.pulse_canvas.queue_draw()

        def _open_in_hilbert_space(self, _btn):
            self._resimulate(update_qasm_editor=False)
            hs_bin = os.path.join(REPO_ROOT, "bin", "omniq-hilbert-space")
            if not os.path.exists(hs_bin):
                hs_bin = "/usr/local/bin/omniq-hilbert-space"
            if os.path.exists(hs_bin):
                subprocess.Popen([hs_bin, HILBERT_IPC_PATH], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.hint_lbl.set_text("Beamed live quantum statevector into OmniQ Hilbert Space Explorer!")

        def _execute_on_qpu(self, _btn):
            full_circ = self.grid_model.to_circuit()
            qasm_code = full_circ.to_qasm("3.0")
            try:
                with QPU() as qpu:
                    ilock = qpu.get_interlock()
                    if ilock["tripped"]:
                        self.qpu_last_report = (
                            "[BLOCKED] Cryogenic Thermal Safety Interlock is TRIPPED!\n"
                            f"Mixing Chamber: {ilock['temp_mxc_mK']:.3f} mK | RF DACs clamped to 0x00.\n"
                            "Reset interlock in OmniQ Cockpit or via 'omniq-ctl reset' after cooling < 50 mK."
                        )
                    else:
                        part = qpu.allocate_partition(num_qubits=full_circ.num_qubits, guard_hops=1)
                        try:
                            hw_job = part.submit(qasm_code, shots=1024)
                        finally:
                            part.free()
                        exact_counts = full_circ.sample(shots=1024, seed=2026)
                        top_sorted = sorted(exact_counts.items(), key=lambda kv: -kv[1])[:8]
                        hist_lines = "\n".join(f"  |{k}> : {v:4d} shots ({v/10.24:5.1f}%)" for k, v in top_sorted)
                        self.qpu_last_report = (
                            "=== Executed on /dev/accel/qpu0 (libomniq_qpu + QMMU Guard Shield) ===\n"
                            f"Partition ID     : #{part.partition_id}\n"
                            f"Allocated Qubits : {part.qubits}\n"
                            f"QMMU Guard Bands : {part.guard_qubits}\n"
                            f"Est. Fidelity    : {part.est_fidelity*100:.2f}%\n"
                            f"QPU Duration     : {hw_job.execution_time_ns} ns (1024 shots)\n\n"
                            f"Measurement Outcomes:\n{hist_lines}\n"
                        )
                self.qpu_view.get_buffer().set_text(self.qpu_last_report)
                self.notebook.set_current_page(3)
                self.hint_lbl.set_text("Executed 1,024 shots on /dev/accel/qpu0 with QMMU guard-band shielding!")
            except Exception as e:
                self.qpu_last_report = f"QPU execution error: {e}"
                self.qpu_view.get_buffer().set_text(self.qpu_last_report)
                self.notebook.set_current_page(3)

        def _dispatch_qick_rfsoc(self, _btn):
            full_circ = self.grid_model.to_circuit()
            try:
                from omniq.lab.rack_manager import LabRackManager
                import socket as _sock
                import time as _time

                mgr = LabRackManager()
                qhost = str(mgr.config.get("qick_rfsoc_host", "127.0.0.1"))
                qport = int(mgr.config.get("qick_rfsoc_port", 18888))
                if qhost in ("127.0.0.1", "localhost") and str(mgr.config.get("mode", "twin_loopback")) == "twin_loopback":
                    try:
                        with _sock.create_connection((qhost, qport), timeout=0.2):
                            pass
                    except Exception:
                        for tb in [os.path.join(REPO_ROOT, "bin", "omniq-lab-twin"), "/usr/local/bin/omniq-lab-twin"]:
                            if os.path.exists(tb) and os.access(tb, os.X_OK):
                                subprocess.Popen([tb, "--daemon"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                _time.sleep(0.35)
                                break

                res = mgr.dispatch_qick_circuit(full_circ, shots=1024)
                if not res.get("ok", True):
                    raise RuntimeError(f"{res.get('error', 'ERR_RF_BIAS_CLAMPED')}: {res.get('message', 'RF bias clamped')}")
                counts = res.get("counts", {})
                top_sorted = sorted(counts.items(), key=lambda kv: -kv[1])[:8]
                hist_lines = "\n".join(f"  |{k}> : {v:4d} shots ({v/10.24:5.1f}%)" for k, v in top_sorted)
                self.qpu_last_report = (
                    "=== Fermilab QICK ZCU216 RFSoC Execution (tProc v2 + 16-bit DRAG DAC) ===\n"
                    f"Transport        : {res.get('transport', 'jsonrpc://127.0.0.1:18888')}\n"
                    f"Fabric Clock     : {res.get('f_fabric_mhz', 430.08)} MHz ({res.get('total_cycles', 0)} ticks = {res.get('duration_ns', 0)} ns)\n"
                    f"Syndrome Loop    : {res.get('syndrome_feedback_ns', 418.5)} ns (< 500 ns FPGA condj)\n\n"
                    f"Demodulated RF-ADC Readout Counts (1024 shots):\n{hist_lines}\n"
                )
                self.qpu_view.get_buffer().set_text(self.qpu_last_report)
                self.notebook.set_current_page(3)
                self.hint_lbl.set_text("Dispatched tProc v2 assembly & 16-bit DRAG waveforms to Fermilab QICK RFSoC!")
            except Exception as e:
                self.qpu_last_report = f"[QICK RFSoC REJECTED / ERROR]\n{e}"
                self.qpu_view.get_buffer().set_text(self.qpu_last_report)
                self.notebook.set_current_page(3)
                self.hint_lbl.set_text(f"QICK RFSoC execution halted: {e}")

        # ---- Cairo Renderers ----
        def _draw_circuit_grid(self, widget, cr):
            alloc = widget.get_allocation()
            w, h = float(alloc.width), float(alloc.height)
            cr.set_source_rgb(0.06, 0.05, 0.12)
            cr.rectangle(0, 0, w, h)
            cr.fill()

            x0, y0, wire_step, col_step = self._grid_geometry(w, h)
            nq = self.grid_model.num_qubits
            ncols = self.grid_model.num_cols

            # Column indices & subtle slot guides
            cr.select_font_face("DejaVu Sans Mono", 0, 0)
            cr.set_font_size(9.5)
            for c in range(ncols):
                cx = x0 + (c + 0.5) * col_step
                cr.set_source_rgba(0.45, 0.52, 0.72, 0.45)
                cr.move_to(cx - 5, 18)
                cr.show_text(f"t{c}")
                cr.set_source_rgba(0.54, 0.31, 1.0, 0.10)
                cr.set_line_width(1.0)
                cr.move_to(cx, y0 - 12)
                cr.line_to(cx, y0 + (nq - 1) * wire_step + 12)
                cr.stroke()

            # Quantum wires |0>
            for q in range(nq):
                wy = y0 + q * wire_step
                cr.set_source_rgb(0.0, 0.90, 1.0)
                cr.set_font_size(11.5)
                cr.move_to(14, wy + 4)
                cr.show_text(f"q[{q}] |0>")

                cr.set_source_rgba(0.62, 0.72, 0.92, 0.55)
                cr.set_line_width(1.6)
                cr.move_to(x0 - 8, wy)
                cr.line_to(w - 18, wy)
                cr.stroke()

            # Highlight pending multi-qubit selection
            if self.pending_wires and self.pending_col is not None:
                px = x0 + (self.pending_col + 0.5) * col_step
                for pw in self.pending_wires:
                    py = y0 + pw * wire_step
                    cr.set_source_rgba(0.0, 1.0, 0.62, 0.85)
                    cr.arc(px, py, 9, 0, 2 * math.pi)
                    cr.stroke()

            # Draw placed gates
            for it in self.grid_model.items:
                cx = x0 + (it.col + 0.5) * col_step
                dimmed = 0.32 if it.col > self.scrub_col else 1.0
                rc, gc, bc = gate_color_rgb(it.gate)

                if len(it.qubits) >= 2:
                    ymin = y0 + min(it.qubits) * wire_step
                    ymax = y0 + max(it.qubits) * wire_step
                    cr.set_source_rgba(rc, gc, bc, 0.88 * dimmed)
                    cr.set_line_width(2.4)
                    cr.move_to(cx, ymin)
                    cr.line_to(cx, ymax)
                    cr.stroke()

                if it.gate in ("CNOT", "CY", "CZ", "CP", "CRZ"):
                    ctrl_y = y0 + it.qubits[0] * wire_step
                    targ_y = y0 + it.qubits[1] * wire_step
                    cr.set_source_rgba(rc, gc, bc, dimmed)
                    cr.arc(cx, ctrl_y, 5.5, 0, 2 * math.pi)
                    cr.fill()
                    if it.gate == "CNOT":
                        cr.set_line_width(2.0)
                        cr.arc(cx, targ_y, 12.0, 0, 2 * math.pi)
                        cr.stroke()
                        cr.move_to(cx - 12, targ_y)
                        cr.line_to(cx + 12, targ_y)
                        cr.move_to(cx, targ_y - 12)
                        cr.line_to(cx, targ_y + 12)
                        cr.stroke()
                    elif it.gate == "CZ":
                        cr.arc(cx, targ_y, 5.5, 0, 2 * math.pi)
                        cr.fill()
                    else:
                        self._draw_gate_box(cr, cx, targ_y, it.gate, it.angle, rc, gc, bc, dimmed)
                elif it.gate == "CCX":
                    for cw in it.qubits[:2]:
                        cr.set_source_rgba(rc, gc, bc, dimmed)
                        cr.arc(cx, y0 + cw * wire_step, 5.5, 0, 2 * math.pi)
                        cr.fill()
                    ty = y0 + it.qubits[2] * wire_step
                    cr.arc(cx, ty, 12.0, 0, 2 * math.pi)
                    cr.stroke()
                    cr.move_to(cx - 12, ty)
                    cr.line_to(cx + 12, ty)
                    cr.move_to(cx, ty - 12)
                    cr.line_to(cx, ty + 12)
                    cr.stroke()
                elif it.gate in ("SWAP", "ISWAP", "CSWAP"):
                    start_idx = 1 if it.gate == "CSWAP" else 0
                    if it.gate == "CSWAP":
                        cr.set_source_rgba(rc, gc, bc, dimmed)
                        cr.arc(cx, y0 + it.qubits[0] * wire_step, 5.5, 0, 2 * math.pi)
                        cr.fill()
                    for sw_q in it.qubits[start_idx:]:
                        sy = y0 + sw_q * wire_step
                        cr.set_source_rgba(rc, gc, bc, dimmed)
                        cr.set_line_width(2.2)
                        cr.move_to(cx - 7, sy - 7)
                        cr.line_to(cx + 7, sy + 7)
                        cr.move_to(cx - 7, sy + 7)
                        cr.line_to(cx + 7, sy - 7)
                        cr.stroke()
                else:
                    wy = y0 + it.qubits[0] * wire_step
                    self._draw_gate_box(cr, cx, wy, it.gate, it.angle, rc, gc, bc, dimmed)

            # Time-Slice Scrubber vertical cursor line
            if 0 <= self.scrub_col < ncols:
                sx = x0 + (self.scrub_col + 0.92) * col_step
                cr.set_source_rgba(0.0, 1.0, 0.62, 0.85)
                cr.set_line_width(2.0)
                cr.move_to(sx, 22)
                cr.line_to(sx, h - 10)
                cr.stroke()

            return False

        @staticmethod
        def _draw_gate_box(cr, cx: float, cy: float, gate: str, angle: float, r: float, g: float, b: float, alpha: float):
            bw, bh = 38.0, 28.0
            cr.set_source_rgba(0.10, 0.08, 0.20, 0.95 * alpha)
            cr.rectangle(cx - bw / 2, cy - bh / 2, bw, bh)
            cr.fill()
            cr.set_source_rgba(r, g, b, 0.95 * alpha)
            cr.set_line_width(1.6)
            cr.rectangle(cx - bw / 2, cy - bh / 2, bw, bh)
            cr.stroke()

            cr.set_source_rgba(0.95, 0.98, 1.0, alpha)
            cr.select_font_face("DejaVu Sans", 0, 1)
            label = "M" if gate == "MEASURE" else ("|0>" if gate == "RESET" else gate)
            cr.set_font_size(10.0 if len(label) <= 3 else 8.5)
            cr.move_to(cx - 4.0 * len(label), cy + (0 if gate in PARAM_GATES else 4))
            cr.show_text(label)
            if gate in PARAM_GATES:
                cr.set_font_size(7.5)
                cr.set_source_rgba(0.0, 0.90, 1.0, alpha)
                cr.move_to(cx - 15, cy + 10)
                cr.show_text(f"{angle:.2f}")

        def _draw_live_sim_panel(self, widget, cr):
            alloc = widget.get_allocation()
            w, h = float(alloc.width), float(alloc.height)
            cr.set_source_rgb(0.06, 0.05, 0.12)
            cr.rectangle(0, 0, w, h)
            cr.fill()

            sv = self.current_sv
            n = sv.num_qubits
            probs = sv.probabilities()
            ent = sv.entanglement_entropy() if n >= 2 else 0.0

            cr.set_source_rgb(0.0, 0.90, 1.0)
            cr.select_font_face("DejaVu Sans", 0, 1)
            cr.set_font_size(11.0)
            cr.move_to(12, 18)
            cr.show_text(f"LIVE STATEVECTOR PROBABILITIES & BLOCH VECTORS  |  Entanglement S(rho_A) = {ent:.3f} bits")

            # Left 56%: Measurement Probability Histogram
            hx, hy, hw, hh = 16.0, 32.0, w * 0.54, h - 52.0
            dim = min(len(probs), 32)
            bar_w = max(4.0, hw / max(1, dim))
            for idx in range(dim):
                p = float(probs[idx])
                bh = p * (hh - 14.0)
                cr.set_source_rgba(0.0, 0.90, 1.0, 0.88 if p > 0.01 else 0.22)
                cr.rectangle(hx + idx * bar_w, hy + hh - bh, max(2.0, bar_w - 2.0), bh)
                cr.fill()
                if dim <= 16 and bar_w >= 18:
                    cr.set_source_rgb(0.80, 0.88, 0.98)
                    cr.set_font_size(8.0)
                    cr.move_to(hx + idx * bar_w, hy + hh + 12)
                    cr.show_text(format(idx, f"0{n}b"))

            # Right 40%: Mini Bloch Spheres for first up to 4 qubits
            bx0 = w * 0.58
            bw_tot = w * 0.40
            show_q = min(n, 4)
            cols = 2 if show_q > 1 else 1
            rows = math.ceil(show_q / cols)
            cw = bw_tot / cols
            ch = (h - 32.0) / max(1, rows)

            for q in range(show_q):
                r_i, c_i = q // cols, q % cols
                cx = bx0 + (c_i + 0.5) * cw
                cy = 30.0 + (r_i + 0.48) * ch
                rad = min(cw, ch) * 0.33
                bx, by, bz, pur = sv.bloch_vector(q)

                cr.set_source_rgba(0.54, 0.31, 1.0, 0.40)
                cr.set_line_width(1.0)
                cr.arc(cx, cy, rad, 0, 2 * math.pi)
                cr.stroke()

                vx = cx + (bx * 0.85 - by * 0.35) * rad
                vy = cy - (bz * 0.88 - by * 0.22) * rad
                cr.set_source_rgb(0.0, 1.0, 0.62)
                cr.set_line_width(2.2)
                cr.move_to(cx, cy)
                cr.line_to(vx, vy)
                cr.stroke()
                cr.arc(vx, vy, 3.6, 0, 2 * math.pi)
                cr.fill()

                cr.set_source_rgb(0.88, 0.94, 1.0)
                cr.set_font_size(8.5)
                cr.move_to(cx - rad, cy + rad + 11)
                cr.show_text(f"q[{q}] z={bz:+.2f} P={pur:.2f}")
            return False

        def _draw_pulse_schedule(self, widget, cr):
            alloc = widget.get_allocation()
            w, h = float(alloc.width), float(alloc.height)
            cr.set_source_rgb(0.05, 0.04, 0.11)
            cr.rectangle(0, 0, w, h)
            cr.fill()

            cr.set_source_rgb(0.0, 0.90, 1.0)
            cr.select_font_face("DejaVu Sans Mono", 0, 1)
            cr.set_font_size(10.0)
            cr.move_to(10, 16)
            cr.show_text("RFSoC 5.0 GHz DRAG Gaussian & Cross-Resonance Pulse Schedule")

            nq = min(4, self.grid_model.num_qubits)
            lane_h = (h - 28.0) / max(1, nq)
            ncols = max(4, min(12, self.grid_model.num_cols))
            dx = (w - 64.0) / ncols

            for q in range(nq):
                ly = 26.0 + (q + 0.5) * lane_h
                cr.set_source_rgb(0.7, 0.8, 0.95)
                cr.move_to(8, ly + 4)
                cr.show_text(f"DAC{q}")
                cr.set_source_rgba(0.4, 0.5, 0.7, 0.3)
                cr.move_to(52, ly)
                cr.line_to(w - 10, ly)
                cr.stroke()

            for it in self.grid_model.items:
                if it.col >= ncols:
                    continue
                q0 = it.qubits[0]
                if q0 >= nq:
                    continue
                ly = 26.0 + (q0 + 0.5) * lane_h
                x_start = 54.0 + it.col * dx
                rc, gc, bc = gate_color_rgb(it.gate)
                cr.set_source_rgba(rc, gc, bc, 0.9)
                cr.set_line_width(1.6)
                for s in range(25):
                    u = s / 24.0
                    env = math.exp(-((u - 0.5) ** 2) / 0.045) * math.sin(u * 6.0 * math.pi)
                    px = x_start + u * (dx - 4.0)
                    py = ly - env * (lane_h * 0.36)
                    if s == 0:
                        cr.move_to(px, py)
                    else:
                        cr.line_to(px, py)
                cr.stroke()
            return False

    win = CircuitMakerWindow()
    win.show_all()
    Gtk.main()


def main():
    if "--test" in sys.argv:
        sys.exit(run_self_test())
    init_file = None
    for a in sys.argv[1:]:
        if not a.startswith("-"):
            init_file = a
            break
    launch_gui(init_file)


if __name__ == "__main__":
    main()
