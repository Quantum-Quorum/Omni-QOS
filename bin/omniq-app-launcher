class AppLauncherWindow(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("OmniQ Applications")
        self.set_wmclass("omniq-app-launcher", "Omniq-app-launcher")
        self.set_default_size(980, 680)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_modal(True)

        gtk_settings = Gtk.Settings.get_default()
        if gtk_settings:
            gtk_settings.set_property("gtk-theme-name", "Adwaita-dark")
            gtk_settings.set_property("gtk-application-prefer-dark-theme", True)

        icon_path = find_icon("apps_grid_48.png") or find_icon("omniq-logo_48.png")
        if icon_path:
            try:
                self.set_icon_from_file(icon_path)
            except Exception:
                pass

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER,
        )

        self.connect("key-press-event", self._on_key_press)

        self.recent_app_ids = self._load_recent_apps()
        self.current_category = "All"
        self.search_query = ""

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.get_style_context().add_class("launcher-frame")
        self.add(outer)

        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        logo_path = find_icon("omniq-logo_48.png") or find_icon("omniq-logo.png")
        if logo_path:
            hdr.pack_start(Gtk.Image.new_from_file(logo_path), False, False, 0)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_lbl = Gtk.Label(label="OmniQ Applications")
        title_lbl.set_xalign(0.0)
        title_lbl.get_style_context().add_class("header-title")
        title_box.pack_start(title_lbl, False, False, 0)

        sub_lbl = Gtk.Label(
            label="Real-Time Quantum Workstation  |  Application Catalog & Active Window Switcher"
        )
        sub_lbl.set_xalign(0.0)
        sub_lbl.get_style_context().add_class("header-sub")
        title_box.pack_start(sub_lbl, False, False, 0)
        hdr.pack_start(title_box, True, True, 0)

        close_btn = Gtk.Button(label="Close")
        close_btn.get_style_context().add_class("close-btn")
        close_btn.connect("clicked", lambda _b: self.close())
        hdr.pack_end(close_btn, False, False, 0)
        outer.pack_start(hdr, False, False, 0)

        self.search_entry = Gtk.Entry()
        self.search_entry.set_placeholder_text(
            "Filter Quantum apps, QEC, VQE, PQC, or system tools... (Type to filter, Enter to launch)"
        )
        sp_ic = find_icon("spotlight_16.png")
        if sp_ic:
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(sp_ic, 16, 16, True)
                self.search_entry.set_icon_from_pixbuf(Gtk.EntryIconPosition.PRIMARY, pix)
            except Exception:
                pass
        self.search_entry.get_style_context().add_class("search-box")
        self.search_entry.connect("changed", self._on_search_changed)
        self.search_entry.connect("activate", self._on_search_activated)
        outer.pack_start(self.search_entry, False, False, 0)

        self.recent_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        lbl_recent = Gtk.Label(label="RECENTLY USED APPLICATIONS")
        lbl_recent.set_xalign(0.0)
        lbl_recent.get_style_context().add_class("section-label")
        self.recent_box.pack_start(lbl_recent, False, False, 0)

        self.recent_flow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self._populate_recent_apps()
        self.recent_box.pack_start(self.recent_flow, False, False, 4)
        outer.pack_start(self.recent_box, False, False, 0)

        cat_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        cat_bar.set_margin_top(8)
        cat_bar.set_margin_bottom(8)

        categories = [
            "All",
            "Active Windows",
            "Quantum & QPU",
            "QEC & Algorithms",
            "Security & PQC",
            "Development & Files",
            "System & Hardware",
        ]
        self.cat_buttons = []
        for cat in categories:
            btn = Gtk.Button(label=cat)
            btn.get_style_context().add_class("category-tab")
            if cat == "All":
                btn.get_style_context().add_class("active-tab")
            btn.connect("clicked", self._on_category_tab_clicked, cat)
            cat_bar.pack_start(btn, False, False, 0)
            self.cat_buttons.append((cat, btn))
        outer.pack_start(cat_bar, False, False, 0)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_vexpand(True)

        self.grid_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.grid_container.set_margin_top(6)
        self.grid_container.set_margin_bottom(6)
        scroller.add(self.grid_container)
        outer.pack_start(scroller, True, True, 0)

        self._render_app_grid()

    def _load_recent_apps(self):
        default_recent = ["cockpit", "circuit_maker", "hilbert", "qec", "terminal"]
        if os.path.exists(RECENT_FILE):
            try:
                with open(RECENT_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if isinstance(data, list) and data:
                    return data
            except Exception:
                pass
        return default_recent

    def _save_recent_app(self, app_id):
        try:
            os.makedirs(os.path.dirname(RECENT_FILE), exist_ok=True)
            recents = [app_id] + [x for x in self.recent_app_ids if x != app_id]
            with open(RECENT_FILE, "w", encoding="utf-8") as f:
                json.dump(recents[:6], f)
        except Exception:
            pass

    def _populate_recent_apps(self):
        for ch in self.recent_flow.get_children():
            self.recent_flow.remove(ch)

        apps_map = {a["id"]: a for a in ALL_APPS}
        added = 0
        for app_id in self.recent_app_ids:
            if app_id in apps_map:
                app = apps_map[app_id]
                btn = Gtk.Button()
                btn.get_style_context().add_class("recent-card")
                btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

                ic_path = find_icon(app.get("icon_alt", "omniq-logo_24.png")) or find_icon(app["icon"])
                if ic_path:
                    btn_box.pack_start(Gtk.Image.new_from_file(ic_path), False, False, 0)

                lbl = Gtk.Label(label=app["name"])
                lbl.set_xalign(0.0)
                btn_box.pack_start(lbl, False, False, 0)

                btn.add(btn_box)
                btn.connect("clicked", lambda _b, a=app: self._launch_app(a))
                self.recent_flow.pack_start(btn, False, False, 0)
                added += 1
                if added >= 5:
                    break
        self.recent_flow.show_all()

    def _get_open_windows(self):
        windows = []
        wmctrl = find_wmctrl()
        if wmctrl:
            try:
                res = subprocess.run([wmctrl, "-l", "-p", "-x"], capture_output=True, text=True, timeout=1)
                if res.returncode == 0:
                    for line in res.stdout.splitlines():
                        parts = line.split(None, 4)
                        if len(parts) >= 5:
                            wid, pid, wclass, title = parts[0], parts[2], parts[3].split(".")[0], parts[4]
                            if any(x in wclass.lower() for x in ["desktop", "panel", "tray", "jwm", "backdrop"]):
                                continue
                            if "OmniQ Desktop Workspace" in title or "omniq-app-launcher" in wclass.lower():
                                continue
                            windows.append({"id": wid, "class": wclass, "title": title, "pid": pid})
            except Exception:
                pass
        return windows

    def _switch_to_window(self, wid):
        wmctrl = find_wmctrl()
        if wmctrl:
            try:
                subprocess.run([wmctrl, "-i", "-a", wid], timeout=1)
            except Exception:
                pass
        self.close()

    def _close_window(self, wid):
        wmctrl = find_wmctrl()
        if wmctrl:
            try:
                subprocess.run([wmctrl, "-i", "-c", wid], timeout=1)
            except Exception:
                pass
        GLib.timeout_add(150, self._render_app_grid)

    def _render_window_switcher(self):
        windows = self._get_open_windows()
        if not windows:
            no_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            no_box.set_margin_top(40)
            no_box.set_margin_bottom(40)
            lbl = Gtk.Label(label="No other active application windows are currently open.")
            lbl.set_xalign(0.5)
            lbl.get_style_context().add_class("header-sub")
            no_box.pack_start(lbl, False, False, 0)
            self.grid_container.pack_start(no_box, False, False, 0)
            self.grid_container.show_all()
            return

        grid = Gtk.Grid()
        grid.set_column_spacing(12)
        grid.set_row_spacing(10)
        grid.set_column_homogeneous(True)

        for idx, win in enumerate(windows):
            card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            card.get_style_context().add_class("window-card")

            btn_click = Gtk.Button()
            btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

            ic_name = win["class"].lower().replace("omniq-", "")
            ic_path = find_icon(f"{ic_name}_48.png") or find_icon("omniq-logo_48.png")
            if ic_path:
                btn_box.pack_start(Gtk.Image.new_from_file(ic_path), False, False, 0)

            text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            title_lbl = Gtk.Label(label=win["title"][:42])
            title_lbl.set_xalign(0.0)
            title_lbl.get_style_context().add_class("app-title")
            top_row.pack_start(title_lbl, True, True, 0)

            badge = Gtk.Label(label=f"WIN {win['id']}")
            badge.get_style_context().add_class("app-badge")
            top_row.pack_end(badge, False, False, 0)
            text_box.pack_start(top_row, False, False, 0)

            desc_lbl = Gtk.Label(label=f"Class: {win['class']}  |  PID: {win['pid']}")
            desc_lbl.set_xalign(0.0)
            desc_lbl.get_style_context().add_class("app-desc")
            text_box.pack_start(desc_lbl, False, False, 0)

            btn_box.pack_start(text_box, True, True, 0)
            btn_click.add(btn_box)
            btn_click.connect("clicked", lambda _b, wid=win["id"]: self._switch_to_window(wid))
            card.pack_start(btn_click, True, True, 0)

            close_btn = Gtk.Button(label="Close")
            close_btn.set_margin_start(4)
            close_btn.get_style_context().add_class("close-btn")
            close_btn.connect("clicked", lambda _b, wid=win["id"]: self._close_window(wid))
            card.pack_end(close_btn, False, False, 0)

            grid.attach(card, idx % 2, idx // 2, 1, 1)

        self.grid_container.pack_start(grid, False, False, 0)
        self.grid_container.show_all()

    def _render_app_grid(self):
        for ch in self.grid_container.get_children():
            self.grid_container.remove(ch)

        if self.current_category == "Active Windows":
            self._render_window_switcher()
            return

        query = self.search_query.lower().strip()
        filtered = []
        for a in ALL_APPS:
            if self.current_category != "All" and a["category"] != self.current_category:
                continue
            if query and not (
                query in a["name"].lower()
                or query in a["desc"].lower()
                or query in a["category"].lower()
                or query in a["id"].lower()
            ):
                continue
            filtered.append(a)

        if not filtered:
            no_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            no_box.set_margin_top(40)
            no_box.set_margin_bottom(40)
            lbl = Gtk.Label(label=f"No applications matched '{self.search_query}'")
            lbl.set_xalign(0.5)
            lbl.get_style_context().add_class("header-sub")
            no_box.pack_start(lbl, False, False, 0)
            self.grid_container.pack_start(no_box, False, False, 0)
            self.grid_container.show_all()
            return

        grid = Gtk.Grid()
        grid.set_column_spacing(12)
        grid.set_row_spacing(10)
        grid.set_column_homogeneous(True)

        for idx, app in enumerate(filtered):
            card = Gtk.Button()
            card.get_style_context().add_class("app-card")
            card_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

            ic_path = find_icon(app["icon"]) or find_icon(app.get("icon_alt", "omniq-logo_48.png"))
            if ic_path:
                card_box.pack_start(Gtk.Image.new_from_file(ic_path), False, False, 0)

            text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            title_lbl = Gtk.Label(label=app["name"])
            title_lbl.set_xalign(0.0)
            title_lbl.get_style_context().add_class("app-title")
            top_row.pack_start(title_lbl, True, True, 0)

            badge = Gtk.Label(label=app["category"])
            badge.get_style_context().add_class("app-badge")
            top_row.pack_end(badge, False, False, 0)
            text_box.pack_start(top_row, False, False, 0)

            desc_lbl = Gtk.Label(label=app["desc"])
            desc_lbl.set_xalign(0.0)
            desc_lbl.set_line_wrap(True)
            desc_lbl.get_style_context().add_class("app-desc")
            text_box.pack_start(desc_lbl, False, False, 0)

            card_box.pack_start(text_box, True, True, 0)
            card.add(card_box)
            card.connect("clicked", lambda _b, a=app: self._launch_app(a))
            grid.attach(card, idx % 2, idx // 2, 1, 1)

        self.grid_container.pack_start(grid, False, False, 0)
        self.grid_container.show_all()

    def _on_category_tab_clicked(self, _btn, cat):
        self.current_category = cat
        for c, b in self.cat_buttons:
            if c == cat:
                b.get_style_context().add_class("active-tab")
            else:
                b.get_style_context().remove_class("active-tab")
        self._render_app_grid()

    def _on_search_changed(self, entry):
        self.search_query = entry.get_text()
        self.recent_box.set_visible(not bool(self.search_query))
        self._render_app_grid()

    def _on_search_activated(self, _entry):
        query = self.search_query.lower().strip()
        if not query:
            return
        for a in ALL_APPS:
            if self.current_category != "All" and a["category"] != self.current_category:
                continue
            if query in a["name"].lower() or query in a["desc"].lower() or query in a["id"].lower():
                self._launch_app(a)
                return

    def _on_key_press(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def _launch_app(self, app):
        self._save_recent_app(app["id"])
        cmd_args = shlex.split(app["cmd"]) if isinstance(app["cmd"], str) else list(app["cmd"])
        if cmd_args:
            exe = cmd_args[0]
            base = os.path.basename(exe)
            repo_cand = os.path.join(os.path.dirname(os.path.abspath(__file__)), base)
            if not (os.path.isfile(exe) and os.access(exe, os.X_OK)):
                cmd_args[0] = shutil.which(base) or (repo_cand if os.path.isfile(repo_cand) else exe)
            try:
                subprocess.Popen(cmd_args, shell=False, start_new_session=True)
            except Exception as e:
                print(f"[!] Error launching {cmd_args}: {e}")
        GLib.timeout_add(120, self.close)

def main():
    GLib.set_prgname("omniq-app-launcher")
    if "--test" in sys.argv:
        assert len(ALL_APPS) >= 20
        assert find_icon("omniq-logo_48.png") is not None
        print("[+] omniq-app-launcher headless self-test passed.")
        return 0

    GLib.set_application_name("OmniQ Applications")
    win = AppLauncherWindow()
    if "--switcher" in sys.argv:
        win._on_category_tab_clicked(None, "Active Windows")
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0

if __name__ == "__main__":
    sys.exit(main())
