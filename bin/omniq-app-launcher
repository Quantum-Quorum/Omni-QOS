#!/usr/bin/env python3

import os
import sys
import json
import shlex
import shutil
import subprocess
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RECENT_FILE = os.path.expanduser("~/.cache/omniq/recent_apps.json")

ICON_SEARCH_PATHS = [
    "/usr/share/omniq/icons",
    "/etc/omniq/icons",
    os.path.join(REPO_ROOT, "etc/omniq/icons"),
    "/usr/share/pixmaps",
    "/usr/share/icons",
]

def find_icon(name):
    for p in ICON_SEARCH_PATHS:
        f = os.path.join(p, name)
        if os.path.exists(f):
            return f
    return None

def find_wmctrl():
    repo_wm = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wmctrl")
    for c in ["/usr/local/bin/wmctrl", "/usr/bin/wmctrl", "/bin/wmctrl", repo_wm]:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return shutil.which("wmctrl")

