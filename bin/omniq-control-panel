ICON_SEARCH_PATHS = [
    "/usr/share/omniq/icons",
    "/etc/omniq/icons",
    os.path.join(REPO_ROOT, "etc/omniq/icons"),
    "/usr/share/omniq/icons/16x16",
    "/etc/omniq/icons/16x16",
    os.path.join(REPO_ROOT, "etc/omniq/icons/16x16"),
]

def find_icon(name):
    for p in ICON_SEARCH_PATHS:
        f = os.path.join(p, name)
        if os.path.exists(f):
            return f
    return None

def find_bin(name):
    repo_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), name)
    for c in [f"/usr/local/bin/{name}", f"/usr/bin/{name}", f"/bin/{name}", repo_bin]:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return shutil.which(name) or name

def save_notification_state(state):
    state["updated_at"] = float(state.get("updated_at", time.time()))
    payload = json.dumps(state, indent=2)
    for path in NOTIF_STATE_PATHS:
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            tmp_path = f"{path}.tmp.{os.getpid()}"
            with open(tmp_path, "w", encoding="utf-8") as f:
                f.write(payload)
            os.replace(tmp_path, path)
        except Exception:
            pass
    return state

def load_notification_state():
    best_state = None
    best_ts = -1.0
    for path in NOTIF_STATE_PATHS:
        if os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if isinstance(data, dict) and "notifications" in data:
                    ts = float(data.get("updated_at", os.path.getmtime(path)))
                    if ts > best_ts:
                        best_ts = ts
                        best_state = data
            except Exception:
                pass
    if best_state is not None:
        return best_state

    initial = {
        "cleared": False,
        "updated_at": time.time(),
        "notifications": [dict(item) for item in DEFAULT_NOTIFICATIONS],
    }
    return save_notification_state(initial)

def clear_all_notifications():
    return save_notification_state({
        "cleared": True,
        "updated_at": time.time(),
        "notifications": [],
    })

def dismiss_notification(notif_id):
    state = load_notification_state()
    remaining = [n for n in state.get("notifications", []) if n.get("id") != notif_id]
    return save_notification_state({
        "cleared": len(remaining) == 0,
        "updated_at": time.time(),
        "notifications": remaining,
    })

def add_notification(title, body, badge="QUANTUM", critical=False, time_str="Just now"):
    state = load_notification_state()
    items = list(state.get("notifications", []))
    new_item = {
        "id": f"notif-{int(time.time() * 1000)}-{len(items)}",
        "title": str(title),
        "body": str(body),
        "time": str(time_str),
        "badge": str(badge),
        "critical": bool(critical),
    }
    items.insert(0, new_item)
    return save_notification_state({
        "cleared": False,
        "updated_at": time.time(),
        "notifications": items,
    })

def reset_default_notifications():
    return save_notification_state({
        "cleared": False,
        "updated_at": time.time(),
        "notifications": [dict(item) for item in DEFAULT_NOTIFICATIONS],
    })

class OmniqControlPanel(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("OmniQ Control Center")
        self.set_wmclass("omniq-control-panel", "Omniq-control-panel")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)

        screen = self.get_screen()
        sw = screen.get_width()
        sh = screen.get_height()
        panel_w = 320
        panel_h = min(610, max(480, sh - 60))
        panel_x = max(8, sw - panel_w - 12)
        panel_y = 32

        self.set_default_size(panel_w, panel_h)
        self.move(panel_x, panel_y)

        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            self.set_visual(visual)

        icon_path = find_icon("control_center_16.png") or find_icon("omniq-logo_16.png")
        if icon_path:
            try:
                self.set_icon_from_file(icon_path)
            except Exception:
                pass

        self._load_css()
        self.connect("key-press-event", self._on_key_press)

        self.wifi_active = True
        self.bluetooth_active = True
        self.nightlight_active = False
        self.dnd_active = False
        self.tricompute_active = True

        self._build_ui()

