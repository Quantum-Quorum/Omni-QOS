    def _build_ui(self):
        root_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        root_box.get_style_context().add_class("control-panel-root")
        self.add(root_box)

        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        logo_icon = find_icon("control_center_16.png") or find_icon("omniq-logo_16.png")
        if logo_icon:
            hdr.pack_start(Gtk.Image.new_from_file(logo_icon), False, False, 0)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        t_lbl = Gtk.Label(label="OmniQ Control Center")
        t_lbl.set_xalign(0.0)
        t_lbl.get_style_context().add_class("header-title")
        title_box.pack_start(t_lbl, False, False, 0)

        s_lbl = Gtk.Label(label="Quantum Tri-Compute & Cryostat HUD")
        s_lbl.set_xalign(0.0)
        s_lbl.get_style_context().add_class("header-sub")
        title_box.pack_start(s_lbl, False, False, 0)
        hdr.pack_start(title_box, True, True, 0)

        close_btn = Gtk.Button(label="X")
        close_btn.get_style_context().add_class("close-btn")
        close_btn.connect("clicked", lambda _b: self.close())
        hdr.pack_end(close_btn, False, False, 0)
        root_box.pack_start(hdr, False, False, 0)

        tile_grid = Gtk.Grid()
        tile_grid.set_column_spacing(6)
        tile_grid.set_row_spacing(6)
        tile_grid.set_column_homogeneous(True)

        self.wifi_btn = self._create_tile(
            "wifi_16.png", "Wi-Fi", "Connected", active=self.wifi_active, callback=self._toggle_wifi
        )
        tile_grid.attach(self.wifi_btn, 0, 0, 1, 1)

        self.bt_btn = self._create_tile(
            "bluetooth_16.png", "Bluetooth", "Active", active=self.bluetooth_active, callback=self._toggle_bluetooth
        )
        tile_grid.attach(self.bt_btn, 1, 0, 1, 1)

        self.nl_btn = self._create_tile(
            "nightlight_16.png", "Night Light", "Off", active=self.nightlight_active, callback=self._toggle_nightlight
        )
        tile_grid.attach(self.nl_btn, 0, 1, 1, 1)

        self.dnd_btn = self._create_tile(
            "notifications_16.png", "Do Not Disturb", "Normal", active=self.dnd_active, callback=self._toggle_dnd
        )
        tile_grid.attach(self.dnd_btn, 1, 1, 1, 1)

        self.synergy_btn = self._create_tile(
            "qpu_3d_16.png", "Tri-Compute Synergy", "CPU+GPU+QPU", active=self.tricompute_active, callback=self._toggle_synergy
        )
        tile_grid.attach(self.synergy_btn, 0, 2, 1, 1)

        self.lock_btn = self._create_tile(
            "lock_16.png", "Lock Session", "Secure Console", active=False, callback=self._trigger_lock
        )
        tile_grid.attach(self.lock_btn, 1, 2, 1, 1)
        root_box.pack_start(tile_grid, False, False, 0)

        sliders_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        sliders_box.get_style_context().add_class("slider-card")

        b_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        b_icon = find_icon("nightlight_16.png")
        if b_icon:
            b_row.pack_start(Gtk.Image.new_from_file(b_icon), False, False, 0)
        b_lbl = Gtk.Label(label="Display Brightness")
        b_lbl.set_xalign(0.0)
        b_lbl.get_style_context().add_class("slider-label")
        b_row.pack_start(b_lbl, True, True, 0)
        self.b_val_lbl = Gtk.Label(label="100%")
        self.b_val_lbl.get_style_context().add_class("slider-val")
        b_row.pack_end(self.b_val_lbl, False, False, 0)
        sliders_box.pack_start(b_row, False, False, 0)

        self.b_slider = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 20, 100, 5)
        self.b_slider.set_value(100)
        self.b_slider.set_draw_value(False)
        self.b_slider.connect("value-changed", self._on_brightness_changed)
        sliders_box.pack_start(self.b_slider, False, False, 0)

        v_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        v_icon = find_icon("audio_16.png")
        if v_icon:
            v_row.pack_start(Gtk.Image.new_from_file(v_icon), False, False, 0)
        v_lbl = Gtk.Label(label="Audio Volume")
        v_lbl.set_xalign(0.0)
        v_lbl.get_style_context().add_class("slider-label")
        v_row.pack_start(v_lbl, True, True, 0)
        self.v_val_lbl = Gtk.Label(label="80%")
        self.v_val_lbl.get_style_context().add_class("slider-val")
        v_row.pack_end(self.v_val_lbl, False, False, 0)
        sliders_box.pack_start(v_row, False, False, 0)

        self.v_slider = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
        self.v_slider.set_value(80)
        self.v_slider.set_draw_value(False)
        self.v_slider.connect("value-changed", self._on_volume_changed)
        sliders_box.pack_start(self.v_slider, False, False, 0)
        root_box.pack_start(sliders_box, False, False, 0)

        notif_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        n_lbl = Gtk.Label(label="QUANTUM & CRYO ALERT CENTER")
        n_lbl.set_xalign(0.0)
        n_lbl.get_style_context().add_class("header-sub")
        notif_header.pack_start(n_lbl, True, True, 0)

        self.clear_btn = Gtk.Button(label="Clear")
        self.clear_btn.get_style_context().add_class("clear-btn")
        self.clear_btn.connect("clicked", self._clear_notifications)
        notif_header.pack_end(self.clear_btn, False, False, 0)
        root_box.pack_start(notif_header, False, False, 0)

        notif_scroll = Gtk.ScrolledWindow()
        notif_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        notif_scroll.set_vexpand(True)

        self.notif_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        notif_scroll.add(self.notif_container)
        root_box.pack_start(notif_scroll, True, True, 0)

        self._last_notif_updated_at = 0.0
        self._populate_notifications()
        self._poll_timer_id = GLib.timeout_add(1000, self._poll_notification_state)
        self.connect("destroy", self._on_destroy_cleanup)

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        footer.pack_start(
            self._create_action_btn("settings_16.png", "Settings", lambda: self._launch_cmd(["omniq-settings"])),
            True, True, 0,
        )
        footer.pack_start(
            self._create_action_btn("tasks_16.png", "Tasks", lambda: self._launch_cmd(["omniq-tasks"])),
            True, True, 0,
        )
        footer.pack_start(
            self._create_action_btn("power_16.png", "Power", lambda: self._launch_cmd(["omniq-power"]), is_power=True),
            True, True, 0,
        )
        root_box.pack_start(footer, False, False, 0)

    def _on_destroy_cleanup(self, *_args):
        if getattr(self, "_poll_timer_id", None):
            try:
                GLib.source_remove(self._poll_timer_id)
            except Exception:
                pass
            self._poll_timer_id = None

    def _create_action_btn(self, icon_name, label_text, callback, is_power=False):
        btn = Gtk.Button()
        btn.get_style_context().add_class("footer-btn")
        if is_power:
            btn.get_style_context().add_class("power")

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.set_halign(Gtk.Align.CENTER)
        ic_path = find_icon(icon_name)
        if ic_path:
            box.pack_start(Gtk.Image.new_from_file(ic_path), False, False, 0)
        lbl = Gtk.Label(label=label_text)
        lbl.set_xalign(0.5)
        lbl.get_style_context().add_class("footer-btn-lbl")
        box.pack_start(lbl, False, False, 0)
        btn.add(box)
        btn.connect("clicked", lambda _b: callback())
        return btn

    def _create_tile(self, icon_name, title, subtitle, active=False, callback=None):
        btn = Gtk.Button()
        btn.get_style_context().add_class("tile-button")
        if active:
            btn.get_style_context().add_class("active")

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        box.set_margin_start(2)
        box.set_margin_end(2)
        ic_path = find_icon(icon_name)
        if ic_path:
            box.pack_start(Gtk.Image.new_from_file(ic_path), False, False, 0)

        t_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        t_lbl = Gtk.Label(label=title)
        t_lbl.set_xalign(0.0)
        t_lbl.get_style_context().add_class("tile-title")
        t_box.pack_start(t_lbl, False, False, 0)

        s_lbl = Gtk.Label(label=subtitle)
        s_lbl.set_xalign(0.0)
        s_lbl.get_style_context().add_class("tile-sub")
        t_box.pack_start(s_lbl, False, False, 0)

        box.pack_start(t_box, True, True, 0)
        btn.add(box)
        btn._sub_lbl = s_lbl
        if callback:
            btn.connect("clicked", lambda b: callback(b))
        return btn

    def _toggle_tile_state(self, btn, is_active, on_text, off_text):
        if is_active:
            btn.get_style_context().add_class("active")
            btn._sub_lbl.set_text(on_text)
        else:
            btn.get_style_context().remove_class("active")
            btn._sub_lbl.set_text(off_text)

    def _toggle_wifi(self, _btn):
        self.wifi_active = not self.wifi_active
        self._toggle_tile_state(self.wifi_btn, self.wifi_active, "Connected", "Disabled")
        if shutil.which("nmcli"):
            try:
                subprocess.Popen(
                    ["nmcli", "radio", "wifi", "on" if self.wifi_active else "off"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
            except Exception:
                pass

    def _toggle_bluetooth(self, _btn):
        self.bluetooth_active = not self.bluetooth_active
        self._toggle_tile_state(self.bt_btn, self.bluetooth_active, "Active", "Disabled")
        if shutil.which("rfkill"):
            try:
                subprocess.Popen(
                    ["rfkill", "unblock" if self.bluetooth_active else "block", "bluetooth"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
            except Exception:
                pass

    def _toggle_nightlight(self, _btn):
        self.nightlight_active = not self.nightlight_active
        self._toggle_tile_state(self.nl_btn, self.nightlight_active, "Warm 3700K", "Off")
        if shutil.which("redshift"):
            try:
                cmd = ["redshift", "-O", "3700K"] if self.nightlight_active else ["redshift", "-x"]
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass

    def _toggle_dnd(self, _btn):
        self.dnd_active = not self.dnd_active
        self._toggle_tile_state(self.dnd_btn, self.dnd_active, "Silence Non-Cryo", "Normal")

    def _toggle_synergy(self, _btn):
        self.tricompute_active = not self.tricompute_active
        self._toggle_tile_state(self.synergy_btn, self.tricompute_active, "CPU+GPU+QPU", "Classical Eco")

    def _trigger_lock(self, _btn):
        self.close()
        try:
            subprocess.Popen([find_bin("omniq-screensaver"), "--lock"], start_new_session=True)
        except Exception:
            pass

    def _on_brightness_changed(self, scale):
        val = int(scale.get_value())
        self.b_val_lbl.set_text(f"{val}%")
        if shutil.which("xrandr"):
            try:
                subprocess.Popen(
                    ["xrandr", "--output", "default", "--brightness", f"{val / 100.0:.2f}"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
            except Exception:
                pass

    def _on_volume_changed(self, scale):
        val = int(scale.get_value())
        self.v_val_lbl.set_text(f"{val}%")
        if shutil.which("amixer"):
            try:
                subprocess.Popen(
                    ["amixer", "sset", "Master", f"{val}%"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
            except Exception:
                pass

    def _populate_notifications(self):
        for ch in list(self.notif_container.get_children()):
            self.notif_container.remove(ch)
            ch.destroy()

        state = load_notification_state()
        self._last_notif_updated_at = float(state.get("updated_at", 0.0))
        alerts = state.get("notifications", [])

        if not alerts:
            empty_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            empty_box.get_style_context().add_class("notif-card")
            empty_lbl = Gtk.Label(label="No active quantum or cryostat alerts")
            empty_lbl.set_xalign(0.5)
            empty_lbl.get_style_context().add_class("notif-empty-lbl")
            empty_box.pack_start(empty_lbl, True, True, 0)
            self.notif_container.pack_start(empty_box, False, False, 0)
            self.notif_container.show_all()
            return

        for idx, a in enumerate(alerts):
            notif_id = a.get("id", f"notif-{idx}")
            is_crit = bool(a.get("critical") or a.get("fda"))
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            card.get_style_context().add_class("notif-card")
            if is_crit:
                card.get_style_context().add_class("critical-alert")

            h_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            badge_lbl = Gtk.Label(label=f"[{a.get('badge', 'INFO')}]")
            badge_lbl.set_xalign(0.0)
            badge_lbl.get_style_context().add_class("notif-badge-mint" if is_crit else "notif-badge-violet")
            h_box.pack_start(badge_lbl, False, False, 0)

            t_lbl = Gtk.Label(label=a.get("title", "System Alert"))
            t_lbl.set_xalign(0.0)
            t_lbl.get_style_context().add_class("notif-title")
            h_box.pack_start(t_lbl, True, True, 0)

            dismiss_btn = Gtk.Button(label="x")
            dismiss_btn.get_style_context().add_class("notif-dismiss-btn")
            dismiss_btn.connect("clicked", lambda _b, nid=notif_id: self._dismiss_single_notification(nid))
            h_box.pack_end(dismiss_btn, False, False, 0)

            time_lbl = Gtk.Label(label=a.get("time", "Just now"))
            time_lbl.set_xalign(1.0)
            time_lbl.get_style_context().add_class("notif-time")
            h_box.pack_end(time_lbl, False, False, 0)
            card.pack_start(h_box, False, False, 0)

            b_lbl = Gtk.Label(label=a.get("body", ""))
            b_lbl.set_xalign(0.0)
            b_lbl.set_line_wrap(True)
            b_lbl.get_style_context().add_class("notif-body")
            card.pack_start(b_lbl, False, False, 0)

            self.notif_container.pack_start(card, False, False, 0)

        self.notif_container.show_all()

    def _dismiss_single_notification(self, notif_id):
        dismiss_notification(notif_id)
        self._populate_notifications()

    def _clear_notifications(self, _btn=None):
        clear_all_notifications()
        self._populate_notifications()

    def _poll_notification_state(self):
        state = load_notification_state()
        ts = float(state.get("updated_at", 0.0))
        if abs(ts - self._last_notif_updated_at) > 1e-6:
            self._populate_notifications()
        return True

    def _launch_cmd(self, cmd):
        self.close()
        if cmd:
            resolved = [find_bin(cmd[0])] + list(cmd[1:])
            try:
                subprocess.Popen(resolved, start_new_session=True)
            except Exception:
                pass

    def _on_key_press(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

def _enforce_single_instance():
    my_pid = os.getpid()
    if os.path.isfile(PID_FILE_PATH):
        try:
            with open(PID_FILE_PATH, "r", encoding="utf-8") as f:
                old_pid = int(f.read().strip())
            if old_pid != my_pid and os.path.exists(f"/proc/{old_pid}/cmdline"):
                with open(f"/proc/{old_pid}/cmdline", "rb") as cf:
                    cmd = cf.read().decode("utf-8", "ignore")
                if "omniq-control-panel" in cmd:
                    os.kill(old_pid, signal.SIGTERM)
        except Exception:
            pass
    try:
        with open(PID_FILE_PATH, "w", encoding="utf-8") as f:
            f.write(str(my_pid))
    except Exception:
        pass

def main():
    GLib.set_prgname("omniq-control-panel")
    if "--test" in sys.argv:
        state = reset_default_notifications()
        assert len(state["notifications"]) >= 4
        assert find_icon("control_center_16.png") is not None
        print("[+] omniq-control-panel headless self-test passed.")
        return 0
    if "--clear" in sys.argv or "--clear-notifications" in sys.argv:
        print(json.dumps(clear_all_notifications()))
        return 0
    if "--reset-notifications" in sys.argv:
        print(json.dumps(reset_default_notifications()))
        return 0
    if "--list-notifications" in sys.argv or "--json" in sys.argv:
        print(json.dumps(load_notification_state()))
        return 0
    if "--add-notification" in sys.argv:
        idx = sys.argv.index("--add-notification")
        title = sys.argv[idx + 1] if len(sys.argv) > idx + 1 else "Quantum Alert"
        body = sys.argv[idx + 2] if len(sys.argv) > idx + 2 else "Cryostat & QPU telemetry update."
        print(json.dumps(add_notification(title, body)))
        return 0

    _enforce_single_instance()
    GLib.set_application_name("OmniQ Control Center")
    win = OmniqControlPanel()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0

if __name__ == "__main__":
    sys.exit(main())
