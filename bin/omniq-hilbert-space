def launch_gui(initial_path: Optional[str] = None) -> None:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    GLib.set_prgname("omniq-hilbert-space")

    provider = Gtk.CssProvider()
    provider.load_from_data(DARK_CSS)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    class HilbertSpaceWindow(Gtk.Window):
        def __init__(self):
            super().__init__(title="OmniQ Hilbert Space Explorer — H = (C^2)^{tensor n}")
            self.set_default_size(1280, 780)
            self.set_wmclass("omniq-hilbert-space", "omniq-hilbert-space")

            self.n_qubits = 3
            self.preset_name = "ghz"
            self.base_state, self.source_qasm = build_preset_state(self.preset_name, self.n_qubits)
            self.current_state: Statevector = self.base_state
            self.current_dm: DensityMatrix = self.base_state.to_density_matrix()

            self.view_mode = "quad"  # "quad", "qsphere", "bloch", "argand", "density"
            self.yaw = 0.58
            self.pitch = 0.34
            self.auto_orbit = True
            self.dragging = False
            self.last_mouse = (0.0, 0.0)

            self.evo_time = 0.0
            self.evo_playing = False
            self.depol_p = 0.0
            self.damp_gamma = 0.0
            self.cached_ham: Optional[np.ndarray] = None
            self.cached_ham_nq = -1
            self.last_ipc_mtime = 0.0

            self._build_ui()
            if initial_path and os.path.exists(initial_path):
                self._load_external_file(initial_path)

            self._recompute_quantum_state()
            self.anim_timer = GLib.timeout_add(33, self._on_tick)
            self.ipc_timer = GLib.timeout_add(450, self._poll_ipc_file)
            self.connect("destroy", self._on_destroy)

        def _on_destroy(self, *_args):
            if getattr(self, "anim_timer", 0):
                GLib.source_remove(self.anim_timer)
                self.anim_timer = 0
            if getattr(self, "ipc_timer", 0):
                GLib.source_remove(self.ipc_timer)
                self.ipc_timer = 0
            Gtk.main_quit()

        def _build_ui(self):
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            root.get_style_context().add_class("main-bg")
            self.add(root)

            # Top Header Toolbar
            hbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            hbar.get_style_context().add_class("header-bar")
            hbar.set_margin_start(12)
            hbar.set_margin_end(12)
            hbar.set_margin_top(8)
            hbar.set_margin_bottom(8)

            title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            t_lbl = Gtk.Label(label="OMNIQ HILBERT SPACE EXPLORER")
            t_lbl.get_style_context().add_class("title-lbl")
            t_lbl.set_xalign(0.0)
            s_lbl = Gtk.Label(label="Complex Statevector Geometry, Partial-Trace Bloch Vectors & Entanglement Spectrum")
            s_lbl.get_style_context().add_class("sub-lbl")
            s_lbl.set_xalign(0.0)
            title_box.pack_start(t_lbl, False, False, 0)
            title_box.pack_start(s_lbl, False, False, 0)
            hbar.pack_start(title_box, False, False, 4)

            # View mode buttons
            self.mode_buttons: Dict[str, Gtk.Button] = {}
            modes = [
                ("quad", "Quad Observatory"),
                ("qsphere", "3D Q-Sphere"),
                ("bloch", "Bloch Array"),
                ("argand", "Argand & Kets"),
                ("density", "Density Matrix rho"),
            ]
            mode_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            for key, label in modes:
                btn = Gtk.Button(label=label)
                if key == self.view_mode:
                    btn.get_style_context().add_class("active-tab")
                btn.connect("clicked", self._on_mode_clicked, key)
                self.mode_buttons[key] = btn
                mode_box.pack_start(btn, False, False, 0)
            hbar.pack_end(mode_box, False, False, 0)

            cm_btn = Gtk.Button(label="Open Circuit Maker")
            cm_btn.get_style_context().add_class("accent-btn")
            cm_btn.connect("clicked", self._launch_circuit_maker)
            hbar.pack_end(cm_btn, False, False, 6)

            root.pack_start(hbar, False, False, 0)

            # Main Content: Left Controls + Center Cairo Observatory + Right Telemetry
            body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            body.set_margin_start(10)
            body.set_margin_end(10)
            body.set_margin_top(8)
            body.set_margin_bottom(10)
            root.pack_start(body, True, True, 0)

            # Left Sidebar: State Preparation & Dynamics
            left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            left.set_size_request(255, -1)
            left.get_style_context().add_class("panel-card")
            left_in = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            left_in.set_margin_start(10)
            left_in.set_margin_end(10)
            left_in.set_margin_top(10)
            left_in.set_margin_bottom(10)
            left.pack_start(left_in, True, True, 0)

            sec1 = Gtk.Label(label="HILBERT REGISTER (n QUBITS)")
            sec1.get_style_context().add_class("title-lbl")
            sec1.set_xalign(0.0)
            left_in.pack_start(sec1, False, False, 0)

            q_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            ql = Gtk.Label(label="Qubits (n):")
            ql.set_xalign(0.0)
            self.q_spin = Gtk.SpinButton.new_with_range(1, 6, 1)
            self.q_spin.set_value(self.n_qubits)
            self.q_spin.connect("value-changed", self._on_qubits_changed)
            q_row.pack_start(ql, True, True, 0)
            q_row.pack_end(self.q_spin, False, False, 0)
            left_in.pack_start(q_row, False, False, 0)

            pl = Gtk.Label(label="Quantum State Preset:")
            pl.set_xalign(0.0)
            left_in.pack_start(pl, False, False, 2)

            self.preset_combo = Gtk.ComboBoxText()
            presets = [
                ("ghz", "GHZ Cat State (|0..0>+|1..1>)"),
                ("bell_phi_plus", "Bell Pair |Phi+>"),
                ("singlet_psi_minus", "Spin Singlet |Psi->"),
                ("w_state", "W Entangled State"),
                ("qft_spiral", "QFT Phase Spiral"),
                ("cluster_graph", "1D Cluster Graph State"),
                ("plus_uniform", "Uniform |+...+>"),
                ("haar_random", "Haar Scrambled Chaotic"),
            ]
            for pid, pname in presets:
                self.preset_combo.append(pid, pname)
            self.preset_combo.set_active_id(self.preset_name)
            self.preset_combo.connect("changed", self._on_preset_changed)
            left_in.pack_start(self.preset_combo, False, False, 0)

            left_in.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 4)

            sec2 = Gtk.Label(label="UNITARY EVOLUTION e^(-iHt)")
            sec2.get_style_context().add_class("title-lbl")
            sec2.set_xalign(0.0)
            left_in.pack_start(sec2, False, False, 0)

            tl = Gtk.Label(label="Ising Time Parameter t (rad):")
            tl.set_xalign(0.0)
            left_in.pack_start(tl, False, False, 0)
            self.time_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.0, 6.283, 0.02)
            self.time_scale.set_value(0.0)
            self.time_scale.connect("value-changed", self._on_dynamics_changed)
            left_in.pack_start(self.time_scale, False, False, 0)

            evo_btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            self.play_btn = Gtk.Button(label="Animate H(t)")
            self.play_btn.connect("clicked", self._toggle_play)
            rst_btn = Gtk.Button(label="Reset t=0")
            rst_btn.connect("clicked", self._reset_dynamics)
            evo_btns.pack_start(self.play_btn, True, True, 0)
            evo_btns.pack_start(rst_btn, True, True, 0)
            left_in.pack_start(evo_btns, False, False, 0)

            left_in.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 4)

            sec3 = Gtk.Label(label="OPEN-SYSTEM DECOHERENCE")
            sec3.get_style_context().add_class("title-lbl")
            sec3.set_xalign(0.0)
            left_in.pack_start(sec3, False, False, 0)

            dl1 = Gtk.Label(label="Depolarizing Channel (p):")
            dl1.set_xalign(0.0)
            left_in.pack_start(dl1, False, False, 0)
            self.depol_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.0, 0.80, 0.01)
            self.depol_scale.set_value(0.0)
            self.depol_scale.connect("value-changed", self._on_dynamics_changed)
            left_in.pack_start(self.depol_scale, False, False, 0)

            dl2 = Gtk.Label(label="T1 Amplitude Damping (gamma):")
            dl2.set_xalign(0.0)
            left_in.pack_start(dl2, False, False, 0)
            self.damp_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.0, 0.80, 0.01)
            self.damp_scale.set_value(0.0)
            self.damp_scale.connect("value-changed", self._on_dynamics_changed)
            left_in.pack_start(self.damp_scale, False, False, 0)

            self.orbit_chk = Gtk.CheckButton(label="Auto-Orbit 3D Q-Sphere")
            self.orbit_chk.set_active(True)
            self.orbit_chk.connect("toggled", lambda w: setattr(self, "auto_orbit", w.get_active()))
            left_in.pack_start(self.orbit_chk, False, False, 4)

            self.ipc_status_lbl = Gtk.Label(label="IPC Link: Listening (/tmp/omniq_hilbert_state.json)")
            self.ipc_status_lbl.get_style_context().add_class("sub-lbl")
            self.ipc_status_lbl.set_line_wrap(True)
            self.ipc_status_lbl.set_xalign(0.0)
            left_in.pack_end(self.ipc_status_lbl, False, False, 0)

            body.pack_start(left, False, False, 0)

            # Center: Interactive Cairo Canvas
            canvas_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            canvas_card.get_style_context().add_class("panel-card")
            self.canvas = Gtk.DrawingArea()
            self.canvas.add_events(
                Gdk.EventMask.BUTTON_PRESS_MASK
                | Gdk.EventMask.BUTTON_RELEASE_MASK
                | Gdk.EventMask.POINTER_MOTION_MASK
            )
            self.canvas.connect("draw", self._on_draw)
            self.canvas.connect("button-press-event", self._on_mouse_down)
            self.canvas.connect("button-release-event", self._on_mouse_up)
            self.canvas.connect("motion-notify-event", self._on_mouse_move)
            canvas_card.pack_start(self.canvas, True, True, 0)
            body.pack_start(canvas_card, True, True, 0)

            # Right Sidebar: Quantum Invariants & Basis Ket Readout
            right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            right.set_size_request(275, -1)
            right.get_style_context().add_class("panel-card")
            right_in = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            right_in.set_margin_start(10)
            right_in.set_margin_end(10)
            right_in.set_margin_top(10)
            right_in.set_margin_bottom(10)
            right.pack_start(right_in, True, True, 0)

            r_hdr = Gtk.Label(label="HILBERT INVARIANTS")
            r_hdr.get_style_context().add_class("title-lbl")
            r_hdr.set_xalign(0.0)
            right_in.pack_start(r_hdr, False, False, 0)

            self.metric_labels: Dict[str, Gtk.Label] = {}
            metrics_spec = [
                ("dim", "Hilbert Dimension d = 2^n:"),
                ("purity", "State Purity Tr(rho^2):"),
                ("vn_entropy", "Mixed Entropy S(rho) [bits]:"),
                ("ent_entropy", "Bipartite Entanglement S(rho_A):"),
                ("schmidt_rank", "Schmidt Rank (# > 1e-4):"),
                ("max_ket", "Dominant Basis Ket:"),
            ]
            for key, title in metrics_spec:
                lbl_t = Gtk.Label(label=title)
                lbl_t.get_style_context().add_class("sub-lbl")
                lbl_t.set_xalign(0.0)
                lbl_v = Gtk.Label(label="--")
                lbl_v.get_style_context().add_class("metric-val")
                lbl_v.set_xalign(0.0)
                self.metric_labels[key] = lbl_v
                right_in.pack_start(lbl_t, False, False, 0)
                right_in.pack_start(lbl_v, False, False, 2)

            right_in.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 4)

            k_hdr = Gtk.Label(label="TOP AMPLITUDE KETS |x>")
            k_hdr.get_style_context().add_class("title-lbl")
            k_hdr.set_xalign(0.0)
            right_in.pack_start(k_hdr, False, False, 0)

            sw = Gtk.ScrolledWindow()
            sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            self.ket_text = Gtk.TextView()
            self.ket_text.set_editable(False)
            self.ket_text.set_monospace(True)
            self.ket_text.override_background_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.06, 0.05, 0.12, 1.0))
            self.ket_text.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.86, 0.94, 1.0, 1.0))
            sw.add(self.ket_text)
            right_in.pack_start(sw, True, True, 0)

            body.pack_start(right, False, False, 0)

        def _on_mode_clicked(self, _btn, mode_key: str):
            self.view_mode = mode_key
            for k, b in self.mode_buttons.items():
                ctx = b.get_style_context()
                if k == mode_key:
                    ctx.add_class("active-tab")
                else:
                    ctx.remove_class("active-tab")
            self.canvas.queue_draw()

        def _on_qubits_changed(self, spin):
            self.n_qubits = int(spin.get_value())
            self.base_state, self.source_qasm = build_preset_state(self.preset_name, self.n_qubits)
            self._recompute_quantum_state()

        def _on_preset_changed(self, combo):
            pid = combo.get_active_id()
            if pid:
                self.preset_name = pid
                self.base_state, self.source_qasm = build_preset_state(self.preset_name, self.n_qubits)
                self._recompute_quantum_state()

        def _on_dynamics_changed(self, _scale):
            self.evo_time = float(self.time_scale.get_value())
            self.depol_p = float(self.depol_scale.get_value())
            self.damp_gamma = float(self.damp_scale.get_value())
            self._recompute_quantum_state()

        def _toggle_play(self, _btn):
            self.evo_playing = not self.evo_playing
            self.play_btn.set_label("Pause H(t)" if self.evo_playing else "Animate H(t)")

        def _reset_dynamics(self, _btn):
            self.evo_playing = False
            self.play_btn.set_label("Animate H(t)")
            self.time_scale.set_value(0.0)
            self.depol_scale.set_value(0.0)
            self.damp_scale.set_value(0.0)
            self._recompute_quantum_state()

        def _launch_circuit_maker(self, _btn):
            cm_bin = os.path.join(REPO_ROOT, "bin", "omniq-circuit-maker")
            if not os.path.exists(cm_bin):
                cm_bin = "/usr/local/bin/omniq-circuit-maker"
            if os.path.exists(cm_bin):
                subprocess.Popen([cm_bin], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        def _load_external_file(self, path: str):
            try:
                with open(path, "r") as f:
                    content = f.read()
                if path.endswith(".json") or content.lstrip().startswith("{"):
                    data = json.loads(content)
                    if "amplitudes_re" in data and "amplitudes_im" in data:
                        amps = np.array(data["amplitudes_re"]) + 1j * np.array(data["amplitudes_im"])
                        self.base_state = Statevector(amps, normalize=True)
                        self.n_qubits = self.base_state.num_qubits
                    elif "qasm" in data:
                        circ = Circuit.from_qasm(data["qasm"])
                        if circ.num_qubits <= 6:
                            self.base_state = circ.execute()  # type: ignore
                            self.n_qubits = self.base_state.num_qubits
                    label = data.get("source", os.path.basename(path))
                    self.ipc_status_lbl.set_text(f"Synced from: {label}")
                else:
                    circ = Circuit.from_qasm(content)
                    if circ.num_qubits > 6:
                        circ.num_qubits = 6
                    self.base_state = circ.execute()  # type: ignore
                    self.n_qubits = self.base_state.num_qubits
                    self.ipc_status_lbl.set_text(f"Loaded QASM: {os.path.basename(path)}")
                self.q_spin.handler_block_by_func(self._on_qubits_changed)
                self.q_spin.set_value(self.n_qubits)
                self.q_spin.handler_unblock_by_func(self._on_qubits_changed)
                self._recompute_quantum_state()
            except Exception:
                pass

        def _poll_ipc_file(self) -> bool:
            if os.path.exists(IPC_STATE_PATH):
                try:
                    mt = os.path.getmtime(IPC_STATE_PATH)
                    if mt > self.last_ipc_mtime:
                        self.last_ipc_mtime = mt
                        self._load_external_file(IPC_STATE_PATH)
                except Exception:
                    pass
            return True

        def _recompute_quantum_state(self):
            psi = self.base_state.data.copy()
            n = self.base_state.num_qubits
            if self.evo_time > 1e-5 and n >= 2:
                if self.cached_ham is None or self.cached_ham_nq != n:
                    self.cached_ham = chaotic_ising_hamiltonian(n)
                    self.cached_ham_nq = n
                u_mat = expm(-1j * self.cached_ham * self.evo_time)
                psi = u_mat @ psi

            self.current_state = Statevector(psi, normalize=True)
            rho = np.outer(self.current_state.data, np.conj(self.current_state.data))
            dim = rho.shape[0]
            if self.depol_p > 1e-5:
                rho = (1.0 - self.depol_p) * rho + (self.depol_p / dim) * np.eye(dim, dtype=np.complex128)
            if self.damp_gamma > 1e-5:
                p0 = np.zeros_like(rho)
                p0[0, 0] = 1.0
                rho = (1.0 - self.damp_gamma) * rho + self.damp_gamma * p0
            self.current_dm = DensityMatrix(rho)
            self._update_metrics_sidebar()
            self.canvas.queue_draw()

        def _update_metrics_sidebar(self):
            n = self.current_state.num_qubits
            dim = 1 << n
            purity = self.current_dm.purity()
            vn_s = self.current_dm.von_neumann_entropy()
            if n >= 2:
                rho_a = self.current_dm.partial_trace_keep(list(range(n // 2)))
                ent_s = rho_a.von_neumann_entropy()
                schmidt = self.current_state.schmidt_coefficients()
                s_rank = int(np.sum(schmidt > 1e-4))
            else:
                ent_s = 0.0
                s_rank = 1

            probs = self.current_dm.probabilities()
            top_idx = int(np.argmax(probs))
            top_ket = f"|{format(top_idx, f'0{n}b')}> ({probs[top_idx]*100:.1f}%)"

            self.metric_labels["dim"].set_text(f"{dim} complex states ({n} qubits)")
            self.metric_labels["purity"].set_text(f"{purity:.4f}  ({'PURE' if purity > 0.999 else 'MIXED'})")
            self.metric_labels["vn_entropy"].set_text(f"{vn_s:.4f} bits")
            self.metric_labels["ent_entropy"].set_text(f"{ent_s:.4f} bits")
            self.metric_labels["schmidt_rank"].set_text(f"{s_rank}")
            self.metric_labels["max_ket"].set_text(top_ket)

            order = np.argsort(-probs)
            lines = ["KET        PROB     PHASE(pi)"]
            lines.append("-" * 29)
            phases = self.current_state.phases()
            for idx in order[:16]:
                if probs[idx] < 1e-5:
                    continue
                bstr = format(int(idx), f"0{n}b")
                ph_pi = phases[idx] / math.pi
                lines.append(f"|{bstr}>  {probs[idx]*100:6.2f}%   {ph_pi:+6.2f}pi")
            self.ket_text.get_buffer().set_text("\n".join(lines))

        def _on_tick(self) -> bool:
            redraw = False
            if self.auto_orbit and not self.dragging:
                self.yaw = (self.yaw + 0.012) % (2.0 * math.pi)
                redraw = True
            if self.evo_playing:
                nxt = (self.evo_time + 0.03) % 6.283
                self.time_scale.set_value(nxt)
                redraw = True
            if redraw:
                self.canvas.queue_draw()
            return True

        def _on_mouse_down(self, _w, ev):
            self.dragging = True
            self.last_mouse = (ev.x, ev.y)

        def _on_mouse_up(self, _w, _ev):
            self.dragging = False

        def _on_mouse_move(self, _w, ev):
            if self.dragging:
                dx = ev.x - self.last_mouse[0]
                dy = ev.y - self.last_mouse[1]
                self.yaw += dx * 0.01
                self.pitch = max(-1.35, min(1.35, self.pitch + dy * 0.01))
                self.last_mouse = (ev.x, ev.y)
                self.canvas.queue_draw()

        def _project_3d(self, x: float, y: float, z: float, cx: float, cy: float, radius: float) -> Tuple[float, float, float]:
            # Rotate yaw around Z, then pitch around X
            cyaw, syaw = math.cos(self.yaw), math.sin(self.yaw)
            x1 = x * cyaw - y * syaw
            y1 = x * syaw + y * cyaw
            cp, sp = math.cos(self.pitch), math.sin(self.pitch)
            y2 = y1 * cp - z * sp
            z2 = y1 * sp + z * cp
            persp = 3.2 / (3.2 - y2 * 0.55)
            sx = cx + x1 * radius * persp * 0.31
            sy = cy - z2 * radius * persp * 0.31
            return sx, sy, y2

        def _draw_panel_box(self, cr, x: float, y: float, w: float, h: float, title: str):
            cr.set_source_rgba(0.07, 0.06, 0.14, 0.96)
            cr.rectangle(x, y, w, h)
            cr.fill()
            cr.set_source_rgba(0.54, 0.31, 1.0, 0.32)
            cr.set_line_width(1.0)
            cr.rectangle(x + 0.5, y + 0.5, w - 1, h - 1)
            cr.stroke()
            cr.set_source_rgb(0.0, 0.90, 1.0)
            cr.select_font_face("DejaVu Sans", 0, 1)
            cr.set_font_size(11.5)
            cr.move_to(x + 10, y + 18)
            cr.show_text(title)

        def _draw_qsphere(self, cr, x: float, y: float, w: float, h: float):
            n = self.current_state.num_qubits
            self._draw_panel_box(cr, x, y, w, h, f"3D HILBERT Q-SPHERE (n={n}, Hamming Latitude + HSV Phase)")
            cx = x + w * 0.48
            cy = y + h * 0.54
            rad = min(w, h) * 0.38

            # Outer sphere halo
            cr.set_source_rgba(0.0, 0.90, 1.0, 0.14)
            cr.set_line_width(1.2)
            cr.arc(cx, cy, rad, 0, 2 * math.pi)
            cr.stroke()

            # Latitude rings for each Hamming weight
            for hw in range(n + 1):
                z_lat = math.cos((math.pi * hw) / max(1, n))
                r_lat = math.sin((math.pi * hw) / max(1, n))
                cr.set_source_rgba(0.54, 0.31, 1.0, 0.22)
                cr.set_line_width(0.9)
                for seg in range(49):
                    ang = (2 * math.pi * seg) / 48.0
                    px, py, _ = self._project_3d(r_lat * math.cos(ang), r_lat * math.sin(ang), z_lat, cx, cy, rad)
                    if seg == 0:
                        cr.move_to(px, py)
                    else:
                        cr.line_to(px, py)
                cr.stroke()

            qcoords = compute_qsphere_coordinates(n)
            probs = self.current_dm.probabilities()
            phases = self.current_state.phases()

            projected = []
            for idx, bstr, qx, qy, qz in qcoords:
                sx, sy, depth = self._project_3d(qx, qy, qz, cx, cy, rad)
                projected.append((depth, idx, bstr, sx, sy))
            projected.sort(key=lambda item: item[0])

            # Draw vectors & ket orbs
            for _depth, idx, bstr, sx, sy in projected:
                pr = float(probs[idx])
                ph = float(phases[idx])
                r_col, g_col, b_col = phase_to_rgb(ph)
                if pr > 0.004:
                    cr.set_source_rgba(r_col, g_col, b_col, min(0.9, 0.25 + pr * 1.4))
                    cr.set_line_width(1.2 + 3.0 * math.sqrt(pr))
                    cr.move_to(cx, cy)
                    cr.line_to(sx, sy)
                    cr.stroke()

                orb_r = 2.5 + 13.0 * math.sqrt(pr)
                cr.set_source_rgba(r_col, g_col, b_col, 0.92 if pr > 0.005 else 0.22)
                cr.arc(sx, sy, orb_r, 0, 2 * math.pi)
                cr.fill()

                if pr > 0.04 or len(qcoords) <= 8:
                    cr.set_source_rgba(0.93, 0.96, 1.0, 0.90)
                    cr.set_font_size(9.5)
                    cr.move_to(sx + orb_r + 3, sy + 3)
                    cr.show_text(f"|{bstr}>")

            # HSV Phase Wheel legend in bottom-right corner
            wx, wy, wr = x + w - 42, y + h - 42, 24
            for deg in range(0, 360, 6):
                a1 = math.radians(deg)
                a2 = math.radians(deg + 7)
                rc, gc, bc = phase_to_rgb(a1 - math.pi)
                cr.set_source_rgb(rc, gc, bc)
                cr.move_to(wx, wy)
                cr.arc(wx, wy, wr, a1, a2)
                cr.close_path()
                cr.fill()
            cr.set_source_rgb(0.06, 0.05, 0.12)
            cr.arc(wx, wy, wr * 0.52, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgb(0.85, 0.92, 1.0)
            cr.set_font_size(8.5)
            cr.move_to(wx - 14, wy + 3)
            cr.show_text("arg")

        def _draw_bloch_array(self, cr, x: float, y: float, w: float, h: float):
            n = self.current_state.num_qubits
            self._draw_panel_box(cr, x, y, w, h, "REDUCED SINGLE-QUBIT BLOCH SPHERES (Partial Trace rho_k)")
            cols = min(3, n)
            rows = math.ceil(n / cols)
            pad_top = 28.0
            cw = w / cols
            ch = (h - pad_top) / max(1, rows)

            for q in range(n):
                r_idx = q // cols
                c_idx = q % cols
                bx, by, bz, pur = self.current_dm.bloch_vector(q)
                scx = x + (c_idx + 0.5) * cw
                scy = y + pad_top + (r_idx + 0.48) * ch
                srad = min(cw, ch) * 0.33

                # Wireframe sphere + equator
                cr.set_source_rgba(0.54, 0.31, 1.0, 0.35)
                cr.set_line_width(1.0)
                cr.arc(scx, scy, srad, 0, 2 * math.pi)
                cr.stroke()
                cr.save()
                cr.translate(scx, scy)
                cr.scale(1.0, 0.34)
                cr.arc(0, 0, srad, 0, 2 * math.pi)
                cr.restore()
                cr.stroke()

                # Z axis |0> / |1>
                cr.set_source_rgba(0.6, 0.7, 0.85, 0.3)
                cr.move_to(scx, scy - srad)
                cr.line_to(scx, scy + srad)
                cr.stroke()

                # Project Bloch vector (bx, by, bz)
                vx, vy, _ = self._project_3d(bx, by, bz, scx, scy, srad)
                cr.set_source_rgb(0.0, 1.0, 0.62)
                cr.set_line_width(2.4)
                cr.move_to(scx, scy)
                cr.line_to(vx, vy)
                cr.stroke()
                cr.arc(vx, vy, 4.2, 0, 2 * math.pi)
                cr.fill()

                cr.set_source_rgb(0.92, 0.96, 1.0)
                cr.set_font_size(9.5)
                cr.move_to(scx - srad, scy + srad + 13)
                cr.show_text(f"q[{q}] ({bx:+.2f},{by:+.2f},{bz:+.2f}) P={pur:.2f}")

        def _draw_argand_and_kets(self, cr, x: float, y: float, w: float, h: float):
            self._draw_panel_box(cr, x, y, w, h, "COMPLEX ARGAND PHASOR DISK & BASIS SPECTRUM")
            n = self.current_state.num_qubits
            amps = self.current_state.data
            probs = self.current_dm.probabilities()
            phases = self.current_state.phases()

            # Left 42%: Argand unit circle
            acx = x + w * 0.22
            acy = y + h * 0.55
            arad = min(w * 0.36, h * 0.72) * 0.48
            cr.set_source_rgba(0.0, 0.90, 1.0, 0.25)
            cr.set_line_width(1.0)
            cr.arc(acx, acy, arad, 0, 2 * math.pi)
            cr.stroke()
            cr.move_to(acx - arad - 6, acy)
            cr.line_to(acx + arad + 6, acy)
            cr.move_to(acx, acy - arad - 6)
            cr.line_to(acx, acy + arad + 6)
            cr.stroke()

            for idx, amp in enumerate(amps):
                mag = abs(amp)
                if mag < 0.02:
                    continue
                rc, gc, bc = phase_to_rgb(float(phases[idx]))
                px = acx + float(amp.real) * arad
                py = acy - float(amp.imag) * arad
                cr.set_source_rgba(rc, gc, bc, 0.9)
                cr.set_line_width(1.8)
                cr.move_to(acx, acy)
                cr.line_to(px, py)
                cr.stroke()
                cr.arc(px, py, 3.5, 0, 2 * math.pi)
                cr.fill()

            # Right 55%: Probability bars colored by phase
            bx0 = x + w * 0.44
            bw = w * 0.52
            by0 = y + 34
            bh = h - 52
            dim = len(probs)
            bar_w = max(2.0, bw / max(1, dim))
            p_max = max(0.25, float(np.max(probs)))
            for idx in range(dim):
                pr = float(probs[idx])
                rc, gc, bc = phase_to_rgb(float(phases[idx]))
                bar_h = (pr / p_max) * (bh - 14)
                cr.set_source_rgba(rc, gc, bc, 0.92 if pr > 0.005 else 0.18)
                cr.rectangle(bx0 + idx * bar_w, by0 + bh - bar_h, max(1.2, bar_w - 1.5), bar_h)
                cr.fill()
                if dim <= 16 and bar_w >= 14:
                    cr.set_source_rgb(0.75, 0.82, 0.95)
                    cr.set_font_size(8.0)
                    cr.move_to(bx0 + idx * bar_w, by0 + bh + 11)
                    cr.show_text(format(idx, f"0{n}b"))

        def _draw_density_matrix(self, cr, x: float, y: float, w: float, h: float):
            self._draw_panel_box(cr, x, y, w, h, "DENSITY MATRIX Re(rho) / Im(rho) & SCHMIDT SPECTRUM")
            rho = self.current_dm.matrix
            dim = rho.shape[0]
            show_d = min(dim, 16)
            pad_y = y + 32
            avail_h = h - 44
            mat_size = min(w * 0.34, avail_h * 0.86)
            cell = mat_size / show_d

            for m_idx, (part, title) in enumerate([(np.real(rho), "Re(rho)"), (np.imag(rho), "Im(rho)")]):
                mx0 = x + 14 + m_idx * (mat_size + 18)
                my0 = pad_y + 12
                cr.set_source_rgb(0.75, 0.85, 1.0)
                cr.set_font_size(9.5)
                cr.move_to(mx0, pad_y + 6)
                cr.show_text(title)
                vmax = max(0.15, float(np.max(np.abs(part[:show_d, :show_d]))))
                for r in range(show_d):
                    for c in range(show_d):
                        val = float(part[r, c]) / vmax
                        if val >= 0:
                            cr.set_source_rgba(0.0, 0.90, 1.0, min(1.0, 0.08 + abs(val) * 0.92))
                        else:
                            cr.set_source_rgba(1.0, 0.20, 0.45, min(1.0, 0.08 + abs(val) * 0.92))
                        cr.rectangle(mx0 + c * cell, my0 + r * cell, max(1.0, cell - 0.6), max(1.0, cell - 0.6))
                        cr.fill()

            # Right column: Schmidt singular values bar chart
            sx0 = x + 2 * (mat_size + 18) + 18
            sw = max(40.0, (x + w) - sx0 - 12)
            if sw > 50:
                cr.set_source_rgb(0.0, 1.0, 0.62)
                cr.set_font_size(9.5)
                cr.move_to(sx0, pad_y + 6)
                cr.show_text("Schmidt Singular Values")
                schmidt = self.current_state.schmidt_coefficients()
                for k, sv_val in enumerate(schmidt[:8]):
                    by = pad_y + 20 + k * 20
                    if by + 14 > y + h:
                        break
                    cr.set_source_rgba(0.54, 0.31, 1.0, 0.85)
                    cr.rectangle(sx0, by, sw * float(sv_val), 12)
                    cr.fill()
                    cr.set_source_rgb(0.92, 0.96, 1.0)
                    cr.set_font_size(9.0)
                    cr.move_to(sx0 + 4, by + 10)
                    cr.show_text(f"lambda_{k} = {sv_val:.3f}")

        def _on_draw(self, widget, cr):
            alloc = widget.get_allocation()
            w, h = float(alloc.width), float(alloc.height)
            cr.set_source_rgb(0.05, 0.04, 0.10)
            cr.rectangle(0, 0, w, h)
            cr.fill()

            pad = 8.0
            if self.view_mode == "quad":
                hw = (w - 3 * pad) / 2.0
                hh = (h - 3 * pad) / 2.0
                self._draw_qsphere(cr, pad, pad, hw, hh)
                self._draw_bloch_array(cr, 2 * pad + hw, pad, hw, hh)
                self._draw_argand_and_kets(cr, pad, 2 * pad + hh, hw, hh)
                self._draw_density_matrix(cr, 2 * pad + hw, 2 * pad + hh, hw, hh)
            elif self.view_mode == "qsphere":
                self._draw_qsphere(cr, pad, pad, w - 2 * pad, h - 2 * pad)
            elif self.view_mode == "bloch":
                self._draw_bloch_array(cr, pad, pad, w - 2 * pad, h - 2 * pad)
            elif self.view_mode == "argand":
                self._draw_argand_and_kets(cr, pad, pad, w - 2 * pad, h - 2 * pad)
            elif self.view_mode == "density":
                self._draw_density_matrix(cr, pad, pad, w - 2 * pad, h - 2 * pad)
            return False

    win = HilbertSpaceWindow()
    win.show_all()
    Gtk.main()


def main():
    if "--test" in sys.argv:
        sys.exit(run_self_test())
    init_file = None
    for a in sys.argv[1:]:
        if not a.startswith("-"):
            init_file = a
            break
    launch_gui(init_file)


if __name__ == "__main__":
    main()
