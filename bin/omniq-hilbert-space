"""
OmniQ-OS: Interactive Hilbert Space Explorer (bin/omniq-hilbert-space)
Visualizes multi-qubit quantum states |psi> in H = (C^2)^{tensor n} and mixed
density matrices rho across:
  1. 3D Interactive Q-Sphere / Bloch Hypersphere (Hamming latitude + HSV phase)
  2. Reduced Single-Qubit 3D Bloch Sphere Array (partial trace rho_k)
  3. Complex Argand Phasor Disk & Computational Basis Spectrum
  4. Density Matrix Re(rho) / Im(rho) Coherence Heatmap & Schmidt Decomposition
Plus live Ising Hamiltonian unitary evolution U(t) = exp(-i H t), open-system
decoherence sliders, and live IPC sync (/tmp/omniq_hilbert_state.json) with
the OmniQ Quantum Circuit Maker.
"""

from __future__ import annotations

import colorsys
import json
import math
import os
import subprocess
import sys
from typing import Dict, List, Optional, Tuple

import numpy as np
from scipy.linalg import expm

REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
for p in [
    os.path.join(REPO_ROOT, "runtime", "python"),
    os.path.join(REPO_ROOT, "src"),
    "/opt/omniq/src",
    "/usr/lib/python3/dist-packages",
]:
    if os.path.isdir(p) and p not in sys.path:
        sys.path.insert(0, p)

from omniq.circuit import Circuit, DensityMatrix, Statevector
from omniq.chaos import chaotic_ising_hamiltonian, haar_random_state

IPC_STATE_PATH = "/tmp/omniq_hilbert_state.json"


def phase_to_rgb(phase_rad: float) -> Tuple[float, float, float]:
    """Maps complex phase [-pi, pi] to vibrant HSV color wheel."""
    hue = ((phase_rad + math.pi) / (2.0 * math.pi)) % 1.0
    return colorsys.hsv_to_rgb(hue, 0.88, 1.0)


def build_preset_state(preset: str, n_qubits: int) -> Tuple[Statevector, str]:
    n = max(1, min(6, int(n_qubits)))
    dim = 1 << n
    p = preset.lower()

    if p == "bell_phi_plus":
        c = Circuit(n).h(0)
        if n >= 2:
            c.cx(0, 1)
        return c.execute(), c.to_qasm("3.0")  # type: ignore

    if p == "singlet_psi_minus":
        c = Circuit(n)
        if n >= 2:
            c.x(0).x(1).h(0).cx(0, 1)
        else:
            c.x(0).h(0)
        return c.execute(), c.to_qasm("3.0")  # type: ignore

    if p == "ghz":
        c = Circuit(n).h(0)
        for k in range(1, n):
            c.cx(0, k)
        return c.execute(), c.to_qasm("3.0")  # type: ignore

    if p == "w_state":
        amps = np.zeros(dim, dtype=np.complex128)
        for k in range(n):
            amps[1 << k] = 1.0 / math.sqrt(n)
        return Statevector(amps), f"// {n}-Qubit W Entangled State\nOPENQASM 3.0;\nqubit[{n}] q;\n"

    if p == "plus_uniform":
        c = Circuit(n)
        for k in range(n):
            c.h(k)
        return c.execute(), c.to_qasm("3.0")  # type: ignore

    if p == "qft_spiral":
        amps = np.array(
            [np.exp(2j * math.pi * k * 1 / dim) / math.sqrt(dim) for k in range(dim)],
            dtype=np.complex128,
        )
        return Statevector(amps), f"// {n}-Qubit QFT|1> Phase Spiral\nOPENQASM 3.0;\nqubit[{n}] q;\n"

    if p == "cluster_graph":
        c = Circuit(n)
        for k in range(n):
            c.h(k)
        for k in range(n - 1):
            c.cz(k, k + 1)
        return c.execute(), c.to_qasm("3.0")  # type: ignore

    if p == "haar_random":
        return haar_random_state(n, seed=137 + n), f"// {n}-Qubit Haar Scrambled State\n"

    return Statevector.zero_state(n), f"OPENQASM 3.0;\nqubit[{n}] q;\n"


def compute_qsphere_coordinates(n_qubits: int) -> List[Tuple[int, str, float, float, float]]:
    """
    Computes 3D unit-sphere coordinates (x, y, z) for each basis ket |b> in {0,1}^n
    grouped on Hamming-weight latitude rings.
    """
    dim = 1 << n_qubits
    buckets: Dict[int, List[int]] = {w: [] for w in range(n_qubits + 1)}
    for idx in range(dim):
        hw = bin(idx).count("1")
        buckets[hw].append(idx)

    coords: List[Tuple[int, str, float, float, float]] = []
    for hw, indices in buckets.items():
        # North pole (hw=0) -> theta=0 (z=+1), South pole (hw=n) -> theta=pi (z=-1)
        theta = (math.pi * hw) / max(1, n_qubits)
        z = math.cos(theta)
        r_xy = math.sin(theta)
        m = len(indices)
        for pos, idx in enumerate(indices):
            phi = (2.0 * math.pi * pos) / max(1, m)
            x = r_xy * math.cos(phi)
            y = r_xy * math.sin(phi)
            bstr = format(idx, f"0{n_qubits}b")
            coords.append((idx, bstr, x, y, z))
    coords.sort(key=lambda t: t[0])
    return coords


def run_self_test() -> int:
    for preset in ["bell_phi_plus", "singlet_psi_minus", "ghz", "w_state", "qft_spiral", "cluster_graph", "haar_random"]:
        sv, _ = build_preset_state(preset, 3)
        assert sv.num_qubits == 3
        assert abs(np.sum(sv.probabilities()) - 1.0) < 1e-9
    ghz, _ = build_preset_state("ghz", 4)
    assert abs(ghz.entanglement_entropy() - 1.0) < 1e-6
    qcoords = compute_qsphere_coordinates(4)
    assert len(qcoords) == 16
    assert abs(qcoords[0][4] - 1.0) < 1e-9 and abs(qcoords[-1][4] + 1.0) < 1e-9
    print("[PASS] omniq-hilbert-space math, Q-Sphere coordinates, partial trace & Schmidt spectrum verified.")
    return 0


