def format_size(num_bytes: int) -> str:
    if num_bytes < 1024:
        return f"{num_bytes} B"
    val = float(num_bytes)
    for unit in ["KB", "MB", "GB", "TB"]:
        val /= 1024.0
        if val < 1024.0:
            return f"{val:.1f} {unit}"
    return f"{val:.1f} PB"


def phase_to_rgb(phase_rad: float) -> Tuple[float, float, float]:
    hue = ((phase_rad + math.pi) / (2.0 * math.pi)) % 1.0
    return colorsys.hsv_to_rgb(hue, 0.85, 1.0)


def get_trash_dir() -> str:
    xdg_data = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
    candidate = os.path.join(xdg_data, "Trash", "files")
    try:
        os.makedirs(candidate, exist_ok=True)
        return candidate
    except Exception:
        fallback = "/tmp/omniq_trash"
        os.makedirs(fallback, exist_ok=True)
        return fallback


def get_bookmarks() -> List[Tuple[str, str]]:
    circuits_dir = os.path.join(REPO_ROOT, "circuits")
    if not os.path.isdir(circuits_dir) and os.path.isdir("/opt/omniq/circuits"):
        circuits_dir = "/opt/omniq/circuits"
    opt_dir = "/opt/omniq" if os.path.isdir("/opt/omniq") else REPO_ROOT
    return [
        ("Home", os.path.expanduser("~")),
        ("File System", "/"),
        ("Quantum Circuits", circuits_dir),
        ("Opt OmniQ", opt_dir),
        ("Trash", get_trash_dir()),
    ]


class FileCRUDManager:
    """Testable filesystem CRUD & Trash operations for OmniQ Files."""

    def __init__(self, trash_dir: Optional[str] = None):
        self.trash_dir = trash_dir or get_trash_dir()
        os.makedirs(self.trash_dir, exist_ok=True)

    def create_folder(self, parent_dir: str, name: str) -> str:
        clean = name.strip()
        if not clean or "/" in clean:
            raise ValueError("Invalid folder name")
        dst = os.path.join(parent_dir, clean)
        os.makedirs(dst, exist_ok=False)
        return dst

    def create_qasm_file(self, parent_dir: str, name: str) -> str:
        clean = name.strip()
        if not clean:
            raise ValueError("Invalid file name")
        if not clean.endswith(".qasm"):
            clean += ".qasm"
        dst = os.path.join(parent_dir, clean)
        template = (
            "// OmniQ-OS OpenQASM 3.0 Circuit\n"
            "OPENQASM 3.0;\n"
            'include "stdgates.inc";\n\n'
            "qubit[2] q;\n"
            "bit[2] c;\n\n"
            "h q[0];\n"
            "cx q[0], q[1];\n"
            "c[0] = measure q[0];\n"
            "c[1] = measure q[1];\n"
        )
        with open(dst, "w", encoding="utf-8") as f:
            f.write(template)
        return dst

    def rename_item(self, src_path: str, new_name: str) -> str:
        clean = new_name.strip()
        if not clean or "/" in clean:
            raise ValueError("Invalid target name")
        dst = os.path.join(os.path.dirname(src_path), clean)
        os.rename(src_path, dst)
        return dst

    def move_to_trash(self, src_path: str) -> str:
        os.makedirs(self.trash_dir, exist_ok=True)
        base = os.path.basename(src_path.rstrip("/"))
        dst = os.path.join(self.trash_dir, base)
        if os.path.exists(dst):
            stamp = datetime.datetime.now().strftime("%H%M%S_%f")
            dst = os.path.join(self.trash_dir, f"{base}_{stamp}")
        shutil.move(src_path, dst)
        return dst

    def empty_trash(self) -> int:
        if not os.path.isdir(self.trash_dir):
            return 0
        removed = 0
        for entry in os.listdir(self.trash_dir):
            full = os.path.join(self.trash_dir, entry)
            if os.path.isdir(full) and not os.path.islink(full):
                shutil.rmtree(full)
            else:
                os.unlink(full)
            removed += 1
        return removed


def parse_quantum_file(filepath: str) -> Optional[Dict[str, Any]]:
    """
    Parses a .qasm or .json quantum file using Circuit.from_qasm and returns
    circuit + simulated Statevector metrics for live previewing.
    """
    if not os.path.isfile(filepath):
        return None
    low = filepath.lower()
    if not (low.endswith(".qasm") or low.endswith(".json")):
        return None

    try:
        with open(filepath, "r", encoding="utf-8", errors="replace") as f:
            raw = f.read(262144)
    except Exception:
        return None

    circ: Optional[Circuit] = None
    sv: Optional[Statevector] = None
    qasm_text = ""
    title = os.path.basename(filepath)

    try:
        if low.endswith(".qasm"):
            qasm_text = raw
            circ = Circuit.from_qasm(raw)
            if circ.num_qubits <= 10:
                res = circ.execute()
                if isinstance(res, Statevector):
                    sv = res
        else:
            data = json.loads(raw)
            if not isinstance(data, dict):
                return None
            title = str(data.get("name") or data.get("schema") or title)
            if isinstance(data.get("qasm"), str) and data["qasm"].strip():
                qasm_text = data["qasm"]
                circ = Circuit.from_qasm(qasm_text)
            elif isinstance(data.get("gates"), list) and "num_qubits" in data:
                circ = Circuit(int(data["num_qubits"]))
                for g in data["gates"]:
                    gt = str(g.get("type", "H")).upper()
                    q0 = int(g.get("qubit", 0))
                    if "control2" in g and "target" in g:
                        circ.add_gate(gt, [q0, int(g["control2"]), int(g["target"])])
                    elif "target" in g:
                        circ.add_gate(gt, [q0, int(g["target"])], angle=g.get("parameter"))
                    else:
                        circ.add_gate(gt, [q0], angle=g.get("parameter"))
                qasm_text = circ.to_qasm("3.0")

            if "amplitudes_re" in data and "amplitudes_im" in data:
                amps = np.asarray(data["amplitudes_re"], dtype=float) + 1j * np.asarray(data["amplitudes_im"], dtype=float)
                if amps.size > 0 and (amps.size & (amps.size - 1)) == 0:
                    sv = Statevector(amps, normalize=True)
            if sv is None and circ is not None and circ.num_qubits <= 10:
                res = circ.execute()
                if isinstance(res, Statevector):
                    sv = res
    except Exception:
        return None

    if circ is None and sv is None:
        return None

    if circ is None and sv is not None:
        circ = Circuit(sv.num_qubits)
        qasm_text = circ.to_qasm("3.0")

    assert circ is not None
    if sv is None:
        sv = Statevector.zero_state(min(circ.num_qubits, 6))

    probs = sv.probabilities()
    phases = sv.phases()
    ent = sv.entanglement_entropy() if sv.num_qubits >= 2 else 0.0
    top_idx = int(np.argmax(probs))
    top_ket = format(top_idx, f"0{sv.num_qubits}b")

    return {
        "title": title,
        "filepath": filepath,
        "circuit": circ,
        "statevector": sv,
        "qasm": qasm_text or circ.to_qasm("3.0"),
        "num_qubits": circ.num_qubits,
        "gate_count": len(circ.gates),
        "entanglement_bits": ent,
        "dominant_ket": f"|{top_ket}> ({probs[top_idx] * 100.0:.1f}%)",
        "probabilities": probs,
        "phases": phases,
    }


def draw_quantum_preview(cr, width: float, height: float, info: Optional[Dict[str, Any]]) -> None:
    """Draws antialiased Cairo mini circuit wire diagram + statevector probability bars."""
    cr.set_source_rgb(0.05, 0.04, 0.10)
    cr.rectangle(0, 0, width, height)
    cr.fill()

    if info is None:
        cr.set_source_rgb(0.58, 0.64, 0.72)
        cr.set_font_size(11.5)
        cr.move_to(18, height * 0.48)
        cr.show_text("Select any .qasm or .json quantum circuit")
        cr.move_to(18, height * 0.48 + 18)
        cr.show_text("to render live wire topology & Hilbert spectrum.")
        return

    circ: Circuit = info["circuit"]
    probs: np.ndarray = info["probabilities"]
    phases: np.ndarray = info["phases"]
    nq = circ.num_qubits

    # Top Section (52%): Mini Circuit Wire Preview
    wire_top = 26.0
    wire_h = max(70.0, height * 0.48 - 28.0)
    cr.set_source_rgb(0.0, 0.90, 1.0)
    cr.set_font_size(10.5)
    cr.move_to(10, 16)
    cr.show_text(f"CIRCUIT WIRE TOPOLOGY ({nq} Qubits, {len(circ.gates)} Gates)")

    disp_nq = min(nq, 6)
    spacing = wire_h / max(1, disp_nq)
    x_start = 44.0
    x_end = width - 14.0

    for q in range(disp_nq):
        wy = wire_top + (q + 0.5) * spacing
        cr.set_source_rgb(0.70, 0.76, 0.90)
        cr.set_font_size(9.5)
        cr.move_to(8, wy + 3.5)
        cr.show_text(f"q[{q}]")
        cr.set_source_rgba(0.54, 0.31, 1.0, 0.45)
        cr.set_line_width(1.2)
        cr.move_to(x_start, wy)
        cr.line_to(x_end, wy)
        cr.stroke()

    visible_gates = [g for g in circ.gates if g[0] != "BARRIER"][:14]
    if visible_gates:
        step_w = (x_end - x_start - 16.0) / max(1, len(visible_gates))
        for idx, g in enumerate(visible_gates):
            gt = g[0].upper()
            gx = x_start + 12.0 + idx * step_w
            q0 = int(g[1])
            if q0 >= disp_nq:
                continue
            y0 = wire_top + (q0 + 0.5) * spacing

            if gt in ("CNOT", "CX", "CZ", "CY", "CP", "CRZ", "SWAP", "ISWAP") and len(g) >= 3:
                q1 = int(g[2])
                if q1 < disp_nq:
                    y1 = wire_top + (q1 + 0.5) * spacing
                    cr.set_source_rgb(0.0, 0.90, 1.0)
                    cr.set_line_width(1.6)
                    cr.move_to(gx, y0)
                    cr.line_to(gx, y1)
                    cr.stroke()
                    cr.arc(gx, y0, 3.5, 0, 2 * math.pi)
                    cr.fill()
                    cr.arc(gx, y1, 6.0, 0, 2 * math.pi)
                    cr.stroke()
                    if gt in ("CNOT", "CX"):
                        cr.move_to(gx - 4, y1)
                        cr.line_to(gx + 4, y1)
                        cr.move_to(gx, y1 - 4)
                        cr.line_to(gx, y1 + 4)
                        cr.stroke()
                continue

            if gt == "CCX" and len(g) >= 4:
                c2, tgt = int(g[2]), int(g[3])
                ys = [wire_top + (qq + 0.5) * spacing for qq in (q0, c2, tgt) if qq < disp_nq]
                if len(ys) >= 2:
                    cr.set_source_rgb(0.0, 1.0, 0.62)
                    cr.set_line_width(1.6)
                    cr.move_to(gx, min(ys))
                    cr.line_to(gx, max(ys))
                    cr.stroke()
                for cc_q in (q0, c2):
                    if cc_q < disp_nq:
                        cy = wire_top + (cc_q + 0.5) * spacing
                        cr.arc(gx, cy, 3.3, 0, 2 * math.pi)
                        cr.fill()
                if tgt < disp_nq:
                    ty = wire_top + (tgt + 0.5) * spacing
                    cr.arc(gx, ty, 6.0, 0, 2 * math.pi)
                    cr.stroke()
                continue

            box_w, box_h = min(22.0, max(14.0, step_w * 0.78)), min(16.0, spacing * 0.74)
            if gt == "H":
                cr.set_source_rgba(0.0, 0.55, 0.75, 0.92)
            elif gt in ("X", "Y", "Z"):
                cr.set_source_rgba(0.45, 0.20, 0.80, 0.92)
            elif gt == "MEASURE":
                cr.set_source_rgba(0.18, 0.22, 0.34, 0.95)
            else:
                cr.set_source_rgba(0.0, 0.62, 0.45, 0.92)
            cr.rectangle(gx - box_w / 2.0, y0 - box_h / 2.0, box_w, box_h)
            cr.fill()
            cr.set_source_rgba(0.0, 0.90, 1.0, 0.8)
            cr.set_line_width(0.9)
            cr.rectangle(gx - box_w / 2.0, y0 - box_h / 2.0, box_w, box_h)
            cr.stroke()

            lbl = "M" if gt == "MEASURE" else gt[:3]
            cr.set_source_rgb(1.0, 1.0, 1.0)
            cr.set_font_size(8.0)
            cr.move_to(gx - len(lbl) * 2.5, y0 + 2.8)
            cr.show_text(lbl)

    # Divider
    mid_y = height * 0.52
    cr.set_source_rgba(0.54, 0.31, 1.0, 0.35)
    cr.set_line_width(1.0)
    cr.move_to(8, mid_y)
    cr.line_to(width - 8, mid_y)
    cr.stroke()

    # Bottom Section (48%): Statevector Probability Spectrum
    cr.set_source_rgb(0.0, 1.0, 0.62)
    cr.set_font_size(10.5)
    cr.move_to(10, mid_y + 16)
    cr.show_text(f"STATEVECTOR PROBABILITIES | S(rho_A) = {info['entanglement_bits']:.3f} bits")

    dim = len(probs)
    if dim <= 16:
        indices = list(range(dim))
    else:
        indices = list(np.argsort(probs)[::-1][:12])
        indices.sort()

    chart_x = 14.0
    chart_w = width - 28.0
    chart_top = mid_y + 26.0
    chart_bot = height - 22.0
    chart_h = max(36.0, chart_bot - chart_top)
    bar_slot = chart_w / max(1, len(indices))
    p_max = max(0.20, float(np.max(probs)))

    for pos, idx in enumerate(indices):
        pr = float(probs[idx])
        rc, gc, bc = phase_to_rgb(float(phases[idx]))
        bh = (pr / p_max) * (chart_h - 12.0)
        bx = chart_x + pos * bar_slot + 2.0
        bw = max(3.0, bar_slot - 4.0)
        cr.set_source_rgba(rc, gc, bc, 0.90 if pr > 0.005 else 0.22)
        cr.rectangle(bx, chart_bot - bh, bw, bh)
        cr.fill()

        if len(indices) <= 12:
            ket_bits = format(int(idx), f"0{info['statevector'].num_qubits}b")
            cr.set_source_rgb(0.78, 0.84, 0.96)
            cr.set_font_size(8.0)
            cr.move_to(bx, height - 8.0)
            cr.show_text(ket_bits[-4:])
            if pr >= 0.03:
                cr.set_source_rgb(0.92, 0.97, 1.0)
                cr.move_to(bx, max(chart_top + 8.0, chart_bot - bh - 3.0))
                cr.show_text(f"{pr * 100:.0f}%")


def sync_hilbert_ipc(info: Dict[str, Any]) -> None:
    try:
        sv: Statevector = info["statevector"]
        payload = {
            "source": info.get("filepath", "omniq-files"),
            "num_qubits": sv.num_qubits,
            "qasm": info.get("qasm", ""),
            "amplitudes_re": [float(x.real) for x in sv.data],
            "amplitudes_im": [float(x.imag) for x in sv.data],
        }
        with open(IPC_HILBERT_PATH, "w", encoding="utf-8") as f:
            json.dump(payload, f)
    except Exception:
        pass


def resolve_sibling_bin(name: str) -> str:
    local = os.path.join(REPO_ROOT, "bin", name)
    if os.path.isfile(local):
        return local
    for cand in [f"/usr/local/bin/{name}", f"/usr/bin/{name}"]:
        if os.path.isfile(cand):
            return cand
    return shutil.which(name) or local


def launch_gui(initial_dir: Optional[str] = None) -> None:
    import cairo  # noqa: F401
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk, Pango

    GLib.set_prgname("omniq-files")
    GLib.set_application_name("OmniQ Files")

    gtk_settings = Gtk.Settings.get_default()
    if gtk_settings is not None:
        gtk_settings.set_property("gtk-application-prefer-dark-theme", True)

    provider = Gtk.CssProvider()
    provider.load_from_data(DARK_CSS)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    class OmniQFilesWindow(Gtk.Window):
        def __init__(self, start_path: Optional[str] = None):
            super().__init__(title="OmniQ Files — Quantum Workspace & File Manager")
            self.set_default_size(1160, 700)
            self.set_position(Gtk.WindowPosition.CENTER)

            self.crud = FileCRUDManager()
            default_circuits = os.path.join(REPO_ROOT, "circuits")
            self.current_dir = (
                os.path.abspath(start_path)
                if start_path and os.path.isdir(start_path)
                else (default_circuits if os.path.isdir(default_circuits) else os.path.expanduser("~"))
            )
            self.history: List[str] = [self.current_dir]
            self.selected_path: Optional[str] = None
            self.preview_info: Optional[Dict[str, Any]] = None
            self.bookmark_buttons: List[Tuple[str, Gtk.Button]] = []

            root_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            root_vbox.get_style_context().add_class("main-bg")
            self.add(root_vbox)

            # Top Navigation + CRUD Toolbar
            hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            hdr.get_style_context().add_class("header-bar")

            btn_back = Gtk.Button(label="Back")
            btn_back.connect("clicked", self._on_back)
            hdr.pack_start(btn_back, False, False, 0)

            btn_up = Gtk.Button(label="Up")
            btn_up.connect("clicked", self._on_up)
            hdr.pack_start(btn_up, False, False, 0)

            btn_refresh = Gtk.Button(label="Refresh")
            btn_refresh.connect("clicked", lambda _b: self.load_directory(self.current_dir, record_history=False))
            hdr.pack_start(btn_refresh, False, False, 0)

            self.path_entry = Gtk.Entry()
            self.path_entry.set_text(self.current_dir)
            self.path_entry.connect("activate", self._on_path_activate)
            hdr.pack_start(self.path_entry, True, True, 4)

            btn_mkdir = Gtk.Button(label="New Folder")
            btn_mkdir.connect("clicked", self._on_new_folder)
            hdr.pack_start(btn_mkdir, False, False, 0)

            btn_new_qasm = Gtk.Button(label="New QASM File")
            btn_new_qasm.get_style_context().add_class("accent-btn")
            btn_new_qasm.connect("clicked", self._on_new_qasm)
            hdr.pack_start(btn_new_qasm, False, False, 0)

            btn_rename = Gtk.Button(label="Rename")
            btn_rename.connect("clicked", self._on_rename)
            hdr.pack_start(btn_rename, False, False, 0)

            btn_trash = Gtk.Button(label="Move to Trash")
            btn_trash.get_style_context().add_class("danger-btn")
            btn_trash.connect("clicked", self._on_move_to_trash)
            hdr.pack_start(btn_trash, False, False, 0)

            btn_empty = Gtk.Button(label="Empty Trash")
            btn_empty.get_style_context().add_class("danger-btn")
            btn_empty.connect("clicked", self._on_empty_trash)
            hdr.pack_start(btn_empty, False, False, 0)

            root_vbox.pack_start(hdr, False, False, 0)

            # Main 3-Region Body: [Bookmarks Sidebar] | [Directory Table] | [Quantum & Hilbert Preview]
            body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            body.set_margin_start(8)
            body.set_margin_end(8)
            body.set_margin_top(8)
            body.set_margin_bottom(8)
            root_vbox.pack_start(body, True, True, 0)

            # 1. Sidebar Bookmarks
            sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            sidebar.set_size_request(185, -1)
            sidebar.get_style_context().add_class("sidebar")

            bm_hdr = Gtk.Label(label="BOOKMARKS")
            bm_hdr.get_style_context().add_class("title-lbl")
            bm_hdr.set_xalign(0.0)
            bm_hdr.set_margin_bottom(6)
            sidebar.pack_start(bm_hdr, False, False, 0)

            for label, target in get_bookmarks():
                b = Gtk.Button()
                lbl_w = Gtk.Label(label=label)
                lbl_w.set_xalign(0.0)
                b.add(lbl_w)
                b.connect("clicked", lambda _btn, p=target: self.load_directory(p))
                sidebar.pack_start(b, False, False, 0)
                self.bookmark_buttons.append((target, b))

            body.pack_start(sidebar, False, False, 0)

            # 2. Center Dual-Pane Split: Directory Table + Right Quantum Preview Pane
            paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
            paned.set_wide_handle(True)
            body.pack_start(paned, True, True, 0)

            table_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            table_card.get_style_context().add_class("panel-card")
            table_card.set_size_request(480, -1)

            # Columns: name, kind, size_str, mtime_str, full_path, is_dir
            self.store = Gtk.ListStore(str, str, str, str, str, bool)
            self.tree = Gtk.TreeView(model=self.store)
            self.tree.set_activate_on_single_click(False)
            self.tree.connect("cursor-changed", self._on_selection_changed)
            self.tree.connect("row-activated", self._on_row_activated)

            col_specs = [
                ("Name", 0, 220),
                ("Type", 1, 130),
                ("Size", 2, 85),
                ("Modified", 3, 130),
            ]
            for title, idx, min_w in col_specs:
                rend = Gtk.CellRendererText()
                rend.set_property("ellipsize", Pango.EllipsizeMode.END)
                col = Gtk.TreeViewColumn(title, rend, text=idx)
                col.set_resizable(True)
                col.set_min_width(min_w)
                col.set_sort_column_id(idx)
                self.tree.append_column(col)

            scroll = Gtk.ScrolledWindow()
            scroll.set_hexpand(True)
            scroll.set_vexpand(True)
            scroll.add(self.tree)
            table_card.pack_start(scroll, True, True, 0)
            paned.pack1(table_card, True, False)

            # 3. Right Pane: Live Quantum Circuit & Hilbert Preview
            preview_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            preview_card.get_style_context().add_class("panel-card")
            preview_card.set_size_request(410, -1)

            pv_in = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            pv_in.set_margin_start(10)
            pv_in.set_margin_end(10)
            pv_in.set_margin_top(10)
            pv_in.set_margin_bottom(10)
            preview_card.pack_start(pv_in, True, True, 0)

            pv_hdr = Gtk.Label(label="QUANTUM CIRCUIT & HILBERT PREVIEW")
            pv_hdr.get_style_context().add_class("title-lbl")
            pv_hdr.set_xalign(0.0)
            pv_in.pack_start(pv_hdr, False, False, 0)

            self.pv_meta_lbl = Gtk.Label(label="Select a .qasm or .json circuit file to inspect.")
            self.pv_meta_lbl.get_style_context().add_class("sub-lbl")
            self.pv_meta_lbl.set_xalign(0.0)
            self.pv_meta_lbl.set_line_wrap(True)
            pv_in.pack_start(self.pv_meta_lbl, False, False, 0)

            self.canvas = Gtk.DrawingArea()
            self.canvas.set_size_request(380, 320)
            self.canvas.connect("draw", self._on_draw_preview)
            pv_in.pack_start(self.canvas, True, True, 0)

            # Text snippet area for source QASM / general files
            txt_scroll = Gtk.ScrolledWindow()
            txt_scroll.set_size_request(-1, 115)
            self.snippet_view = Gtk.TextView()
            self.snippet_view.set_editable(False)
            self.snippet_view.set_monospace(True)
            self.snippet_view.get_style_context().add_class("mono-preview")
            txt_scroll.add(self.snippet_view)
            pv_in.pack_start(txt_scroll, False, False, 0)

            # Launch Buttons
            act_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            self.btn_open_cm = Gtk.Button(label="Open in Circuit Maker")
            self.btn_open_cm.get_style_context().add_class("accent-btn")
            self.btn_open_cm.connect("clicked", self._on_open_circuit_maker)
            act_row.pack_start(self.btn_open_cm, True, True, 0)

            self.btn_open_hs = Gtk.Button(label="Open in Hilbert Space")
            self.btn_open_hs.get_style_context().add_class("violet-btn")
            self.btn_open_hs.connect("clicked", self._on_open_hilbert_space)
            act_row.pack_start(self.btn_open_hs, True, True, 0)

            self.btn_open_edit = Gtk.Button(label="Edit Code")
            self.btn_open_edit.connect("clicked", self._on_open_editor)
            act_row.pack_start(self.btn_open_edit, False, False, 0)

            pv_in.pack_start(act_row, False, False, 0)
            paned.pack2(preview_card, False, False)

            # Status Bar
            self.status_lbl = Gtk.Label(label="Ready")
            self.status_lbl.get_style_context().add_class("statusbar")
            self.status_lbl.set_xalign(0.0)
            root_vbox.pack_start(self.status_lbl, False, False, 0)

            self.load_directory(self.current_dir, record_history=False)

        def _prompt_text(self, title: str, label_txt: str, initial: str = "") -> Optional[str]:
            dlg = Gtk.Dialog(
                title=title,
                parent=self,
                flags=Gtk.DialogFlags.MODAL | Gtk.DialogFlags.DESTROY_WITH_PARENT,
            )
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
            dlg.set_default_size(360, 130)
            box = dlg.get_content_area()
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            inner.set_margin_start(14)
            inner.set_margin_end(14)
            inner.set_margin_top(12)
            inner.set_margin_bottom(12)
            lbl = Gtk.Label(label=label_txt)
            lbl.set_xalign(0.0)
            entry = Gtk.Entry()
            entry.set_text(initial)
            entry.connect("activate", lambda _e: dlg.response(Gtk.ResponseType.OK))
            inner.pack_start(lbl, False, False, 0)
            inner.pack_start(entry, False, False, 0)
            box.add(inner)
            dlg.show_all()
            resp = dlg.run()
            val = entry.get_text().strip()
            dlg.destroy()
            return val if resp == Gtk.ResponseType.OK and val else None

        def load_directory(self, path: str, record_history: bool = True) -> None:
            target = os.path.abspath(os.path.expanduser(path))
            if not os.path.isdir(target):
                self.status_lbl.set_text(f"Directory unavailable: {target}")
                return
            self.current_dir = target
            self.path_entry.set_text(target)
            if record_history and (not self.history or self.history[-1] != target):
                self.history.append(target)

            for bm_path, btn in self.bookmark_buttons:
                if os.path.abspath(bm_path) == target:
                    btn.get_style_context().add_class("active-bm")
                else:
                    btn.get_style_context().remove_class("active-bm")

            self.store.clear()
            self.selected_path = None
            self.preview_info = None
            self.canvas.queue_draw()

            try:
                entries = sorted(
                    os.scandir(target),
                    key=lambda e: (not e.is_dir(follow_symlinks=True), e.name.lower()),
                )
            except Exception as exc:
                self.status_lbl.set_text(f"Permission error reading {target}: {exc}")
                return

            count_dirs = 0
            count_files = 0
            first_quantum_iter = None

            for entry in entries:
                if entry.name.startswith(".") and target != get_trash_dir():
                    continue
                try:
                    st = entry.stat(follow_symlinks=True)
                    is_dir = entry.is_dir(follow_symlinks=True)
                    mtime = datetime.datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M")
                    size_s = "--" if is_dir else format_size(st.st_size)
                except Exception:
                    is_dir = False
                    mtime = "--"
                    size_s = "--"

                low = entry.name.lower()
                if is_dir:
                    kind = "Folder"
                    count_dirs += 1
                elif low.endswith(".qasm"):
                    kind = "OpenQASM Circuit"
                    count_files += 1
                elif low.endswith(".omniq.json") or low.endswith(".json"):
                    kind = "Quantum JSON"
                    count_files += 1
                elif low.endswith(".py"):
                    kind = "Python Script"
                    count_files += 1
                else:
                    kind = "File"
                    count_files += 1

                it = self.store.append([entry.name, kind, size_s, mtime, entry.path, is_dir])
                if first_quantum_iter is None and (low.endswith(".qasm") or low.endswith(".json")):
                    first_quantum_iter = it

            self.status_lbl.set_text(f"{target}  |  {count_dirs} folders, {count_files} files")
            if first_quantum_iter is not None:
                self.tree.get_selection().select_iter(first_quantum_iter)
                self._on_selection_changed(self.tree)

        def _on_selection_changed(self, _tree) -> None:
            sel = self.tree.get_selection()
            model, it = sel.get_selected()
            if not it:
                return
            fpath = model[it][4]
            is_dir = model[it][5]
            self.selected_path = fpath

            if is_dir:
                self.preview_info = None
                self.pv_meta_lbl.set_text(f"Folder: {os.path.basename(fpath)}")
                self.snippet_view.get_buffer().set_text(f"Directory: {fpath}\nDouble-click row to enter directory.")
                self.canvas.queue_draw()
                return

            qinfo = parse_quantum_file(fpath)
            self.preview_info = qinfo
            if qinfo is not None:
                self.pv_meta_lbl.set_text(
                    f"{qinfo['title']}  |  {qinfo['num_qubits']} Qubits, {qinfo['gate_count']} Gates  |  "
                    f"Dominant: {qinfo['dominant_ket']}"
                )
                self.snippet_view.get_buffer().set_text(qinfo["qasm"][:4096])
            else:
                self.pv_meta_lbl.set_text(f"File: {os.path.basename(fpath)}")
                try:
                    with open(fpath, "r", encoding="utf-8", errors="replace") as f:
                        snippet = f.read(2048)
                except Exception as exc:
                    snippet = f"<Binary or unreadable file: {exc}>"
                self.snippet_view.get_buffer().set_text(snippet)
            self.canvas.queue_draw()

        def _on_row_activated(self, _tree, path, _col) -> None:
            it = self.store.get_iter(path)
            fpath = self.store[it][4]
            is_dir = self.store[it][5]
            if is_dir:
                self.load_directory(fpath)
            else:
                self._on_open_editor(None)

        def _on_draw_preview(self, widget, cr) -> bool:
            alloc = widget.get_allocation()
            draw_quantum_preview(cr, float(alloc.width), float(alloc.height), self.preview_info)
            return False

        def _on_back(self, _btn) -> None:
            if len(self.history) > 1:
                self.history.pop()
                self.load_directory(self.history[-1], record_history=False)

        def _on_up(self, _btn) -> None:
            parent = os.path.dirname(self.current_dir.rstrip("/")) or "/"
            self.load_directory(parent)

        def _on_path_activate(self, entry) -> None:
            self.load_directory(entry.get_text().strip())

        def _on_new_folder(self, _btn) -> None:
            name = self._prompt_text("New Folder", "Folder name:", "quantum_experiment")
            if name:
                try:
                    self.crud.create_folder(self.current_dir, name)
                    self.load_directory(self.current_dir, record_history=False)
                except Exception as exc:
                    self.status_lbl.set_text(f"Create folder error: {exc}")

        def _on_new_qasm(self, _btn) -> None:
            name = self._prompt_text("New OpenQASM 3.0 Circuit", "Circuit filename (.qasm):", "new_circuit.qasm")
            if name:
                try:
                    created = self.crud.create_qasm_file(self.current_dir, name)
                    self.load_directory(self.current_dir, record_history=False)
                    self.status_lbl.set_text(f"Created QASM circuit: {created}")
                except Exception as exc:
                    self.status_lbl.set_text(f"Create QASM error: {exc}")

        def _on_rename(self, _btn) -> None:
            if not self.selected_path:
                return
            cur_name = os.path.basename(self.selected_path)
            new_name = self._prompt_text("Rename Item", f"Rename '{cur_name}' to:", cur_name)
            if new_name and new_name != cur_name:
                try:
                    self.crud.rename_item(self.selected_path, new_name)
                    self.load_directory(self.current_dir, record_history=False)
                except Exception as exc:
                    self.status_lbl.set_text(f"Rename error: {exc}")

        def _on_move_to_trash(self, _btn) -> None:
            if not self.selected_path:
                return
            try:
                dst = self.crud.move_to_trash(self.selected_path)
                self.load_directory(self.current_dir, record_history=False)
                self.status_lbl.set_text(f"Moved to Trash: {os.path.basename(dst)}")
            except Exception as exc:
                self.status_lbl.set_text(f"Trash error: {exc}")

        def _on_empty_trash(self, _btn) -> None:
            removed = self.crud.empty_trash()
            if os.path.abspath(self.current_dir) == os.path.abspath(self.crud.trash_dir):
                self.load_directory(self.current_dir, record_history=False)
            self.status_lbl.set_text(f"Emptied Trash ({removed} items removed).")

        def _on_open_circuit_maker(self, _btn) -> None:
            if self.preview_info:
                sync_hilbert_ipc(self.preview_info)
            cm = resolve_sibling_bin("omniq-circuit-maker")
            args = [sys.executable, cm] if os.path.isfile(cm) else [cm]
            if self.selected_path and os.path.isfile(self.selected_path):
                args.append(self.selected_path)
            subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        def _on_open_hilbert_space(self, _btn) -> None:
            if self.preview_info:
                sync_hilbert_ipc(self.preview_info)
            hs = resolve_sibling_bin("omniq-hilbert-space")
            args = [sys.executable, hs] if os.path.isfile(hs) else [hs]
            if self.selected_path and os.path.isfile(self.selected_path):
                args.append(self.selected_path)
            subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        def _on_open_editor(self, _btn) -> None:
            if not self.selected_path or not os.path.isfile(self.selected_path):
                return
            ed = resolve_sibling_bin("omniq-edit")
            args = [sys.executable, ed, self.selected_path] if os.path.isfile(ed) else [ed, self.selected_path]
            subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    win = OmniQFilesWindow(initial_dir)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


def run_self_test() -> int:
    import cairo

    # 1. Verify bookmarks include all 5 required entries
    bm_names = [name for name, _ in get_bookmarks()]
    for req in ["Home", "File System", "Quantum Circuits", "Opt OmniQ", "Trash"]:
        assert req in bm_names, f"Missing bookmark {req}"

    # 2. Verify CRUD operations in isolated temp directory
    with tempfile.TemporaryDirectory(prefix="omniq_files_test_") as tmp:
        trash_tmp = os.path.join(tmp, ".trash")
        crud = FileCRUDManager(trash_dir=trash_tmp)
        folder = crud.create_folder(tmp, "exp_run_01")
        assert os.path.isdir(folder)

        qfile = crud.create_qasm_file(tmp, "bell_test")
        assert os.path.isfile(qfile) and qfile.endswith(".qasm")

        info = parse_quantum_file(qfile)
        assert info is not None
        assert info["num_qubits"] == 2
        assert abs(info["entanglement_bits"] - 1.0) < 1e-5

        # Offscreen Cairo render test
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 420, 340)
        cr = cairo.Context(surf)
        draw_quantum_preview(cr, 420.0, 340.0, info)

        renamed = crud.rename_item(qfile, "bell_renamed.qasm")
        assert os.path.isfile(renamed)

        trashed = crud.move_to_trash(renamed)
        assert os.path.isfile(trashed) and not os.path.exists(renamed)
        removed = crud.empty_trash()
        assert removed == 1

    # 3. Verify bundled circuits/ parse cleanly
    cdir = os.path.join(REPO_ROOT, "circuits")
    if os.path.isdir(cdir):
        for fn in ["bell_pair.qasm", "grover_3qubit.qasm", "hilbert_presets.json"]:
            fp = os.path.join(cdir, fn)
            if os.path.isfile(fp):
                parsed = parse_quantum_file(fp)
                assert parsed is not None, f"Failed to parse {fn}"

    print("[PASS] omniq-files CRUD, bookmarks, and Cairo Quantum/Hilbert preview verified.")
    return 0


def main() -> None:
    if "--test" in sys.argv:
        sys.exit(run_self_test())
    start_dir = None
    for a in sys.argv[1:]:
        if not a.startswith("-"):
            start_dir = a
            break
    launch_gui(start_dir)


if __name__ == "__main__":
    main()
