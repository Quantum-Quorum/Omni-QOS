def _port_open(host: str, port: int, timeout: float = 0.25) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except Exception:
        return False

def ensure_twin_if_loopback(mgr: Any) -> None:
    cfg = getattr(mgr, "config", {}) or {}
    host = str(cfg.get("lakeshore372_host", "127.0.0.1"))
    port = int(cfg.get("lakeshore372_port", 17777))
    mode = str(cfg.get("mode", "twin_loopback"))
    if host in ("127.0.0.1", "localhost") and mode == "twin_loopback" and not _port_open(host, port):
        for cand in [os.path.join(REPO_ROOT, "bin", "omniq-lab-twin"), "/usr/local/bin/omniq-lab-twin"]:
            if os.path.exists(cand) and os.access(cand, os.X_OK):
                subprocess.Popen([cand, "--daemon"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                for _ in range(15):
                    if _port_open(host, port, 0.15):
                        break
                    time.sleep(0.08)
                break

def get_rack_manager():
    from omniq.lab.rack_manager import LabRackManager
    mgr = LabRackManager()
    ensure_twin_if_loopback(mgr)
    return mgr

def launch_gui() -> None:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    GLib.set_prgname("omniq-cryo-lab")

    provider = Gtk.CssProvider()
    provider.load_from_data(DARK_CSS)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    class CryoLabWindow(Gtk.Window):
        def __init__(self):
            super().__init__(title="OmniQ Production Cryogenic Dilution Lab & SCPI/Modbus Console")
            self.set_default_size(1340, 820)
            self.set_wmclass("omniq-cryo-lab", "omniq-cryo-lab")

            self.mgr = get_rack_manager()
            self.mxc_history: Deque[float] = collections.deque([14.2] * 120, maxlen=120)
            self.still_history: Deque[float] = collections.deque([820.0] * 120, maxlen=120)
            self.last_snap: Dict[str, Any] = {}
            self.valve_hitboxes: List[Tuple[int, float, float, float, float]] = []
            self.poll_timer: int = 0

            self._build_ui()
            self._append_wire_log(
                "INIT",
                f"Loaded rack config ({self.mgr.config_path}) - mode={self.mgr.config.get('mode', 'twin_loopback')}",
            )
            self._poll_instruments()
            self.poll_timer = GLib.timeout_add(450, self._poll_instruments)
            self.connect("destroy", self._on_destroy)

        def _on_destroy(self, *_args):
            if self.poll_timer:
                GLib.source_remove(self.poll_timer)
                self.poll_timer = 0
            Gtk.main_quit()

        def _build_ui(self):
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            root.get_style_context().add_class("main-bg")
            self.add(root)

            hbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            hbar.get_style_context().add_class("header-bar")
            hbar.set_margin_start(12)
            hbar.set_margin_end(12)
            hbar.set_margin_top(8)
            hbar.set_margin_bottom(8)

            tbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            ttl = Gtk.Label(label="OMNIQ CRYOGENIC DILUTION LAB & INSTRUMENT BUS")
            ttl.get_style_context().add_class("title-lbl")
            ttl.set_xalign(0.0)
            self.bus_sub = Gtk.Label(
                label="IEEE-488.2 SCPI (:17777 Lake Shore 372 | :15025 R&S LO) + Bluefors (:19098) + Modbus/TCP PLC (:15020) + QICK ZCU216 (:18888)"
            )
            self.bus_sub.get_style_context().add_class("sub-lbl")
            self.bus_sub.set_xalign(0.0)
            tbox.pack_start(ttl, False, False, 0)
            tbox.pack_start(self.bus_sub, False, False, 0)
            hbar.pack_start(tbox, False, False, 4)

            rst_btn = Gtk.Button(label="Reset Hardware Interlock")
            rst_btn.get_style_context().add_class("mint-btn")
            rst_btn.connect("clicked", self._on_reset_interlock)
            hbar.pack_end(rst_btn, False, False, 2)

            trip_btn = Gtk.Button(label="Trip RF & Heater Interlock")
            trip_btn.get_style_context().add_class("trip-btn")
            trip_btn.connect("clicked", self._on_trip_interlock)
            hbar.pack_end(trip_btn, False, False, 2)

            cfg_btn = Gtk.Button(label="Rack IPs (lab_rack.conf)")
            cfg_btn.get_style_context().add_class("cyan-btn")
            cfg_btn.connect("clicked", self._on_edit_rack_config)
            hbar.pack_end(cfg_btn, False, False, 4)

            root.pack_start(hbar, False, False, 0)

            body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            body.set_margin_start(10)
            body.set_margin_end(10)
            body.set_margin_top(8)
            body.set_margin_bottom(10)
            root.pack_start(body, True, True, 0)

            left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            left.set_size_request(280, -1)
            left.get_style_context().add_class("panel-card")
            lin = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            lin.set_margin_start(10)
            lin.set_margin_end(10)
            lin.set_margin_top(10)
            lin.set_margin_bottom(10)
            left.pack_start(lin, True, True, 0)

            lh1 = Gtk.Label(label="LAKE SHORE 372 & BLUEFORS STAGES")
            lh1.get_style_context().add_class("title-lbl")
            lh1.set_xalign(0.0)
            lin.pack_start(lh1, False, False, 0)

            self.stage_labels: Dict[str, Gtk.Label] = {}
            rows = [
                ("s50k", "CH1 50K Radiation Shield:"),
                ("s4k", "CH2 4K Pulse-Tube Plate:"),
                ("sstill", "CH3 Still Flange (~800 mK):"),
                ("scold", "CH5 Cold Plate (~95 mK):"),
                ("smxc", "CH6 Mixing Chamber (MXC):"),
                ("ruo2", "MXC RuO2 Sensor Bridge:"),
                ("rflo", "R&S SGS100A Microwave LO:"),
                ("hemt", "Modbus Coil[0] HEMT/RF Bias:"),
                ("ilock", "Safety Interlock (< 50.0 mK):"),
            ]
            for k, title in rows:
                lt = Gtk.Label(label=title)
                lt.get_style_context().add_class("sub-lbl")
                lt.set_xalign(0.0)
                lv = Gtk.Label(label="--")
                lv.get_style_context().add_class("metric-val")
                lv.set_xalign(0.0)
                self.stage_labels[k] = lv
                lin.pack_start(lt, False, False, 0)
                lin.pack_start(lv, False, False, 1)

            lin.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 4)

            lh2 = Gtk.Label(label="MXC HEATER & QUENCH TEST")
            lh2.get_style_context().add_class("title-lbl")
            lh2.set_xalign(0.0)
            lin.pack_start(lh2, False, False, 0)

            hl = Gtk.Label(label="Applied MXC Heat Load (uW):")
            hl.get_style_context().add_class("sub-lbl")
            hl.set_xalign(0.0)
            lin.pack_start(hl, False, False, 0)

            self.heat_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.0, 500.0, 10.0)
            self.heat_scale.set_value(0.0)
            self.heat_scale.connect("value-changed", self._on_heater_slider)
            lin.pack_start(self.heat_scale, False, False, 0)

            qbtns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            q_btn = Gtk.Button(label="Inject 450 uW Quench")
            q_btn.get_style_context().add_class("trip-btn")
            q_btn.connect("clicked", lambda _b: self._set_heat_load(450.0))
            c_btn = Gtk.Button(label="Base Cool (0 uW)")
            c_btn.get_style_context().add_class("mint-btn")
            c_btn.connect("clicked", lambda _b: self._set_heat_load(0.0))
            qbtns.pack_start(q_btn, True, True, 0)
            qbtns.pack_start(c_btn, True, True, 0)
            lin.pack_start(qbtns, False, False, 2)

            body.pack_start(left, False, False, 0)

            center = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            body.pack_start(center, True, True, 0)

            top_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            top_card.get_style_context().add_class("panel-card")
            self.scope_canvas = Gtk.DrawingArea()
            self.scope_canvas.set_size_request(-1, 350)
            self.scope_canvas.connect("draw", self._draw_cryo_scope_and_stages)
            top_card.pack_start(self.scope_canvas, True, True, 0)
            center.pack_start(top_card, True, True, 0)

            bot_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            bot_card.get_style_context().add_class("panel-card")
            self.pid_canvas = Gtk.DrawingArea()
            self.pid_canvas.set_size_request(-1, 320)
            self.pid_canvas.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            self.pid_canvas.connect("draw", self._draw_manifold_pid)
            self.pid_canvas.connect("button-press-event", self._on_pid_click)
            bot_card.pack_start(self.pid_canvas, True, True, 0)
            center.pack_start(bot_card, True, True, 0)

            right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            right.set_size_request(355, -1)
            right.get_style_context().add_class("panel-card")
            rin = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            rin.set_margin_start(10)
            rin.set_margin_end(10)
            rin.set_margin_top(10)
            rin.set_margin_bottom(10)
            right.pack_start(rin, True, True, 0)

            rh = Gtk.Label(label="LIVE SCPI / MODBUS WIRE CONSOLE")
            rh.get_style_context().add_class("title-lbl")
            rh.set_xalign(0.0)
            rin.pack_start(rh, False, False, 0)

            tgt_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            tl = Gtk.Label(label="Instrument:")
            tl.set_xalign(0.0)
            self.scpi_target = Gtk.ComboBoxText()
            self.scpi_target.append("lakeshore", "Lake Shore 372 (:17777)")
            self.scpi_target.append("lo", "R&S SGS100A LO (:15025)")
            self.scpi_target.set_active_id("lakeshore")
            tgt_row.pack_start(tl, False, False, 0)
            tgt_row.pack_end(self.scpi_target, True, True, 0)
            rin.pack_start(tgt_row, False, False, 0)

            presets = [
                ("*IDN?", "lakeshore"),
                ("RDGK? 6", "lakeshore"),
                ("RDGR? 6", "lakeshore"),
                ("HTR?", "lakeshore"),
                ("SOUR:FREQ:CW?", "lo"),
                ("OUTP:STAT?", "lo"),
                ("OUTP:STAT OFF", "lo"),
                ("OUTP:STAT ON", "lo"),
            ]
            for row_idx in range(2):
                prow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
                for cmd_txt, tgt_id in presets[row_idx * 4 : (row_idx + 1) * 4]:
                    b = Gtk.Button(label=cmd_txt)
                    b.connect("clicked", self._on_preset_scpi, tgt_id, cmd_txt)
                    prow.pack_start(b, True, True, 0)
                rin.pack_start(prow, False, False, 0)

            cmd_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            self.scpi_entry = Gtk.Entry()
            self.scpi_entry.set_text("RDGK? 6")
            self.scpi_entry.connect("activate", self._on_send_custom_scpi)
            send_btn = Gtk.Button(label="Send SCPI")
            send_btn.get_style_context().add_class("cyan-btn")
            send_btn.connect("clicked", self._on_send_custom_scpi)
            cmd_row.pack_start(self.scpi_entry, True, True, 0)
            cmd_row.pack_end(send_btn, False, False, 0)
            rin.pack_start(cmd_row, False, False, 0)

            sw = Gtk.ScrolledWindow()
            sw.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
            self.wire_view = Gtk.TextView()
            self.wire_view.set_editable(False)
            self.wire_view.set_monospace(True)
            self.wire_view.set_wrap_mode(Gtk.WrapMode.CHAR)
            self.wire_view.override_background_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.05, 0.04, 0.10, 1.0))
            self.wire_view.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.78, 0.96, 1.0, 1.0))
            sw.add(self.wire_view)
            rin.pack_start(sw, True, True, 0)

            body.pack_start(right, False, False, 0)

        def _append_wire_log(self, proto: str, line: str):
            buf = self.wire_view.get_buffer()
            ts = time.strftime("%H:%M:%S")
            end_it = buf.get_end_iter()
            buf.insert(end_it, f"[{ts}] [{proto}] {line}\n")
            if buf.get_line_count() > 220:
                s0 = buf.get_start_iter()
                s1 = buf.get_iter_at_line(30)
                buf.delete(s0, s1)
            mark = buf.create_mark(None, buf.get_end_iter(), False)
            self.wire_view.scroll_to_mark(mark, 0.0, False, 0.0, 1.0)

        def _set_heat_load(self, uw: float):
            self.heat_scale.set_value(uw)
            try:
                self.mgr.bluefors.inject_heat_load_uW(uw)
                self._append_wire_log("BLUEFORS", f"POST /control/heater power_uW={uw:.1f}")
            except Exception as e:
                self._append_wire_log("ERR", f"Heater control error: {e}")

        def _on_heater_slider(self, scale):
            uw = float(scale.get_value())
            try:
                self.mgr.bluefors.inject_heat_load_uW(uw)
            except Exception:
                pass

        def _on_trip_interlock(self, _btn):
            try:
                t0 = time.perf_counter()
                res = self.mgr.trip_safety_interlock("MANUAL_CRYO_CONSOLE_TRIP")
                dt = (time.perf_counter() - t0) * 1000.0
                self._append_wire_log(
                    "INTERLOCK",
                    f"TRIPPED ({dt:.2f} ms): R&S OUTP:STAT OFF | LS372 RANGE 0,0 | Modbus FC05 Coil[0]=0 ({res})",
                )
            except Exception as e:
                self._append_wire_log("ERR", f"Trip failed: {e}")

        def _on_reset_interlock(self, _btn):
            try:
                self._set_heat_load(0.0)
                res = self.mgr.reset_safety_interlock()
                self._append_wire_log("INTERLOCK", f"RESET -> {res}")
            except Exception as e:
                self._append_wire_log("ERR", f"Reset blocked: {e}")

        def _on_preset_scpi(self, _btn, tgt: str, cmd: str):
            self.scpi_target.set_active_id(tgt)
            self.scpi_entry.set_text(cmd)
            self._execute_scpi(tgt, cmd)

        def _on_send_custom_scpi(self, *_args):
            tgt = self.scpi_target.get_active_id() or "lakeshore"
            cmd = self.scpi_entry.get_text().strip()
            if cmd:
                self._execute_scpi(tgt, cmd)

        def _execute_scpi(self, tgt: str, cmd: str):
            t0 = time.perf_counter()
            try:
                resp = self.mgr.send_raw_scpi(tgt, cmd)
                dt = (time.perf_counter() - t0) * 1000.0
                self._append_wire_log(f"SCPI:{tgt.upper()}", f"TX >> {cmd}  |  RX << {resp} ({dt:.2f} ms)")
            except Exception as e:
                self._append_wire_log("SCPI:ERR", f"TX >> {cmd} -> {e}")

        def _on_edit_rack_config(self, _btn):
            dlg = Gtk.Dialog(
                title="Configure Physical Lab / Digital-Twin Endpoints (lab_rack.conf)",
                transient_for=self,
                flags=0,
            )
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save & Reconnect", Gtk.ResponseType.OK)
            dlg.set_default_size(520, 360)
            box = dlg.get_content_area()
            box.set_spacing(6)
            box.set_margin_start(14)
            box.set_margin_end(14)
            box.set_margin_top(10)
            box.set_margin_bottom(10)

            fields = [
                ("mode", "Rack Mode (twin_loopback | physical_lab):"),
                ("lakeshore372_host", "Lake Shore 372 Host / IP:"),
                ("lakeshore372_port", "Lake Shore 372 SCPI Port:"),
                ("microwave_lo_host", "R&S / Keysight LO Host / IP:"),
                ("microwave_lo_port", "Microwave LO SCPI Port:"),
                ("bluefors_url", "Bluefors HTTP REST URL:"),
                ("modbus_plc_host", "Gas-Handling Modbus/TCP PLC IP:"),
                ("modbus_plc_port", "Modbus/TCP Port (502 / 15020):"),
                ("qick_rfsoc_host", "Fermilab QICK ZCU216 RFSoC IP:"),
                ("qick_rfsoc_port", "QICK JSON-RPC Port:"),
            ]
            entries: Dict[str, Gtk.Entry] = {}
            for key, label in fields:
                r = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                lbl = Gtk.Label(label=label)
                lbl.set_xalign(0.0)
                ent = Gtk.Entry()
                ent.set_text(str(self.mgr.config.get(key, "")))
                entries[key] = ent
                r.pack_start(lbl, True, True, 0)
                r.pack_end(ent, False, False, 0)
                box.pack_start(r, False, False, 0)

            dlg.show_all()
            resp = dlg.run()
            if resp == Gtk.ResponseType.OK:
                for key, ent in entries.items():
                    val = ent.get_text().strip()
                    if key.endswith("_port") and val.isdigit():
                        self.mgr.config[key] = int(val)
                    else:
                        self.mgr.config[key] = val
                self.mgr.save_config()
                self.mgr.reconnect()
                ensure_twin_if_loopback(self.mgr)
                self._append_wire_log("CONFIG", f"Saved & reconnected instruments ({self.mgr.config_path})")
            dlg.destroy()

        def _poll_instruments(self) -> bool:
            try:
                snap = self.mgr.poll_all(enforce_interlock=True)
                self.last_snap = snap
                stages = snap.get("stages", {})
                lo = snap.get("microwave_lo", {})
                plc = snap.get("plc", {})
                ilock = snap.get("interlock", {})

                mxc_mk = float(stages.get("mxc_mK", 14.2))
                still_mk = float(stages.get("still_K", 0.82)) * 1000.0
                self.mxc_history.append(mxc_mk)
                self.still_history.append(still_mk)

                self.stage_labels["s50k"].set_text(f"{float(stages.get('50K_K', 48.5)):.2f} K")
                self.stage_labels["s4k"].set_text(f"{float(stages.get('4K_K', 3.85)):.3f} K")
                self.stage_labels["sstill"].set_text(f"{still_mk:.1f} mK")
                self.stage_labels["scold"].set_text(f"{float(stages.get('cold_plate_K', 0.095)) * 1000.0:.1f} mK")
                self.stage_labels["smxc"].set_text(f"{mxc_mk:.2f} mK")
                self.stage_labels["ruo2"].set_text(f"{float(stages.get('mxc_ruo2_ohms', 42500.0)) / 1000.0:.2f} kOhm")

                rf_on = bool(lo.get("rf_enabled", True))
                freq_ghz = float(lo.get("freq_hz", 5.0125e9)) / 1e9
                pwr_dbm = float(lo.get("power_dbm", -20.0))
                self.stage_labels["rflo"].set_text(
                    f"{freq_ghz:.4f} GHz | {pwr_dbm:.1f} dBm | {'ON' if rf_on else 'CLAMPED OFF'}"
                )

                hemt_on = bool(plc.get("rf_hemt_bias", True))
                self.stage_labels["hemt"].set_text("ENABLED (Coil 0=1)" if hemt_on else "CUT OFF (Coil 0=0)")

                tripped = bool(ilock.get("tripped", False))
                il_lbl = self.stage_labels["ilock"]
                if tripped:
                    il_lbl.set_text(f"TRIPPED ({ilock.get('reason', 'THERMAL')})")
                    il_lbl.get_style_context().remove_class("metric-val")
                    il_lbl.get_style_context().add_class("warn-val")
                else:
                    il_lbl.set_text("ARMED & NOMINAL (< 50.0 mK)")
                    il_lbl.get_style_context().remove_class("warn-val")
                    il_lbl.get_style_context().add_class("metric-val")

                self.scope_canvas.queue_draw()
                self.pid_canvas.queue_draw()
            except Exception as e:
                self.stage_labels["ilock"].set_text(f"POLL ERR: {e}")
            return True

        def _on_pid_click(self, _widget, ev):
            for v_idx, x0, y0, w, h in self.valve_hitboxes:
                if x0 <= ev.x <= x0 + w and y0 <= ev.y <= y0 + h:
                    plc = self.last_snap.get("plc", {})
                    valves = plc.get("valves", [True] * 12)
                    cur = bool(valves[v_idx]) if v_idx < len(valves) else False
                    new_st = not cur
                    try:
                        t0 = time.perf_counter()
                        self.mgr.plc.set_valve(v_idx + 1, new_st)
                        dt = (time.perf_counter() - t0) * 1000.0
                        self._append_wire_log(
                            "MODBUS:FC05",
                            f"Write Single Coil V{v_idx + 1} (coil={v_idx + 3}) -> {'OPEN (0xFF00)' if new_st else 'CLOSED (0x0000)'} ({dt:.2f} ms)",
                        )
                        self._poll_instruments()
                    except Exception as e:
                        self._append_wire_log("MODBUS:ERR", str(e))
                    break

        def _draw_cryo_scope_and_stages(self, widget, cr):
            alloc = widget.get_allocation()
            w, h = float(alloc.width), float(alloc.height)
            cr.set_source_rgb(0.05, 0.04, 0.11)
            cr.rectangle(0, 0, w, h)
            cr.fill()

            sx0, sy0 = 46.0, 34.0
            sw = w * 0.60 - sx0
            sh = h - 54.0

            cr.set_source_rgb(0.0, 0.90, 1.0)
            cr.select_font_face("DejaVu Sans Mono", 0, 1)
            cr.set_font_size(10.5)
            cr.move_to(14, 20)
            cr.show_text("LIVE LAKE SHORE 372 MXC THERMOMETRY (RDGK? 6) & < 50.0 mK SAFETY INTERLOCK")

            cr.set_source_rgba(0.35, 0.28, 0.65, 0.35)
            cr.set_line_width(1.0)
            cr.rectangle(sx0, sy0, sw, sh)
            cr.stroke()

            max_y = max(75.0, max(self.mxc_history) * 1.15)
            for frac in (0.25, 0.50, 0.75):
                gy = sy0 + sh * (1.0 - frac)
                cr.set_source_rgba(0.3, 0.35, 0.55, 0.22)
                cr.move_to(sx0, gy)
                cr.line_to(sx0 + sw, gy)
                cr.stroke()
                cr.set_source_rgb(0.60, 0.68, 0.82)
                cr.set_font_size(8.5)
                cr.move_to(6, gy + 3)
                cr.show_text(f"{max_y * frac:4.0f}mK")

            ceil_y = sy0 + sh * (1.0 - min(1.0, 50.0 / max_y))
            cr.set_source_rgba(1.0, 0.20, 0.40, 0.88)
            cr.set_dash([5.0, 4.0])
            cr.set_line_width(1.5)
            cr.move_to(sx0, ceil_y)
            cr.line_to(sx0 + sw, ceil_y)
            cr.stroke()
            cr.set_dash([])
            cr.set_font_size(8.8)
            cr.move_to(sx0 + 6, ceil_y - 5)
            cr.show_text("50.0 mK HARDWARE RF CLAMP CEILING (SCPI OUTP:OFF + MODBUS COIL 0)")

            pts = list(self.mxc_history)
            if len(pts) >= 2:
                for i, val in enumerate(pts):
                    px = sx0 + (i / (len(pts) - 1)) * sw
                    py = sy0 + sh * (1.0 - min(1.0, max(0.0, val / max_y)))
                    if i == 0:
                        cr.move_to(px, py)
                    else:
                        cr.line_to(px, py)
                last_v = pts[-1]
                if last_v >= 50.0:
                    cr.set_source_rgb(1.0, 0.20, 0.40)
                else:
                    cr.set_source_rgb(0.0, 1.0, 0.62)
                cr.set_line_width(2.2)
                cr.stroke()

            cx0 = w * 0.63
            cw = w - cx0 - 14.0
            mid_x = cx0 + cw * 0.5

            cr.set_source_rgb(0.54, 0.31, 1.0)
            cr.set_font_size(10.0)
            cr.move_to(cx0, 20)
            cr.show_text("5-STAGE DILUTION CHANDELIER")

            stages_vis = self.last_snap.get("stages", {})
            plates = [
                ("50K Flange", f"{float(stages_vis.get('50K_K', 48.5)):.1f} K", 0.84, 56.0),
                ("4K Plate", f"{float(stages_vis.get('4K_K', 3.85)):.2f} K", 0.72, 110.0),
                ("Still", f"{float(stages_vis.get('still_K', 0.82))*1000:.0f} mK", 0.60, 164.0),
                ("Cold Plate", f"{float(stages_vis.get('cold_plate_K', 0.095))*1000:.0f} mK", 0.48, 218.0),
                ("MXC (QPU)", f"{float(stages_vis.get('mxc_mK', 14.2)):.2f} mK", 0.38, 272.0),
            ]
            cr.set_source_rgba(0.75, 0.62, 0.25, 0.55)
            cr.set_line_width(2.0)
            for off in (-0.25, 0.0, 0.25):
                cr.move_to(mid_x + cw * off * 0.6, 56.0)
                cr.line_to(mid_x + cw * off * 0.6, 272.0)
                cr.stroke()

            for name, temp_s, width_frac, py in plates:
                pw = cw * width_frac
                cr.set_source_rgb(0.92, 0.72, 0.18)
                cr.rectangle(mid_x - pw / 2.0, py - 5.0, pw, 9.0)
                cr.fill()
                cr.set_source_rgb(0.90, 0.95, 1.0)
                cr.set_font_size(8.8)
                cr.move_to(mid_x - pw / 2.0, py - 8.0)
                cr.show_text(f"{name}: {temp_s}")

            mxc_hot = float(stages_vis.get("mxc_mK", 14.2)) >= 50.0
            cr.set_source_rgb(1.0, 0.20, 0.40) if mxc_hot else cr.set_source_rgb(0.0, 0.90, 1.0)
            cr.rectangle(mid_x - 28.0, 281.0, 56.0, 38.0)
            cr.stroke()
            cr.set_font_size(8.5)
            cr.move_to(mid_x - 23.0, 303.0)
            cr.show_text("127Q QPU")
            return False

        def _draw_manifold_pid(self, widget, cr):
            alloc = widget.get_allocation()
            w, h = float(alloc.width), float(alloc.height)
            cr.set_source_rgb(0.05, 0.04, 0.11)
            cr.rectangle(0, 0, w, h)
            cr.fill()

            cr.set_source_rgb(0.0, 0.90, 1.0)
            cr.select_font_face("DejaVu Sans Mono", 0, 1)
            cr.set_font_size(10.5)
            cr.move_to(14, 20)
            cr.show_text("3He/4He GAS-HANDLING MANIFOLD & INTERACTIVE MODBUS/TCP VALVE MATRIX (CLICK V1..V12 TO TOGGLE)")

            bf = self.last_snap.get("bluefors", {})
            plc = self.last_snap.get("plc", {})

            gauges = [
                ("P1 Tank", f"{float(bf.get('P1_mbar', 940.0)):.1f} mbar"),
                ("P2 Condense", f"{float(bf.get('P2_mbar', 185.0)):.1f} mbar"),
                ("P3 Still", f"{float(bf.get('P3_mbar', 0.42)):.3f} mbar"),
                ("P4 Turbo Back", f"{float(bf.get('P4_mbar', 0.08)):.3f} mbar"),
                ("P5 OVC Vac", f"{float(bf.get('P5_mbar', 1.2e-6)):.2e} mbar"),
                ("Turbo1 Pump", f"{float(bf.get('turbo1_hz', 820.0)):.0f} Hz"),
                ("3He Flow", f"{float(bf.get('flow_mmol_s', 0.68)):.2f} mmol/s"),
            ]
            gw = (w - 28.0) / len(gauges)
            for idx, (gtitle, gval) in enumerate(gauges):
                gx = 14.0 + idx * gw
                gy = 34.0
                cr.set_source_rgba(0.12, 0.10, 0.24, 0.95)
                cr.rectangle(gx + 2, gy, gw - 6, 52)
                cr.fill_preserve()
                cr.set_source_rgba(0.54, 0.31, 1.0, 0.5)
                cr.set_line_width(1.0)
                cr.stroke()

                cr.set_source_rgb(0.65, 0.74, 0.88)
                cr.set_font_size(8.5)
                cr.move_to(gx + 8, gy + 18)
                cr.show_text(gtitle)

                cr.set_source_rgb(0.0, 1.0, 0.62)
                cr.set_font_size(9.5)
                cr.move_to(gx + 8, gy + 38)
                cr.show_text(gval)

            valves = plc.get("valves", [True, True, True, True, False, True, True, False, True, False, False, True])
            vnames = [
                "V1 Condense", "V2 Main Imp", "V3 Still Line", "V4 Turbo Fore",
                "V5 Dump Out", "V6 Dump In", "V7 Aux Imp", "V8 Bypass",
                "V9 Compressor", "V10 Sorption", "V11 Vent Guard", "V12 Cold Trap",
            ]
            self.valve_hitboxes.clear()
            cols = 4
            vw = (w - 36.0) / cols
            vh = 58.0
            for idx in range(12):
                r = idx // cols
                c = idx % cols
                vx = 18.0 + c * vw
                vy = 104.0 + r * (vh + 10.0)
                is_open = bool(valves[idx]) if idx < len(valves) else False

                self.valve_hitboxes.append((idx, vx, vy, vw - 8.0, vh))

                cr.set_source_rgba(0.0, 0.90, 1.0, 0.30 if is_open else 0.10)
                cr.set_line_width(2.0)
                cr.move_to(vx - 4, vy + vh * 0.5)
                cr.line_to(vx + vw - 4, vy + vh * 0.5)
                cr.stroke()

                cr.set_source_rgba(0.08, 0.24, 0.20, 0.92) if is_open else cr.set_source_rgba(0.22, 0.09, 0.16, 0.92)
                cr.rectangle(vx, vy, vw - 8.0, vh)
                cr.fill_preserve()
                cr.set_source_rgb(0.0, 1.0, 0.62) if is_open else cr.set_source_rgb(1.0, 0.20, 0.40)
                cr.set_line_width(1.3)
                cr.stroke()

                cr.set_source_rgb(0.92, 0.96, 1.0)
                cr.set_font_size(9.5)
                cr.move_to(vx + 8, vy + 22)
                cr.show_text(vnames[idx])

                cr.set_source_rgb(0.0, 1.0, 0.62) if is_open else cr.set_source_rgb(1.0, 0.35, 0.50)
                cr.set_font_size(9.0)
                cr.move_to(vx + 8, vy + 42)
                cr.show_text(f"MODBUS COIL[{idx+3}]: {'OPEN' if is_open else 'CLOSED'}")

            return False

    win = CryoLabWindow()
    win.show_all()
    Gtk.main()

def run_self_test() -> int:
    assert b"background-color: #0D0B18" in DARK_CSS
    try:
        from omniq.lab.rack_manager import LabRackManager
    except Exception:
        pass
    print("[PASS] omniq-cryo-lab GUI & SCPI/Modbus console module verified.")
    return 0

def main():
    if "--test" in sys.argv:
        sys.exit(run_self_test())
    launch_gui()

if __name__ == "__main__":
    main()
