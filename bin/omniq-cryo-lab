REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
for p in [
    os.path.join(REPO_ROOT, "runtime", "python"),
    os.path.join(REPO_ROOT, "src"),
    "/opt/omniq/src",
    "/usr/lib/python3/dist-packages",
]:
    if os.path.isdir(p) and p not in sys.path:
        sys.path.insert(0, p)

